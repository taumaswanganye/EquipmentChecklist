@model List<EquipmentChecklist.Models.UserCredential>
@{
    ViewData["Title"] = "Biometric Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:780px">
    <h2 style="font-size:22px;font-weight:700;color:var(--text-main);margin:0 0 4px">
        Biometric / Passwordless Login
    </h2>
    <p style="font-size:12px;color:var(--text-muted);margin:0 0 20px">
        Register this device's fingerprint, Face ID or Windows Hello to sign in without a password.
        After enrolling, you can also use the device biometrics to unlock the app while offline.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="margin-bottom:14px">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning" style="margin-bottom:14px">⚠ @TempData["Error"]</div>
    }

    @* Anti-forgery token used by webauthn.js for the POST endpoints *@
    @Html.AntiForgeryToken()

    <!-- ── Enroll new device ────────────────────────────────────────────── -->
    <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;padding:20px;margin-bottom:20px">
        <h3 style="font-size:15px;margin:0 0 12px">Register this device</h3>
        <p style="font-size:13px;color:var(--text-muted);line-height:1.6;margin:0 0 14px">
            Give the device a name so you can identify it later, then click
            <strong>Register</strong>. Your browser will ask for your fingerprint /
            Face ID / Windows Hello.
        </p>

        <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end;margin-bottom:8px">
            <div class="form-group" style="margin:0">
                <label class="form-label">Device name</label>
                <input id="deviceLabel" type="text" class="form-control" maxlength="80"
                       placeholder="e.g. John's iPhone" />
            </div>
            <button type="button" id="btnRegister" class="btn btn-primary">
                🔐 Register this device
            </button>
        </div>
        <p id="registerStatus" style="font-size:12px;margin:6px 0 0;color:var(--text-muted);min-height:18px"></p>

        <p id="unsupportedNote" style="display:none;margin:10px 0 0;font-size:12px;color:var(--amber)">
            ⚠ This browser doesn't support WebAuthn. Use a recent version of Chrome, Edge, Safari or Firefox.
        </p>
    </div>

    <!-- ── Registered devices ──────────────────────────────────────────── -->
    <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;padding:20px;margin-bottom:20px">
        <h3 style="font-size:15px;margin:0 0 12px">Your registered devices</h3>
        @if (!Model.Any())
        {
            <p style="font-size:13px;color:var(--text-muted);margin:0">
                No devices registered yet.
            </p>
        }
        else
        {
            <table class="data-table" style="margin:0">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Registered</th>
                        <th>Last used</th>
                        <th>PIN</th>
                        <th>Status</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@(c.DeviceLabel ?? "Unnamed device")</strong></td>
                            <td style="font-size:12px;color:var(--text-muted)">@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td style="font-size:12px;color:var(--text-muted)">
                                @(c.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(c.PinHash))
                                {
                                    <span class="badge badge-pending">Not set</span>
                                }
                                else
                                {
                                    <span class="badge badge-go">✓ Set</span>
                                }
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge badge-go">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-pending">Revoked</span>
                                }
                            </td>
                            <td style="text-align:right;white-space:nowrap">
                                @if (c.IsActive)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm"
                                            onclick="openPinModal(@c.Id, '@(c.DeviceLabel?.Replace("'", "&#39;") ?? "Unnamed device")')">
                                        🔢 Set PIN
                                    </button>
                                    <form method="post" action="/Security/RevokeCredential" style="display:inline"
                                          onsubmit="return confirm('Revoke this device? You\'ll have to register again to use biometric login on it.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm"
                                                style="background:#7f1d1d;border:1px solid #b91c1c;color:#fee2e2;font-size:11px">
                                            ✕ Revoke
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- ── Tips ────────────────────────────────────────────────────────── -->
    <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;padding:16px 20px">
        <h3 style="font-size:14px;margin:0 0 8px">How it works offline</h3>
        <p style="font-size:12px;color:var(--text-muted);line-height:1.7;margin:0">
            When you sign in online with biometrics, the server gives your device a
            <strong>24-hour offline voucher</strong>. You can launch the app and sign in
            with your fingerprint or PIN even without signal, up until that voucher expires.
            Reconnect to refresh — sync at least once per shift to stay covered.
        </p>
    </div>
</div>

<!-- PIN modal -->
<div id="pinModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;align-items:center;justify-content:center;padding:20px">
    <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;max-width:420px;width:100%;padding:22px">
        <h3 style="margin:0 0 6px;font-size:16px">Set offline PIN</h3>
        <p id="pinModalDevice" style="font-size:12px;color:var(--text-muted);margin:0 0 14px"></p>

        <input type="hidden" id="pinCredId" />
        <div class="form-group">
            <label class="form-label">4–6 digit PIN</label>
            <input id="pinValue" type="password" inputmode="numeric" pattern="\d{4,6}"
                   maxlength="6" class="form-control" autocomplete="off" />
        </div>
        <div class="form-group">
            <label class="form-label">Confirm PIN</label>
            <input id="pinConfirm" type="password" inputmode="numeric" pattern="\d{4,6}"
                   maxlength="6" class="form-control" autocomplete="off" />
        </div>
        <p id="pinStatus" style="font-size:12px;color:var(--text-muted);margin:0 0 14px;min-height:18px"></p>
        <div style="display:flex;justify-content:flex-end;gap:8px">
            <button type="button" class="btn btn-ghost" onclick="closePinModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="savePin()">Save PIN</button>
        </div>
    </div>
</div>

<script src="~/js/webauthn.js"></script>
<script>
(function () {
    var btn       = document.getElementById('btnRegister');
    var statusEl  = document.getElementById('registerStatus');
    var labelEl   = document.getElementById('deviceLabel');
    var unsupNote = document.getElementById('unsupportedNote');

    if (!window.WebAuthnClient.isSupported) {
        btn.disabled = true;
        btn.style.opacity = '.55';
        btn.style.cursor  = 'not-allowed';
        unsupNote.style.display = 'block';
        return;
    }

    btn.addEventListener('click', function () {
        btn.disabled = true;
        WebAuthnClient.register({ deviceLabel: labelEl.value, statusEl: statusEl })
            .then(function () {
                setTimeout(function () { location.reload(); }, 600);
            })
            .catch(function () { btn.disabled = false; });
    });
})();

// ── PIN modal ────────────────────────────────────────────────────────────
function openPinModal(credId, label) {
    document.getElementById('pinCredId').value      = credId;
    document.getElementById('pinValue').value       = '';
    document.getElementById('pinConfirm').value     = '';
    document.getElementById('pinStatus').textContent = '';
    document.getElementById('pinModalDevice').textContent = label;
    document.getElementById('pinModal').style.display = 'flex';
}
function closePinModal() { document.getElementById('pinModal').style.display = 'none'; }
function savePin() {
    var v   = document.getElementById('pinValue').value;
    var c   = document.getElementById('pinConfirm').value;
    var id  = parseInt(document.getElementById('pinCredId').value, 10);
    var st  = document.getElementById('pinStatus');
    if (!/^\d{4,6}$/.test(v)) { st.textContent = '✕ PIN must be 4–6 digits.'; st.style.color = 'var(--red-nogo)'; return; }
    if (v !== c)              { st.textContent = '✕ PINs do not match.';      st.style.color = 'var(--red-nogo)'; return; }
    st.textContent  = 'Saving…';
    st.style.color  = 'var(--text-muted)';
    WebAuthnClient.setPin(id, v)
        .then(function () {
            st.textContent = '✓ PIN saved.';
            st.style.color = 'var(--green-go)';
            setTimeout(function () { closePinModal(); location.reload(); }, 600);
        })
        .catch(function (err) {
            st.textContent = '✕ ' + (err.message || err);
            st.style.color = 'var(--red-nogo)';
        });
}
</script>
