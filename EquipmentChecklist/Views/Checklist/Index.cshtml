@model List<EquipmentChecklist.Models.MachineAssignment>
@using EquipmentChecklist.Models
@{
    ViewData["Title"] = "My Machines";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = ViewBag.Stats as EquipmentChecklist.DTOs.DashboardStatsDto;

    // Competency block popup state — populated when ChecklistController
    // refused to open the form because the operator isn't competent for
    // that machine's type. Rendered as a JS-triggered modal at the bottom.
    var compBlocked       = TempData["CompetencyBlocked"] as string == "1";
    var compMachineType   = TempData["CompetencyBlockedMachineType"] as string ?? "";
    var compMachineNum    = TempData["CompetencyBlockedMachineNum"]  as string ?? "";
    var compMachineName   = TempData["CompetencyBlockedMachineName"] as string ?? "";
    var compLastExpiry    = TempData["CompetencyBlockedLastExpiry"]  as string ?? "";
}

@* ── Competency-block modal ────────────────────────────────────────────
   Auto-shown on page load when the controller redirected here with the
   CompetencyBlocked flag set. Same visual language as the mobile modal:
   red top border, machine details, "OK" button to dismiss. *@
@if (compBlocked)
{
    <div id="compBlockBackdrop" class="comp-block-backdrop">
        <div class="comp-block-card">
            <div class="comp-block-icon">🛑</div>
            <h2 class="comp-block-title">Not authorised</h2>
            <p class="comp-block-body">
                You're not currently competent on <strong>@compMachineType</strong>.
            </p>
            <div class="comp-block-detail">
                <div class="comp-block-row">
                    <span class="comp-block-k">Machine</span>
                    <span class="comp-block-v">@compMachineNum · @compMachineName</span>
                </div>
                @if (!string.IsNullOrEmpty(compLastExpiry))
                {
                    <div class="comp-block-row">
                        <span class="comp-block-k">Last certificate</span>
                        <span class="comp-block-v">expired @compLastExpiry</span>
                    </div>
                }
                else
                {
                    <div class="comp-block-row">
                        <span class="comp-block-k">Certificate</span>
                        <span class="comp-block-v">— none on file —</span>
                    </div>
                }
            </div>
            <p class="comp-block-foot">
                Contact your administrator to register a current licence.
                Every block is logged in the audit trail.
            </p>
            <button type="button" class="comp-block-btn"
                    onclick="document.getElementById('compBlockBackdrop').remove()">OK</button>
        </div>
    </div>

    <style>
        .comp-block-backdrop {
            position: fixed; inset: 0; z-index: 1050;
            background: rgba(2, 6, 23, .82);
            display: flex; align-items: center; justify-content: center;
            padding: 18px;
        }
        .comp-block-card {
            background: #0d1729; color: #e5e7eb;
            border: 1px solid #7f1d1d;
            border-top: 4px solid #ef4444;
            border-radius: 14px;
            max-width: 460px; width: 100%;
            padding: 26px 22px 22px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .55);
            font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
        }
        .comp-block-icon  { font-size: 44px; margin-bottom: 4px; }
        .comp-block-title { font-size: 19px; font-weight: 800; color: #fecaca; margin: 4px 0 10px; letter-spacing: .3px; }
        .comp-block-body  { font-size: 14px; color: #e5e7eb; line-height: 1.6; margin: 0 0 16px; }
        .comp-block-detail { text-align: left; background: #111c2e; border: 1px solid #1f2a3a; border-radius: 8px; padding: 10px 12px; margin-bottom: 14px; }
        .comp-block-row    { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; font-size: 12px; }
        .comp-block-row + .comp-block-row { border-top: 1px solid #1a2638; }
        .comp-block-k { color: #94a3b8; }
        .comp-block-v { color: #fcd34d; font-weight: 600; font-family: ui-monospace, monospace; }
        .comp-block-foot { font-size: 11px; color: #94a3b8; line-height: 1.55; margin: 0 0 16px; }
        .comp-block-btn  {
            background: #ef4444; color: #0a1726;
            border: none; border-radius: 8px;
            padding: 11px 28px; font-size: 14px; font-weight: 700;
            cursor: pointer; min-width: 140px;
        }
        .comp-block-btn:hover { background: #f87171; }
    </style>
}

@if (stats != null)
{
    <div class="stat-grid">
        <div class="stat-card info">
            <div class="stat-label">Fleet Machines</div>
            <div class="stat-value" id="stat-total">@stats.TotalMachines</div>
        </div>
        <div class="stat-card go">
            <div class="stat-label">Operational</div>
            <div class="stat-value" id="stat-go">@stats.GoMachines</div>
        </div>
        <div class="stat-card nogo">
            <div class="stat-label">Immobilised</div>
            <div class="stat-value" id="stat-nogo">@stats.ImmobilisedMachines</div>
        </div>
        <div class="stat-card gobut">
            <div class="stat-label">Pending Defects</div>
            <div class="stat-value" id="stat-defects">@stats.PendingDefects</div>
        </div>
        <div class="stat-card info">
            <div class="stat-label">Today's Submissions</div>
            <div class="stat-value" id="stat-today">@stats.TodaySubmissions</div>
        </div>
    </div>
}

<h2 style="margin-bottom:16px;font-size:20px">My Assigned Machines</h2>

@if (!Model.Any())
{
    <div style="text-align:center;padding:60px;color:var(--text-muted)">
        <div style="font-size:56px;margin-bottom:12px">🚜</div>
        <p>No machines assigned to you yet.<br/>Contact your supervisor or admin.</p>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px">
        @foreach (var a in Model)
        {
            <div style="background:var(--steel-mid);border:1px solid @(a.Machine.IsImmobilised ? "var(--red-nogo)" : "var(--steel-border)");border-radius:10px;padding:20px;position:relative;overflow:hidden">
                @if (a.Machine.IsImmobilised)
                {
                    <div style="position:absolute;top:0;left:0;right:0;background:var(--red-dark);text-align:center;padding:4px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em">
                        🚫 IMMOBILISED
                    </div>
                    <div style="margin-top:24px"></div>
                }

                <h3 style="font-size:20px;margin-bottom:4px">@a.Machine.MachineNumber</h3>
                <p style="color:var(--text-muted);font-size:13px;margin-bottom:4px">@a.Machine.MachineName</p>
                <p style="color:var(--text-muted);font-size:12px;margin-bottom:16px">@a.Machine.TypeDisplay()</p>

                @if (a.Machine.IsImmobilised)
                {
                    <p style="font-size:12px;color:var(--red-nogo);margin-bottom:14px">@a.Machine.ImmobilisedReason</p>
                    <button disabled class="btn btn-danger" style="width:100%;opacity:.5;cursor:not-allowed">
                        Machine Immobilised
                    </button>
                }
                else
                {
                    <a href="/Checklist/Start/@a.MachineId" class="btn btn-success" style="width:100%;justify-content:center">
                        ▶ Start Pre-Use Check
                    </a>
                }
            </div>
        }
    </div>
}

@if (stats?.RecentSubmissions?.Any() == true)
{
    <h2 style="margin-top:32px;margin-bottom:16px;font-size:20px">Recent Submissions</h2>
    <table class="data-table">
        <thead>
            <tr>
                <th>Machine</th>
                <th>Operator</th>
                <th>Status</th>
                <th>Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in stats.RecentSubmissions)
            {
                var badgeClass = r.Status switch {
                    ChecklistStatus.Go                => "badge-go",
                    ChecklistStatus.GoButRepair24H    => "badge-gobut",
                    ChecklistStatus.GoTillNextService => "badge-gobut",
                    ChecklistStatus.NoGo              => "badge-nogo",
                    _                                 => "badge-pending"
                };
                var badgeLabel = r.Status switch {
                    ChecklistStatus.Go                => "GO",
                    ChecklistStatus.GoButRepair24H    => "GO-BUT 24H",
                    ChecklistStatus.GoTillNextService => "GO-BUT 30D",
                    ChecklistStatus.NoGo              => "NO-GO",
                    _                                 => "Pending"
                };
                <tr>
                    <td><strong>@r.MachineNumber</strong> @r.MachineName</td>
                    <td>@r.OperatorName</td>
                    <td><span class="badge @badgeClass">@badgeLabel</span></td>
                    <td style="color:var(--text-muted);font-size:13px">@r.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
