@model List<EquipmentChecklist.Models.DefectOrder>
@using EquipmentChecklist.Models
@{
    ViewData["Title"] = "Planner — Defect Capture Queue";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = ViewBag.Stats;
    // Phase 4.B — supervisor-approved submissions awaiting the
    // Planner's shift-log capture. Surfaced as a separate table so
    // the Planner can clear defects (which need jobcards) and clean
    // logs (which need acknowledgment) without losing context.
    var approvedToCapture =
        (List<ChecklistSubmission>)(ViewBag.ApprovedAwaitingCapture ?? new List<ChecklistSubmission>());
}

<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;flex-wrap:wrap;gap:12px">
    <div>
        <h2 class="page-title">📋 Defect Capture Queue</h2>
        <p class="page-subtitle">
            Supervisor-approved defects awaiting capture into the jobcard system.
            Capture each one to push it to the Control Room for Artisan dispatch.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom:14px">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-bottom:14px;white-space:pre-wrap">@TempData["Error"]</div>
}

<div class="stat-grid" style="margin-bottom:24px">
    <div class="stat-card info">
        <div class="stat-label">Pending capture</div>
        <div class="stat-value">@stats.Pending</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">defects awaiting jobcard</div>
    </div>
    <div class="stat-card @(stats.Stale24h > 0 ? "nogo" : "")">
        <div class="stat-label">Aged &gt; 24h</div>
        <div class="stat-value">@stats.Stale24h</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">need attention</div>
    </div>
    <div class="stat-card go">
        <div class="stat-label">Captured today</div>
        <div class="stat-value">@stats.CapturedToday</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">your throughput</div>
    </div>
</div>

@if (!Model.Any())
{
    <div style="text-align:center;padding:60px;color:var(--text-muted)">
        <div style="font-size:48px;margin-bottom:12px">✅</div>
        <p>Queue is clear. No defects waiting for capture.</p>
    </div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Raised</th>
                <th>Machine</th>
                <th>Operator</th>
                <th>Defect</th>
                <th>Critical?</th>
                <th>Jobcard #</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                var ageHours = (DateTime.UtcNow - d.CreatedAt).TotalHours;
                // Phase 6.11 — three aging tiers so the eye can pick the
                // right item without reading the numeric age. Red left
                // border + red-tinted background for stale (>24h), amber
                // for ageing (>8h), unstyled for fresh.
                var isStale  = ageHours > 24;
                var isAgeing = ageHours > 8 && !isStale;
                var rowStyle = isStale  ? "background:rgba(239,68,68,.08);border-left:4px solid #ef4444"
                             : isAgeing ? "background:rgba(245,158,11,.06);border-left:4px solid #f59e0b"
                             : "";
                var isCritical = d.SubmissionItem?.TemplateItem?.IsNoGoItem ?? false;
                <tr style="@rowStyle">
                    <td style="font-size:12px;color:var(--text-muted);white-space:nowrap">
                        @d.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                        <div style="font-size:10px">@($"{ageHours:0.0}h ago")</div>
                        @if (isStale)
                        {
                            <span style="display:inline-block;margin-top:3px;padding:1px 6px;border-radius:8px;font-size:9px;font-weight:700;background:#ef4444;color:#fff;letter-spacing:.5px">STALE</span>
                        }
                        else if (isAgeing)
                        {
                            <span style="display:inline-block;margin-top:3px;padding:1px 6px;border-radius:8px;font-size:9px;font-weight:700;background:#f59e0b;color:#fff;letter-spacing:.5px">AGEING</span>
                        }
                    </td>
                    <td>
                        <strong>@d.Submission.Machine.MachineNumber</strong>
                        <div style="font-size:11px;color:var(--text-muted)">@d.Submission.Machine.MachineName</div>
                    </td>
                    <td style="font-size:13px">@d.Submission.Operator?.FullName</td>
                    <td style="font-size:13px;max-width:340px">
                        @d.DefectDescription
                    </td>
                    <td style="text-align:center">
                        @if (isCritical)
                        {
                            <span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;background:#ef4444;color:#fff">NO-GO</span>
                        }
                        else
                        {
                            <span style="font-size:11px;color:var(--text-muted)">—</span>
                        }
                    </td>
                    <td>
                        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                            <form method="post" action="/Planner/Capture" style="margin:0;display:flex;gap:6px;align-items:center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.Id" />
                                <input type="text" name="jobCardNumber" placeholder="e.g. WO-7741"
                                       class="form-control" autocomplete="off"
                                       style="font-family:ui-monospace,monospace;font-size:12px;width:130px;padding:4px 8px" />
                                <button type="submit" class="btn btn-primary btn-sm">Capture</button>
                            </form>
                            <button type="button" class="btn btn-ghost btn-sm"
                                    style="font-size:11px"
                                    onclick="document.getElementById('reject-@d.Id').style.display='flex'">
                                Reject
                            </button>
                        </div>
                        @* Inline reject form, hidden until the Reject button is tapped.
                           Real planners use this when a defect is a duplicate jobcard,
                           when the operator flagged something that isn't actually a
                           defect, or when supervisor clarification is needed. *@
                        <form id="reject-@d.Id" method="post" action="/Planner/Reject"
                              style="display:none;margin-top:6px;gap:6px;align-items:center"
                              onsubmit="return confirm('Reject this defect? It will be closed with the reason as resolution notes.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@d.Id" />
                            <input type="text" name="reason" required maxlength="300"
                                   placeholder="Why are you rejecting? (e.g. duplicate of WO-7720)"
                                   class="form-control" autocomplete="off"
                                   style="font-size:12px;flex:1;padding:4px 8px" />
                            <button type="submit" class="btn btn-ghost btn-sm" style="color:#ef4444">Confirm reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p style="font-size:11px;color:var(--text-muted);margin-top:12px;line-height:1.6">
        Leave the Jobcard # blank to capture without a SAP reference (useful while SAP is being set up — the row still moves to the Control Room queue).
        Once SAP integration is live, the jobcard number can also flow back from the outbox automatically.
    </p>
}

@* ── Phase 4.B — Approved-submissions capture section ──────────────────
   Supervisor has signed off these submissions (clean GO or GO-BUT 24H).
   They need to be logged into the Planner's shift system for production
   reporting; the act of clicking Capture records the acknowledgment and
   stamps CapturedAt on the submission. No jobcard is created — those
   are only for defects. Closes the "no-defect route" gap from the
   original process flow. ──────────────────────────────────────────── *@
<div style="display:flex;justify-content:space-between;align-items:flex-end;margin:32px 0 8px;flex-wrap:wrap;gap:8px">
    <h3 style="font-size:15px;margin:0">
        📒 Approved submissions awaiting shift-log capture
        @if (stats.ApprovedToCapture > 0)
        {
            <span style="font-weight:400;color:var(--text-muted);font-size:12px">
                · @stats.ApprovedToCapture pending · @stats.ApprovedCapturedToday captured today
            </span>
        }
    </h3>
    @* Phase 6.2 — end-of-shift "clear the deck" button. Only renders
       when there's something to clear, so the button never lies. The
       confirm dialog quotes the visible count so the Planner can't
       accidentally bulk-capture a queue they thought was empty. *@
    @if (approvedToCapture.Any())
    {
        <form method="post" action="/Planner/CaptureAllSubmissions" style="margin:0"
              onsubmit="return confirm('Capture all @approvedToCapture.Count approved submission(s) into the shift log?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm">
                Capture all @approvedToCapture.Count
            </button>
        </form>
    }
</div>
<p style="font-size:12px;color:var(--text-muted);margin:0 0 12px;line-height:1.6">
    Supervisor-approved checklists (clean GO or signed-off GO-BUT) from the last 48 hours. Click Capture once you've logged each one into the shift system — no jobcard is required. Use "Capture all" at end of shift to clear the queue in one go.
</p>

@if (!approvedToCapture.Any())
{
    <div style="text-align:center;padding:30px;color:var(--text-muted);background:rgba(34,197,94,.04);border:1px dashed #16a34a40;border-radius:8px">
        <div style="font-size:32px;margin-bottom:6px">✅</div>
        <p style="margin:0">All approved submissions in the last 48 hours have been captured.</p>
    </div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Submitted</th>
                <th>Machine</th>
                <th>Operator</th>
                <th>Status</th>
                <th>Supervisor signed</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in approvedToCapture)
            {
                var (bg, label) = s.Status switch {
                    ChecklistStatus.Go                  => ("#16a34a", "GO"),
                    ChecklistStatus.GoButRepair24H      => ("#06b6d4", "GO-BUT 24H"),
                    ChecklistStatus.GoTillNextService   => ("#06b6d4", "GO-BUT 30D"),
                    _                                   => ("#64748b", s.Status.ToString())
                };
                <tr>
                    <td style="font-size:12px;color:var(--text-muted);white-space:nowrap">
                        @s.SubmittedAt.ToLocalTime().ToString("MM-dd HH:mm")
                    </td>
                    <td>
                        <strong>@s.Machine.MachineNumber</strong>
                        <div style="font-size:11px;color:var(--text-muted)">@s.Machine.MachineName</div>
                    </td>
                    <td style="font-size:13px">@(s.Operator?.FullName ?? "—")</td>
                    <td>
                        <span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;background:@bg;color:#fff">@label</span>
                    </td>
                    <td style="font-size:11px;color:var(--text-muted)">
                        @(s.SupervisorSignedAt?.ToLocalTime().ToString("MM-dd HH:mm") ?? "n/a (clean GO)")
                    </td>
                    <td style="text-align:right">
                        <form method="post" action="/Planner/CaptureSubmission" style="margin:0;display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm">Capture</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* ──────── Phase 6.6 — Live queue-depth polling ────────
   Polls /Planner/QueueDepth every 30s. When any depth number changes,
   surfaces a fixed-position banner inviting the user to refresh. The
   banner is non-modal — they can ignore it and finish their current
   action, then refresh when they're ready. Auto-refresh after 5 minutes
   of ignored signal so a long-idle browser doesn't drift too far. *@
<div id="qd-banner" style="display:none;position:fixed;bottom:18px;right:18px;z-index:1000;background:#0f172a;color:#fff;border-radius:10px;box-shadow:0 6px 24px rgba(0,0,0,.18);padding:12px 16px;font-size:13px;max-width:320px">
    <div style="display:flex;align-items:center;gap:10px">
        <div style="font-size:18px">🔔</div>
        <div style="flex:1">
            <div style="font-weight:600">Queue updated</div>
            <div id="qd-msg" style="font-size:11px;color:#cbd5e1;margin-top:2px">New items waiting</div>
        </div>
        <button type="button" onclick="location.reload()"
                style="background:#06b6d4;color:#fff;border:none;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer">
            Refresh
        </button>
        <button type="button" onclick="document.getElementById('qd-banner').style.display='none'"
                style="background:transparent;color:#94a3b8;border:none;font-size:18px;cursor:pointer;padding:0 4px"
                aria-label="Dismiss">×</button>
    </div>
</div>

<script>
    (function () {
        // Snapshot the values the page was rendered with — we compare
        // every poll to these so a transient blip doesn't keep firing.
        var baseline = {
            pending:                 @((int)stats.Pending),
            stale24h:                @((int)stats.Stale24h),
            approvedAwaitingCapture: @((int)stats.ApprovedToCapture)
        };
        var banner = document.getElementById('qd-banner');
        var msg    = document.getElementById('qd-msg');
        var autoRefreshTimer = null;

        function check() {
            fetch('/Planner/QueueDepth', { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    if (!d) return;
                    var delta = (d.pending - baseline.pending) +
                                (d.approvedAwaitingCapture - baseline.approvedAwaitingCapture);
                    if (delta > 0) {
                        msg.textContent = '+' + delta + ' new item(s) since you opened this page.';
                        banner.style.display = 'block';
                        // Auto-refresh after 5 minutes of being ignored so a
                        // left-open browser doesn't drift too far from reality.
                        if (!autoRefreshTimer) {
                            autoRefreshTimer = setTimeout(function () { location.reload(); }, 5 * 60 * 1000);
                        }
                    } else if (d.pending < baseline.pending) {
                        // Items were captured (by another planner). Update
                        // baseline silently so we don't show "queue updated"
                        // for an empty change.
                        baseline.pending = d.pending;
                        baseline.approvedAwaitingCapture = d.approvedAwaitingCapture;
                    }
                })
                .catch(function () { /* offline — try again next tick */ });
        }
        setInterval(check, 30000);
    })();
</script>
