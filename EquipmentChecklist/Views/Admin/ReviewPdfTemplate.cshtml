@using EquipmentChecklist.Models
@{
    ViewData["Title"] = "Review PDF Checklist";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var machine         = ViewBag.Machine as Machine;
    var machineId       = (int)(ViewBag.MachineId ?? 0);
    var replaceExisting = (bool)(ViewBag.ReplaceExisting ?? false);
    var noGoKeywords    = ViewBag.NoGoKeywords as string[] ?? new string[0];
    var lines           = ViewBag.Lines as List<string> ?? new List<string>();

    bool IsLikelyNoGo(string s) =>
        noGoKeywords.Any(k => s.Contains(k, StringComparison.OrdinalIgnoreCase));
}

<div style="max-width:960px">
    <a href="/Admin/UploadTemplate" class="btn btn-ghost" style="margin-bottom:16px">← Back to Upload</a>

    <h2 class="page-title" style="margin-bottom:4px">Review PDF Checklist</h2>
    <p class="page-subtitle" style="margin-bottom:8px">
        Machine:
        <strong style="color:var(--text-primary)">
            @machine?.MachineNumber – @machine?.MachineName
        </strong>
    </p>
    <p style="font-size:13px;color:var(--text-muted);margin-bottom:20px">
        @lines.Count line(s) extracted from the PDF. Tick which lines to keep, edit text if needed,
        and toggle <strong style="color:var(--red-nogo)">NO-GO</strong> on critical items.
        @if (replaceExisting)
        {
            <span style="display:inline-block;margin-left:8px;padding:2px 8px;background:#451a03;border:1px solid #92400e;border-radius:4px;color:#fbbf24;font-size:11px;font-weight:600">
                ⚠ REPLACE MODE
            </span>
        }
    </p>

    <form method="post" action="/Admin/SavePdfTemplate" id="reviewForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="machineId"       value="@machineId" />
        <input type="hidden" name="replaceExisting" value="@replaceExisting.ToString().ToLower()" />

        <!-- Bulk action bar -->
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:12px 14px;background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:8px;margin-bottom:14px">
            <button type="button" class="btn btn-ghost" onclick="toggleAll(true)">✓ Keep All</button>
            <button type="button" class="btn btn-ghost" onclick="toggleAll(false)">✕ Skip All</button>
            <span style="margin-left:auto;font-size:12px;color:var(--text-muted)">
                <span id="keepCount">0</span> of @lines.Count selected
            </span>
        </div>

        <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;overflow:hidden">
            <table class="data-table" style="margin:0">
                <thead>
                    <tr>
                        <th style="width:60px;text-align:center">Keep</th>
                        <th style="width:48px;text-align:center">#</th>
                        <th>Item Text (editable)</th>
                        <th style="width:90px;text-align:center">NO-GO</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < lines.Count; i++)
                    {
                        var line       = lines[i];
                        var preflagged = IsLikelyNoGo(line);
                        <tr class="review-row">
                            <td style="text-align:center">
                                <input type="checkbox"
                                       name="items[@i].Keep"
                                       value="true"
                                       class="keep-cb"
                                       checked
                                       onchange="updateKeepCount()"
                                       style="width:18px;height:18px;cursor:pointer;accent-color:var(--green-go)" />
                                <input type="hidden" name="items[@i].Keep" value="false" />
                            </td>
                            <td style="text-align:center;font-family:var(--font-mono);color:var(--text-muted);font-size:12px">
                                @(i + 1)
                            </td>
                            <td>
                                <input type="text"
                                       name="items[@i].Text"
                                       value="@line"
                                       maxlength="200"
                                       class="form-control"
                                       style="width:100%;padding:6px 10px;font-size:13px" />
                                @if (line.Length > 200)
                                {
                                    <div style="font-size:11px;color:var(--amber);margin-top:3px">
                                        ⚠ Original line was @line.Length chars — will be truncated to 200.
                                    </div>
                                }
                            </td>
                            <td style="text-align:center">
                                <input type="checkbox"
                                       name="items[@i].NoGo"
                                       value="true"
                                       @(preflagged ? "checked" : "")
                                       style="width:18px;height:18px;cursor:pointer;accent-color:var(--red-nogo)" />
                                <input type="hidden" name="items[@i].NoGo" value="false" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="display:flex;gap:12px;margin-top:20px">
            <button type="submit" class="btn btn-primary">💾 Save Template</button>
            <a href="/Admin/UploadTemplate" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>

<script>
function toggleAll(checked) {
    document.querySelectorAll('.keep-cb').forEach(cb => cb.checked = checked);
    updateKeepCount();
}

function updateKeepCount() {
    var n = document.querySelectorAll('.keep-cb:checked').length;
    document.getElementById('keepCount').textContent = n;
}

document.addEventListener('DOMContentLoaded', updateKeepCount);
</script>
