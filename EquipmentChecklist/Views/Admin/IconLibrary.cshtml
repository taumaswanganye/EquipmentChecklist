@model List<EquipmentChecklist.Models.IconLibraryItem>
@{
    ViewData["Title"] = "Icon Library";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string Human(long bytes) =>
        bytes < 1024 ? $"{bytes} B" :
        bytes < 1024 * 1024 ? $"{bytes / 1024.0:F1} KB" :
        $"{bytes / 1048576.0:F1} MB";
}

<div style="margin-bottom:20px;display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap">
    <div>
        <h2 style="font-size:22px;font-weight:700;color:var(--text-main);margin:0">Icon Library</h2>
        <p style="font-size:12px;color:var(--text-muted);margin:2px 0 0">
            Reusable icons available across all checklist item forms. PNG, JPG, GIF, WEBP, SVG.
        </p>
    </div>
    <div style="font-size:12px;color:var(--text-muted)">
        @Model.Count icon(s) in library
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom:14px">✓ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning" style="margin-bottom:14px">⚠ @TempData["Error"]</div>
}

<!-- Upload card -->
<div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;padding:20px;margin-bottom:24px">
    <h3 style="font-size:15px;margin:0 0 12px">Upload a new icon</h3>
    <form method="post" action="/Admin/UploadIcon" enctype="multipart/form-data"
          style="display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end">
        @Html.AntiForgeryToken()

        <div class="form-group" style="margin:0">
            <label class="form-label">Display name (optional)</label>
            <input type="text" name="displayName" class="form-control" maxlength="120"
                   placeholder="Defaults to the file name" />
        </div>

        <div class="form-group" style="margin:0">
            <label class="form-label">Image file</label>
            <input type="file" name="file" class="form-control"
                   accept=".png,.jpg,.jpeg,.gif,.webp,.svg" required
                   style="padding:7px 12px;cursor:pointer" />
        </div>

        <button type="submit" class="btn btn-primary">📤 Upload</button>
    </form>
</div>

<!-- Library grid -->
@if (!Model.Any())
{
    <div style="text-align:center;padding:60px;color:var(--text-muted)">
        <div style="font-size:48px;margin-bottom:12px">🖼️</div>
        <p>No icons in the library yet. Upload one above to get started.</p>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px">
        @foreach (var icon in Model)
        {
            <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:10px;padding:12px;display:flex;flex-direction:column;align-items:center;text-align:center">
                <div style="width:100%;height:120px;background:#fff;border-radius:6px;display:flex;align-items:center;justify-content:center;padding:8px;margin-bottom:10px">
                    <img src="@icon.FilePath" alt="@icon.Name"
                         style="max-width:100%;max-height:100%;object-fit:contain" />
                </div>
                <div style="font-size:13px;font-weight:600;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                     title="@icon.Name">
                    @icon.Name
                </div>
                <div style="font-size:10px;color:var(--text-muted);margin-top:2px">
                    @Human(icon.FileSize) · @icon.UploadedAt.ToString("yyyy-MM-dd")
                </div>
                <div style="display:flex;gap:6px;margin-top:10px;width:100%">
                    <button type="button" class="btn btn-ghost btn-sm" style="flex:1;font-size:11px"
                            onclick="navigator.clipboard.writeText('@icon.FilePath');this.textContent='✓ Copied';setTimeout(()=>this.textContent='Copy path',1200)">
                        Copy path
                    </button>
                    <form method="post" action="/Admin/DeleteIcon" style="flex:0"
                          onsubmit="return confirm('Delete this icon? Any checklist items using it will lose their icon.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@icon.Id" />
                        <button type="submit" class="btn btn-sm"
                                style="background:#7f1d1d;border:1px solid #b91c1c;color:#fee2e2;font-size:11px">
                            🗑
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
