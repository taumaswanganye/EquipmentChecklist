@model List<EquipmentChecklist.Models.ChecklistSubmission>
@using EquipmentChecklist.Models
@using EquipmentChecklist.Services
@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var filter          = (ListFilter)(ViewBag.Filter ?? new ListFilter());
    var dashboard       = (ReportsDashboard)ViewBag.Dashboard;
    var k               = dashboard.Kpis;
    var totalUnfiltered = (int)(ViewBag.TotalUnfiltered ?? Model.Count);

    // Round-trip the active filter to the export buttons so a manager
    // exporting the screen-current scope gets exactly that.
    // Export endpoints accept from/to only. The search term doesn't pass
    // through to the exporter because the workbook generator pulls fresh
    // rows from the DB and ignores the in-memory needle.
    var exportFrom = filter.From?.ToString("yyyy-MM-dd") ?? "";
    var exportTo   = filter.To?.ToString("yyyy-MM-dd")   ?? "";
    var exportQs   = $"?from={exportFrom}&to={exportTo}";

    // Pre-serialize the chart data so the JS is plain literal arrays —
    // saves us escaping headaches inside <script>.
    string DaysJson(IEnumerable<TrendPoint> series) =>
        "[" + string.Join(",", series.Select(p => "\"" + p.Date.ToString("yyyy-MM-dd") + "\"")) + "]";
    string CountsJson(IEnumerable<TrendPoint> series) =>
        "[" + string.Join(",", series.Select(p => p.Count.ToString())) + "]";

    // ── Friendly machine-type labels ───────────────────────────────────
    // Enum members like SRVWaterBowser / TruckMountedCrane don't read well
    // raw — translate to the short labels operators actually use, matching
    // the SQL view and the mobile app's chip labels.
    string TypeLabel(MachineType t) => t switch {
        MachineType.ADT                   => "ADT",
        MachineType.ArticulatedWaterTruck => "Artic. Water Truck",
        MachineType.DieselBowser          => "Diesel Bowser",
        MachineType.Drills                => "Drills",
        MachineType.Excavator             => "Excavator",
        MachineType.FEL                   => "FEL",
        MachineType.Forklift              => "Forklift",
        MachineType.Grader                => "Grader",
        MachineType.LDV                   => "LDV",
        MachineType.SRVWaterBowser        => "SRV / Water Bowser",
        MachineType.TrackDozer            => "Track Dozer",
        MachineType.RDT                   => "RDT",
        MachineType.TruckMountedCrane     => "Truck-Mounted Crane",
        MachineType.TLB                   => "TLB",
        _                                 => t.ToString()
    };

    // ── Severity chip colour for the renewal queue ─────────────────────
    // Same five-band palette as Power BI Page 5 — keep the hex values in
    // sync so screenshots from either surface match exactly.
    string StatusBadgeBg(string s) => s switch {
        "Revoked"      => "#475569",   // slate
        "Expired"      => "#ef4444",   // red
        "Expiring 7d"  => "#f59e0b",   // amber
        "Expiring 30d" => "#fbbf24",   // gold
        _              => "#22c55e"    // green (Valid)
    };
    string StatusBadgeFg(string s) => s switch {
        "Revoked" or "Expired" or "Expiring 7d" => "#ffffff",
        _                                       => "#0d1729"
    };

    // ── Audit-category colour for the donut + chips ───────────────────
    string CategoryColour(string c) => c switch {
        "Configuration" => "#0e9488",   // teal
        "Admin policy"  => "#8b5cf6",   // violet
        "User access"   => "#06b6d4",   // cyan
        "Competency"    => "#f59e0b",   // amber
        _               => "#94a3b8"    // muted
    };

    // ── Pre-compute chart-data JS literals ─────────────────────────────
    // Razor @section Scripts compiles as a separate closure that doesn't
    // have access to the local functions declared above. We resolve the
    // labels/colours here in the top block (where TypeLabel + CategoryColour
    // ARE in scope), then the script section just embeds the resulting
    // string literals.
    string competencyTypeLabelsJs = "[" + string.Join(",", dashboard.Competency.ByMachineType
        .Select(r => "\"" + TypeLabel(r.MachineType).Replace("\"", "\\\"") + "\"")) + "]";
    string competencyTypeCountsJs = "[" + string.Join(",", dashboard.Competency.ByMachineType
        .Select(r => r.Active.ToString())) + "]";

    string configCatLabelsJs = "[" + string.Join(",", dashboard.ConfigAudit.ByCategory
        .Select(c => "\"" + c.Category + "\"")) + "]";
    string configCatCountsJs = "[" + string.Join(",", dashboard.ConfigAudit.ByCategory
        .Select(c => c.Count.ToString())) + "]";
    string configCatColorsJs = "[" + string.Join(",", dashboard.ConfigAudit.ByCategory
        .Select(c => "\"" + CategoryColour(c.Category) + "\"")) + "]";
}

@* ───────────── PAGE HEAD ───────────── *@
<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;flex-wrap:wrap;gap:12px">
    <div>
        <h2 class="page-title">Reports & KPIs</h2>
        <p class="page-subtitle">
            Pre-shift inspections, defect trend, and machine / operator scorecards
            — scoped to <strong>@dashboard.From.ToString("yyyy-MM-dd")</strong> →
            <strong>@dashboard.To.ToString("yyyy-MM-dd")</strong>.
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
        <a href="/Admin/ExportReportsXlsx@exportQs"
           class="btn btn-ghost" title="Download Excel for the current scope">
            📊 Download Excel
        </a>
        <a href="/Admin/ExportReportsPdf@exportQs"
           class="btn btn-ghost" title="Download PDF for the current scope">
            📄 Download PDF
        </a>
    </div>
</div>

@* ───────────── SEARCH + DATE-RANGE BAR ───────────── *@
@await Html.PartialAsync("_ListFilterBar", filter,
    new ViewDataDictionary(ViewData) {
        { "Placeholder", "Search machine number, name, or operator…" },
        { "Action",      "/Admin/Reports" }
    })

@* ───────────── Phase 6.4 — OPERATIONAL QUEUE SNAPSHOT ─────────────
   "What's stuck in the workflow right now?" — current depth of every
   queue, each card clicking through to the relevant operations page.
   Sits above the period KPIs because period KPIs are retrospective
   (last 30 days) while these are operational (right now). *@
@{
    var q = dashboard.OperationalQueues;
    var anyQueueAged = q.OldestPlannerDefectHours > 24 || q.OldestDispatchHours > 4;
}
<div style="margin-bottom:24px">
    <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:6px;margin-bottom:8px">
        <h3 style="margin:0;font-size:15px">🚦 Operational queue snapshot</h3>
        <span style="font-size:11px;color:var(--text-muted)">
            Live state — not scoped to the date filter. Click any tile to jump to that queue.
        </span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px">
        <a href="/Supervisor" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #06b6d4;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Supervisor sign-off</div>
                <div class="stat-value" style="font-size:24px;color:#06b6d4">@q.SupervisorPendingSignOff</div>
                <div class="stat-sub" style="font-size:10px;color:var(--text-muted)">GO-BUT 24H/30D</div>
            </div>
        </a>
        <a href="/Planner" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #f59e0b;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Planner: defects</div>
                <div class="stat-value" style="font-size:24px;color:#f59e0b">@q.PlannerPendingDefects</div>
                <div class="stat-sub" style="font-size:10px;color:@(q.OldestPlannerDefectHours > 24 ? "#ef4444" : "var(--text-muted)")">
                    @(q.PlannerPendingDefects == 0 ? "—" : $"oldest {q.OldestPlannerDefectHours}h")
                </div>
            </div>
        </a>
        <a href="/Planner" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #14b8a6;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Planner: submissions</div>
                <div class="stat-value" style="font-size:24px;color:#14b8a6">@q.PlannerPendingSubmissions</div>
                <div class="stat-sub" style="font-size:10px;color:var(--text-muted)">last 48h, approved</div>
            </div>
        </a>
        <a href="/ControlRoom" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #8b5cf6;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Control Room dispatch</div>
                <div class="stat-value" style="font-size:24px;color:#8b5cf6">@q.ControlRoomQueue</div>
                <div class="stat-sub" style="font-size:10px;color:@(q.OldestDispatchHours > 4 ? "#ef4444" : "var(--text-muted)")">
                    @(q.ControlRoomQueue == 0 ? "—" : $"oldest {q.OldestDispatchHours}h")
                </div>
            </div>
        </a>
        <a href="/ControlRoom" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #0e7490;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Control Room ack inbox</div>
                <div class="stat-value" style="font-size:24px;color:#0e7490">@q.ControlRoomAcknowledgeInbox</div>
                <div class="stat-sub" style="font-size:10px;color:var(--text-muted)">approved · last 48h</div>
            </div>
        </a>
        <a href="/Mechanic" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #f97316;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Workshop: open</div>
                <div class="stat-value" style="font-size:24px;color:#f97316">@q.WorkshopOpenDefects</div>
                <div class="stat-sub" style="font-size:10px;color:var(--text-muted)">in repair</div>
            </div>
        </a>
        <a href="/Admin/PendingClearances" style="text-decoration:none;color:inherit">
            <div class="stat-card" style="border-top:3px solid #ef4444;padding:12px;cursor:pointer">
                <div class="stat-label" style="font-size:11px">Admin clearance</div>
                <div class="stat-value" style="font-size:24px;color:#ef4444">@q.AwaitingAdminClearance</div>
                <div class="stat-sub" style="font-size:10px;color:var(--text-muted)">machines awaiting</div>
            </div>
        </a>
    </div>
    @if (anyQueueAged)
    {
        <p style="font-size:11px;color:#ef4444;margin:8px 0 0">
            ⚠ One or more queues have aged items (Planner &gt; 24h or Dispatch &gt; 4h) — investigate before they breach SLA.
        </p>
    }
</div>

@* ───────────── KPI CARDS ───────────── *@
<div class="stat-grid" style="margin-bottom:24px">
    <div class="stat-card info">
        <div class="stat-label">Submissions</div>
        <div class="stat-value">@k.TotalSubmissions</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">in window</div>
    </div>
    <div class="stat-card go">
        <div class="stat-label">GO Rate</div>
        <div class="stat-value">@k.GoRatePct.ToString("0.0")%</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">@k.GoCount of @k.TotalSubmissions</div>
    </div>
    <div class="stat-card gobut">
        <div class="stat-label">GO-BUT</div>
        <div class="stat-value">@k.GoButCount</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">supervisor sign-off</div>
    </div>
    <div class="stat-card nogo">
        <div class="stat-label">NO-GO</div>
        <div class="stat-value">@k.NoGoCount</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">machine immobilised</div>
    </div>
    <div class="stat-card" style="border-top:3px solid #f97316">
        <div class="stat-label">Defects (period)</div>
        <div class="stat-value" style="color:#f97316">@k.DefectCount</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">items flagged</div>
    </div>
    <div class="stat-card" style="border-top:3px solid #8b5cf6">
        <div class="stat-label">Open Defects</div>
        <div class="stat-value" style="color:#a78bfa">@k.OpenDefects</div>
        <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">@k.AwaitingParts awaiting parts</div>
    </div>
</div>

@* ───────────── Phase 6.10 — FLEET PERFORMANCE SPLIT ─────────────
   One row per fleet (Mota-Engil, Moolmans, Belfast Direct, …) with
   submissions / GO-rate / NO-GO / open defects / avg resolution time
   side-by-side. The visual bar shows GO-rate relative to 100% so
   contractors compare at a glance. Period-scoped (matches the date
   filter at the top) because comparing contractor performance is
   naturally a window question. *@
@if (dashboard.FleetPerformance.Any())
{
    <div class="chart-card" style="margin-top:20px">
        <div class="chart-head">
            <h3>Fleet performance</h3>
            <p>Contractor scorecard for @dashboard.From.ToString("MMM d") → @dashboard.To.ToString("MMM d"). Open defects + average resolution are current-state.</p>
        </div>
        <table class="data-table" style="font-size:13px">
            <thead>
                <tr>
                    <th>Fleet</th>
                    <th style="text-align:right">Machines</th>
                    <th style="text-align:right">Checks</th>
                    <th>GO rate</th>
                    <th style="text-align:right">GO-BUT</th>
                    <th style="text-align:right">NO-GO</th>
                    <th style="text-align:right">Open</th>
                    <th style="text-align:right">Avg fix</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in dashboard.FleetPerformance)
                {
                    var goPct        = (int)Math.Round(f.GoRatePct);
                    var goBarColor   = f.GoRatePct >= 90 ? "#16a34a"
                                     : f.GoRatePct >= 75 ? "#f59e0b"
                                     : "#ef4444";
                    <tr>
                        <td>
                            <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:@f.FleetColor;margin-right:6px;vertical-align:middle"></span>
                            <strong>@f.FleetName</strong>
                        </td>
                        <td style="text-align:right;font-family:var(--font-mono)">@f.MachineCount</td>
                        <td style="text-align:right;font-family:var(--font-mono)">@f.Submissions</td>
                        <td style="vertical-align:middle">
                            <div style="display:flex;align-items:center;gap:8px">
                                <div style="background:#e5e7eb;border-radius:4px;height:10px;width:120px;overflow:hidden">
                                    <div style="background:@goBarColor;height:100%;width:@(goPct)%"></div>
                                </div>
                                <strong style="font-family:var(--font-mono);color:@goBarColor;min-width:50px">@(f.GoRatePct.ToString("0.0"))%</strong>
                            </div>
                        </td>
                        <td style="text-align:right;font-family:var(--font-mono);color:#06b6d4">@f.GoButCount</td>
                        <td style="text-align:right;font-family:var(--font-mono);color:@(f.NoGoCount > 0 ? "#ef4444" : "var(--text-muted)");font-weight:@(f.NoGoCount > 0 ? "600" : "400")">@f.NoGoCount</td>
                        <td style="text-align:right;font-family:var(--font-mono);color:@(f.OpenDefects > 0 ? "#f97316" : "var(--text-muted)")">@f.OpenDefects</td>
                        <td style="text-align:right;font-family:var(--font-mono);color:var(--text-muted)">
                            @(f.AvgResolutionHrs == 0 ? "—" : $"{f.AvgResolutionHrs:0.0}h")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p style="font-size:10px;color:var(--text-muted);margin-top:8px;line-height:1.5">
            GO-rate bar: green ≥ 90%, amber 75–89%, red &lt; 75%. "Avg fix" is the mean DispatchedAt → ResolvedAt time across defects closed in this period. "Open" is the current open-defect count for machines in this fleet — not period-scoped. The "(Unfleeted)" row aggregates machines that haven't been assigned to a contractor fleet yet.
        </p>
    </div>
}

@* ───────────── CHARTS ─────────────
   Chart.js 4.x via the same CDN scheme the rest of the app uses. The data
   arrays are emitted inline as JSON literals above. *@
<div class="chart-row">
    <div class="chart-card">
        <div class="chart-head">
            <h3>Submissions per day</h3>
            <p>Daily pre-use inspection volume across the selected window.</p>
        </div>
        <canvas id="chartSubmissions" height="120"></canvas>
    </div>
    <div class="chart-card">
        <div class="chart-head">
            <h3>Defects per day</h3>
            <p>How many checklist items came back flagged each day.</p>
        </div>
        <canvas id="chartDefects" height="120"></canvas>
    </div>
</div>

<div class="chart-row">
    <div class="chart-card">
        <div class="chart-head">
            <h3>Result breakdown</h3>
            <p>Submission outcomes for the current scope.</p>
        </div>
        <canvas id="chartStatus" height="140"></canvas>
    </div>
    <div class="chart-card">
        <div class="chart-head">
            <h3>Top 10 machines by defects</h3>
            <p>Which equipment is generating the most repair work.</p>
        </div>
        <canvas id="chartMachines" height="140"></canvas>
    </div>
</div>

@* ───────────── LEADERBOARDS ───────────── *@
<div class="chart-row">
    <div class="chart-card">
        <div class="chart-head">
            <h3>Top operators</h3>
            <p>Pre-use inspections submitted in the current scope.</p>
        </div>
        @if (!dashboard.TopOperators.Any())
        {
            <p style="color:var(--text-muted);font-size:12px;padding:20px;text-align:center">No submissions in this window.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Operator</th>
                        <th style="text-align:right">Submissions</th>
                        <th style="text-align:right">GO</th>
                        <th style="text-align:right">Defects flagged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in dashboard.TopOperators)
                    {
                        var goPct = op.TotalSubmissions == 0 ? 0 : Math.Round(100.0 * op.GoCount / op.TotalSubmissions, 0);
                        <tr>
                            <td>
                                <strong>@op.OperatorName</strong>
                                <div style="font-size:11px;color:var(--text-muted)">#@op.EmployeeNumber</div>
                            </td>
                            <td style="text-align:right;font-family:var(--font-mono)">@op.TotalSubmissions</td>
                            <td style="text-align:right">
                                <span class="badge badge-go" style="font-size:10px">@op.GoCount</span>
                                <span style="font-size:11px;color:var(--text-muted);margin-left:4px">@goPct%</span>
                            </td>
                            <td style="text-align:right;color:@(op.DefectCount > 0 ? "var(--red-nogo)" : "var(--text-muted)");font-weight:600">
                                @op.DefectCount
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* ─── Phase 6.5 — Per-Artisan workshop load ──────────────────────
       Sits alongside Top Operators in the same grid row. Sorted
       descending by current open load so over-loaded artisans surface
       at the top. The bar visually encodes load relative to the most-
       loaded artisan — a quick "who needs help" read.
       AwaitingParts is shown as a sub-bucket of OpenLoad: open includes
       awaiting-parts, but the latter isn't actionable for the dispatcher
       (artisan is blocked on procurement, not workload). *@
    <div class="chart-card">
        <div class="chart-head">
            <h3>Artisan workshop load</h3>
            <p>Current open jobcards per artisan + last 7 days throughput. Sorted by current load.</p>
        </div>
        @if (!dashboard.ArtisanLoad.Any())
        {
            <p style="color:var(--text-muted);text-align:center;padding:24px 0">
                No active artisans found.
            </p>
        }
        else
        {
            var maxLoad = dashboard.ArtisanLoad.Max(a => a.OpenLoad);
            if (maxLoad == 0) maxLoad = 1;
            <table class="data-table" style="font-size:12px">
                <thead>
                    <tr>
                        <th>Artisan</th>
                        <th style="text-align:right">Open</th>
                        <th>Load</th>
                        <th style="text-align:right">Closed 7d</th>
                        <th style="text-align:right">Avg close</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in dashboard.ArtisanLoad)
                    {
                        var pctOfMax = (int)Math.Round(100.0 * a.OpenLoad / maxLoad);
                        var barColor = a.OpenLoad >= 5 ? "#ef4444" : (a.OpenLoad >= 3 ? "#f59e0b" : "#14b8a6");
                        <tr>
                            <td>
                                <strong>@a.ArtisanName</strong>
                                <div style="font-size:10px;color:var(--text-muted);margin-top:2px">
                                    #@a.EmployeeNumber
                                    @if (!string.IsNullOrEmpty(a.FleetName))
                                    {
                                        <span style="display:inline-block;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:600;background:@(a.FleetColor ?? "#475569");color:#fff;margin-left:4px">
                                            @a.FleetName
                                        </span>
                                    }
                                </div>
                            </td>
                            <td style="text-align:right;font-weight:700;font-family:var(--font-mono);color:@barColor">
                                @a.OpenLoad
                                @if (a.AwaitingParts > 0)
                                {
                                    <div style="font-size:10px;color:var(--text-muted);font-weight:400">
                                        @a.AwaitingParts wait-parts
                                    </div>
                                }
                            </td>
                            <td style="width:120px;vertical-align:middle">
                                <div style="background:#e5e7eb;border-radius:4px;height:10px;overflow:hidden">
                                    <div style="background:@barColor;height:100%;width:@(pctOfMax)%"></div>
                                </div>
                            </td>
                            <td style="text-align:right;font-family:var(--font-mono);color:var(--text-muted)">@a.ClosedLast7d</td>
                            <td style="text-align:right;font-family:var(--font-mono);color:var(--text-muted)">
                                @(a.ClosedLast7d == 0 ? "—" : $"{a.AvgClosureHours:0.0}h")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p style="font-size:10px;color:var(--text-muted);margin-top:8px;line-height:1.5">
                Bar colour: green ≤ 2 open · amber 3–4 open · red ≥ 5 open. "Avg close" is the mean time from dispatch to resolution across the artisan's closures in the last 7 days. "wait-parts" splits out jobcards parked on the parts queue, where the artisan is blocked on procurement rather than capacity.
            </p>
        }
    </div>

    <div class="chart-card">
        <div class="chart-head">
            <h3>Open-defect aging</h3>
            <p>How long the open repair queue has been waiting.</p>
        </div>
        @{
            var totalOpen = dashboard.Aging.UnderOneDay + dashboard.Aging.OneToThree +
                            dashboard.Aging.ThreeToSeven + dashboard.Aging.OverSeven;
            int Pct(int n) => totalOpen == 0 ? 0 : (int)Math.Round(100.0 * n / totalOpen);
        }
        <div style="padding:12px 16px">
            <div class="aging-row">
                <span class="aging-label">&lt; 1 day</span>
                <div class="aging-bar"><div style="width:@(Pct(dashboard.Aging.UnderOneDay))%;background:#22c55e"></div></div>
                <span class="aging-count">@dashboard.Aging.UnderOneDay</span>
            </div>
            <div class="aging-row">
                <span class="aging-label">1–3 days</span>
                <div class="aging-bar"><div style="width:@(Pct(dashboard.Aging.OneToThree))%;background:#06b6d4"></div></div>
                <span class="aging-count">@dashboard.Aging.OneToThree</span>
            </div>
            <div class="aging-row">
                <span class="aging-label">3–7 days</span>
                <div class="aging-bar"><div style="width:@(Pct(dashboard.Aging.ThreeToSeven))%;background:#f59e0b"></div></div>
                <span class="aging-count">@dashboard.Aging.ThreeToSeven</span>
            </div>
            <div class="aging-row">
                <span class="aging-label">&gt; 7 days</span>
                <div class="aging-bar"><div style="width:@(Pct(dashboard.Aging.OverSeven))%;background:#ef4444"></div></div>
                <span class="aging-count" style="color:#fca5a5">@dashboard.Aging.OverSeven</span>
            </div>
        </div>
        <p style="font-size:11px;color:var(--text-muted);padding:0 16px 14px">
            Aging buckets are absolute — they don't depend on the date filter above. They reflect every open defect in the system right now.
        </p>
    </div>
</div>

@* ═════════════════════════════════════════════════════════════════════
   OPERATOR COMPETENCY HEALTH  (mirrors Power BI Page 5)
   ─────────────────────────────────────────────────────────────────────
   Section header + 4 KPI cards + machine-type donut + renewal queue.
   Section is hidden entirely when no competency rows exist at all —
   a freshly-installed mine without any certificates loaded shouldn't
   see "0% compliant"; that's misleading. ════════════════════════════════ *@
@{
    var comp = dashboard.Competency;
}
@if (comp.OperatorsWithAny > 0 || comp.RenewalsDue30d > 0 || comp.LapsedCertificates > 0)
{
    <div style="margin-top:36px;padding-bottom:10px;border-bottom:1px solid var(--steel-border)">
        <h2 style="font-size:18px;margin:0">🎓 Operator Competency Health</h2>
        <p style="font-size:12px;color:var(--text-muted);margin:2px 0 0">
            MHSA Section 22(a) — every operator must hold a valid certificate for the machine type they're running.
            Mirrors the Operator Competency page of the Power BI dashboard.
        </p>
    </div>

    @* ── KPI cards (4 across) ───────────────────────────────────────── *@
    <div class="stat-grid" style="margin-top:18px;margin-bottom:22px">
        @{
            var compClass = comp.CompliancePct >= 98 ? "go"
                          : comp.CompliancePct >= 90 ? "gobut"
                          : "nogo";
        }
        <div class="stat-card @compClass">
            <div class="stat-label">Compliance %</div>
            <div class="stat-value">@comp.CompliancePct.ToString("0.0")%</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">
                @comp.OperatorsFullyValid of @comp.OperatorsWithAny operators fully valid
            </div>
        </div>
        <div class="stat-card" style="border-top:3px solid #f59e0b">
            <div class="stat-label">Expiring (7d)</div>
            <div class="stat-value" style="color:#fbbf24">@comp.OperatorsExpiring7</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">operators with imminent renewals</div>
        </div>
        <div class="stat-card nogo">
            <div class="stat-label">Operators lapsed</div>
            <div class="stat-value">@(comp.OperatorsExpired + comp.OperatorsRevoked)</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">
                @comp.OperatorsExpired expired · @comp.OperatorsRevoked revoked
            </div>
        </div>
        <div class="stat-card info">
            <div class="stat-label">Renewals due (30d)</div>
            <div class="stat-value">@comp.RenewalsDue30d</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">certificates in the pipeline</div>
        </div>
    </div>

    <div class="chart-row">
        @* ── Bench depth by machine type (donut + legend table) ───────── *@
        <div class="chart-card">
            <div class="chart-head">
                <h3>Bench depth by machine type</h3>
                <p>Currently-active certificates across the fleet, by machine class.</p>
            </div>
            @if (!comp.ByMachineType.Any())
            {
                <p style="color:var(--text-muted);font-size:12px;padding:20px;text-align:center">No active certificates on file.</p>
            }
            else
            {
                @* Fixed-height wrapper so Chart.js (responsive +
                   maintainAspectRatio: false) sizes the canvas to a stable
                   200px instead of recursively growing it to match the
                   parent .chart-card (which also contains the legend table
                   below — a classic infinite-grow trap). *@
                <div style="position:relative;height:200px">
                    <canvas id="chartCompetencyTypes"></canvas>
                </div>
                <table class="data-table" style="margin-top:14px">
                    <thead>
                        <tr>
                            <th>Machine type</th>
                            <th style="text-align:right">Active</th>
                            <th style="text-align:right">Valid</th>
                            <th style="text-align:right">30d</th>
                            <th style="text-align:right">7d</th>
                            <th style="text-align:right">Expired</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in comp.ByMachineType)
                        {
                            <tr>
                                <td><strong>@TypeLabel(row.MachineType)</strong></td>
                                <td style="text-align:right;font-family:var(--font-mono)">@row.Active</td>
                                <td style="text-align:right;color:#22c55e;font-weight:600">@row.Valid</td>
                                <td style="text-align:right;color:#fbbf24">@(row.Expiring30 > 0 ? row.Expiring30.ToString() : "–")</td>
                                <td style="text-align:right;color:#f59e0b;font-weight:600">@(row.Expiring7 > 0 ? row.Expiring7.ToString() : "–")</td>
                                <td style="text-align:right;color:@(row.Expired > 0 ? "var(--red-nogo)" : "var(--text-muted)");font-weight:600">@(row.Expired > 0 ? row.Expired.ToString() : "–")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* ── Renewal queue (top 25) ───────────────────────────────────── *@
        <div class="chart-card">
            <div class="chart-head">
                <h3>Renewal queue (next 30 days)</h3>
                <p>Action list — every active certificate expiring soon, oldest first.</p>
            </div>
            @if (!comp.Queue.Any())
            {
                <p style="color:#22c55e;font-size:12px;padding:20px;text-align:center">
                    ✅ Every active certificate is valid for more than 30 days. No renewal action needed.
                </p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Operator</th>
                            <th>Machine</th>
                            <th style="text-align:right">Expires</th>
                            <th style="text-align:center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in comp.Queue)
                        {
                            <tr>
                                <td>
                                    <strong>@r.OperatorName</strong>
                                    <div style="font-size:11px;color:var(--text-muted)">#@r.EmployeeNumber</div>
                                </td>
                                <td>
                                    @TypeLabel(r.MachineType)
                                    @if (!string.IsNullOrEmpty(r.CertificateNumber))
                                    {
                                        <div style="font-size:10px;color:var(--text-muted);font-family:var(--font-mono)">@r.CertificateNumber</div>
                                    }
                                </td>
                                <td style="text-align:right;font-family:var(--font-mono);font-size:13px">
                                    @r.ExpiresAt.ToString("yyyy-MM-dd")
                                    <div style="font-size:10px;color:var(--text-muted)">@(r.DaysToExpiry < 0 ? $"{-r.DaysToExpiry}d ago" : $"in {r.DaysToExpiry}d")</div>
                                </td>
                                <td style="text-align:center">
                                    <span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;background:@StatusBadgeBg(r.Status);color:@StatusBadgeFg(r.Status)">
                                        @r.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p style="font-size:11px;color:var(--text-muted);padding:8px 4px 0">
                    Showing top @comp.Queue.Count entries.
                    Open <a href="/Admin/Competencies" style="color:var(--teal)">Admin → Competencies</a> to manage individual operators.
                </p>
            }
        </div>
    </div>
}

@* ═════════════════════════════════════════════════════════════════════
   CONFIGURATION & POLICY AUDIT  (mirrors Power BI Page 6)
   ─────────────────────────────────────────────────────────────────────
   Who changed what, when. Reads the AuditEvents table filtered on the
   settings / admin / user / competency action constants. Hidden when
   there's been no policy activity at all in 90 days. ══════════════════ *@
@{
    var cfg = dashboard.ConfigAudit;
}
@if (cfg.Changes90d > 0)
{
    <div style="margin-top:36px;padding-bottom:10px;border-bottom:1px solid var(--steel-border)">
        <h2 style="font-size:18px;margin:0">🛡 Configuration &amp; Policy Audit</h2>
        <p style="font-size:12px;color:var(--text-muted);margin:2px 0 0">
            Every system configuration change, admin role change, user-access change, and competency lifecycle event in the last 90 days.
            Inspector-ready "who changed what, when" report.
        </p>
    </div>

    @* ── KPI cards (4 across) ───────────────────────────────────────── *@
    <div class="stat-grid" style="margin-top:18px;margin-bottom:22px">
        <div class="stat-card info">
            <div class="stat-label">Changes (30d)</div>
            <div class="stat-value">@cfg.Changes30d</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">@cfg.Changes90d in last 90 days</div>
        </div>
        <div class="stat-card" style="border-top:3px solid #8b5cf6">
            <div class="stat-label">Admin policy (30d)</div>
            <div class="stat-value" style="color:#a78bfa">@cfg.AdminPolicy30d</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">admin role / account events</div>
        </div>
        <div class="stat-card" style="border-top:3px solid #06b6d4">
            <div class="stat-label">User access (30d)</div>
            <div class="stat-value" style="color:#22d3ee">@cfg.UserAccess30d</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">deactivations + password resets</div>
        </div>
        <div class="stat-card" style="border-top:3px solid #f59e0b">
            <div class="stat-label">Distinct actors (90d)</div>
            <div class="stat-value" style="color:#fbbf24">@cfg.DistinctActors90d</div>
            <div class="stat-sub" style="color:var(--text-muted);font-size:11px;margin-top:4px">
                last change @(cfg.LastChange?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
            </div>
        </div>
    </div>

    <div class="chart-row">
        @* ── Donut: by category ──────────────────────────────────────── *@
        <div class="chart-card">
            <div class="chart-head">
                <h3>Activity by category</h3>
                <p>Where the policy activity has been concentrated in the last 90 days.</p>
            </div>
            @* Same fixed-height wrapper as the competency donut — keeps
               the canvas from infinite-growing now that the legend table
               below shares the parent .chart-card. *@
            <div style="position:relative;height:200px">
                <canvas id="chartConfigCategories"></canvas>
            </div>
            <table class="data-table" style="margin-top:14px">
                <thead><tr><th>Category</th><th style="text-align:right">Events</th></tr></thead>
                <tbody>
                    @foreach (var c in cfg.ByCategory)
                    {
                        <tr>
                            <td>
                                <span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:@CategoryColour(c.Category);margin-right:8px;vertical-align:middle"></span>
                                @c.Category
                            </td>
                            <td style="text-align:right;font-family:var(--font-mono);font-weight:600">@c.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Recent audit table (top 30) ──────────────────────────────── *@
        <div class="chart-card">
            <div class="chart-head">
                <h3>Recent changes</h3>
                <p>Most recent 30 policy or configuration events. Drill via <a href="/Admin/Audit" style="color:var(--teal)">Admin → Audit</a> for the full trail.</p>
            </div>
            @if (!cfg.Recent.Any())
            {
                <p style="color:var(--text-muted);font-size:12px;padding:20px;text-align:center">No policy events in the last 90 days.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Actor</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in cfg.Recent)
                        {
                            <tr>
                                <td style="font-size:11px;color:var(--text-muted);font-family:var(--font-mono);white-space:nowrap">
                                    @row.OccurredAt.ToLocalTime().ToString("MM-dd HH:mm")
                                </td>
                                <td>
                                    <strong style="font-size:12px">@row.ActorName</strong>
                                    <div style="font-size:10px;color:var(--text-muted)">@row.ActorRole</div>
                                </td>
                                <td>
                                    <div style="font-family:var(--font-mono);font-size:11px">@row.Action</div>
                                    <div>
                                        <span style="display:inline-block;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:600;background:@CategoryColour(row.Category);color:#fff">
                                            @row.Category
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ───────────── RAW TABLE ───────────── *@
<h3 style="font-size:15px;margin:24px 0 10px">Submissions in scope</h3>

@if (!Model.Any() && filter.IsActive)
{
    <div style="text-align:center;padding:40px;color:var(--text-muted)">
        <div style="font-size:36px;margin-bottom:8px">🔍</div>
        <p>No submissions match your search. Try widening the date range or clearing filters.</p>
    </div>
}
else if (!Model.Any())
{
    <div style="text-align:center;padding:40px;color:var(--text-muted)">
        <div style="font-size:36px;margin-bottom:8px">📋</div>
        <p>No submissions in this window.</p>
    </div>
}
else
{
    @if (filter.IsActive)
    {
        <p style="font-size:12px;color:var(--text-muted);margin-bottom:10px">
            Showing @Model.Count of @totalUnfiltered submissions in the current scope.
        </p>
    }
    <table class="data-table" data-paginate="10">
        <thead>
            <tr>
                <th>Date / Time</th>
                <th>Machine</th>
                <th>Operator</th>
                <th>Shift</th>
                <th>Status</th>
                <th>Defects</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                var badgeClass = s.Status switch {
                    ChecklistStatus.Go                => "badge-go",
                    ChecklistStatus.GoButRepair24H    => "badge-gobut",
                    ChecklistStatus.GoTillNextService => "badge-gobut",
                    ChecklistStatus.NoGo              => "badge-nogo",
                    _                                 => "badge-pending"
                };
                var badgeLabel = s.Status switch {
                    ChecklistStatus.Go                => "GO",
                    ChecklistStatus.GoButRepair24H    => "GO-BUT 24H",
                    ChecklistStatus.GoTillNextService => "GO-BUT 30D",
                    ChecklistStatus.NoGo              => "NO-GO",
                    _                                 => "Pending"
                };
                <tr>
                    <td style="font-size:13px;color:var(--text-muted)">
                        @s.SubmittedAt.ToString("yyyy-MM-dd HH:mm")
                    </td>
                    <td>
                        <strong>@s.Machine.MachineNumber</strong>
                        <div style="font-size:12px;color:var(--text-muted)">@s.Machine.MachineName</div>
                    </td>
                    <td>@s.Operator.FullName</td>
                    <td style="color:var(--text-muted);font-size:13px">@s.Shift</td>
                    <td><span class="badge @badgeClass">@badgeLabel</span></td>
                    <td style="color:var(--red-nogo);font-weight:600">
                        @{
                            var defects = s.Items.Count(i => i.Status == ItemStatus.Defect);
                        }
                        @(defects > 0 ? defects.ToString() : "–")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    .chart-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 18px; }
    @@media (max-width: 980px) { .chart-row { grid-template-columns: 1fr; } }

    .chart-card {
        background: var(--steel-mid, #111c2e);
        border: 1px solid var(--steel-border, #1f2a3a);
        border-radius: 10px; padding: 16px 18px;
    }
    .chart-card .chart-head { margin-bottom: 12px; }
    .chart-card h3 { font-size: 14px; font-weight: 700; margin: 0; }
    .chart-card .chart-head p {
        font-size: 11px; color: var(--text-muted, #94a3b8);
        margin: 2px 0 0; line-height: 1.5;
    }

    .aging-row {
        display: grid;
        grid-template-columns: 80px 1fr 40px;
        gap: 10px; align-items: center;
        padding: 6px 0; font-size: 12px;
    }
    .aging-label { color: var(--text-muted, #94a3b8); }
    .aging-bar {
        height: 8px; background: rgba(255,255,255,.06);
        border-radius: 4px; overflow: hidden;
    }
    .aging-bar > div { height: 100%; transition: width .3s ease; }
    .aging-count {
        text-align: right; font-family: var(--font-mono);
        font-weight: 700; color: var(--text-primary, #e5e7eb);
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        // ── Inputs ─────────────────────────────────────────────────────
        // Server-rendered JSON literals (no escaping needed — only digits and quoted dates).
        const days        = @Html.Raw(DaysJson(dashboard.SubmissionTrend));
        const subsCounts  = @Html.Raw(CountsJson(dashboard.SubmissionTrend));
        const defCounts   = @Html.Raw(CountsJson(dashboard.DefectTrend));

        const statusLabels = ['GO','GO-BUT','NO-GO','Rejected'];
        const statusCounts = [@k.GoCount, @k.GoButCount, @k.NoGoCount, @k.RejectedCount];
        const statusColors = ['#22c55e','#06b6d4','#ef4444','#f97316'];

        const topMachineLabels = @Html.Raw("[" + string.Join(",", dashboard.TopMachines.Select(m => "\"" + m.MachineNumber.Replace("\"", "\\\"") + "\"")) + "]");
        const topMachineCounts = @Html.Raw("[" + string.Join(",", dashboard.TopMachines.Select(m => m.DefectCount)) + "]");

        // ── Shared style ────────────────────────────────────────────────
        Chart.defaults.color           = '#94a3b8';
        Chart.defaults.borderColor     = '#1f2a3a';
        Chart.defaults.font.family     = "system-ui, -apple-system, sans-serif";
        Chart.defaults.font.size       = 11;

        const lineOpts = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales:  {
                x: { grid: { display: false } },
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        };

        // ── Charts ──────────────────────────────────────────────────────
        new Chart(document.getElementById('chartSubmissions'), {
            type: 'line',
            data: {
                labels: days,
                datasets: [{
                    data: subsCounts,
                    borderColor:     '#0e9488',
                    backgroundColor: 'rgba(14,148,136,0.15)',
                    fill: true, tension: .3, pointRadius: 2
                }]
            },
            options: lineOpts
        });

        new Chart(document.getElementById('chartDefects'), {
            type: 'line',
            data: {
                labels: days,
                datasets: [{
                    data: defCounts,
                    borderColor:     '#ef4444',
                    backgroundColor: 'rgba(239,68,68,0.15)',
                    fill: true, tension: .3, pointRadius: 2
                }]
            },
            options: lineOpts
        });

        new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{ data: statusCounts, backgroundColor: statusColors, borderWidth: 0 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        new Chart(document.getElementById('chartMachines'), {
            type: 'bar',
            data: {
                labels: topMachineLabels,
                datasets: [{
                    data: topMachineCounts,
                    backgroundColor: '#f97316',
                    borderColor: '#ea580c', borderWidth: 1
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales:  {
                    x: { beginAtZero: true, ticks: { precision: 0 } },
                    y: { grid: { display: false } }
                }
            }
        });

        // ── Competency: by-machine-type donut ─────────────────────────
        // Active certificate count per machine type. The legend table
        // beside the canvas already explains the per-band breakdown, so
        // this chart is kept deliberately simple: one ring, one number
        // per slice.
        const competencyTypeLabels = @Html.Raw(competencyTypeLabelsJs);
        const competencyTypeCounts = @Html.Raw(competencyTypeCountsJs);

        const competencyTypeEl = document.getElementById('chartCompetencyTypes');
        if (competencyTypeEl && competencyTypeCounts.length > 0) {
            new Chart(competencyTypeEl, {
                type: 'doughnut',
                data: {
                    labels: competencyTypeLabels,
                    datasets: [{
                        data: competencyTypeCounts,
                        backgroundColor: [
                            '#0e9488','#06b6d4','#8b5cf6','#f59e0b',
                            '#22c55e','#ef4444','#f97316','#fbbf24',
                            '#a78bfa','#22d3ee','#fb7185','#94a3b8',
                            '#84cc16','#475569'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } }
                }
            });
        }

        // ── Config audit: by-category donut ──────────────────────────
        const configCatLabels = @Html.Raw(configCatLabelsJs);
        const configCatCounts = @Html.Raw(configCatCountsJs);
        const configCatColors = @Html.Raw(configCatColorsJs);

        const configCatEl = document.getElementById('chartConfigCategories');
        if (configCatEl && configCatCounts.length > 0) {
            new Chart(configCatEl, {
                type: 'doughnut',
                data: {
                    labels: configCatLabels,
                    datasets: [{
                        data: configCatCounts,
                        backgroundColor: configCatColors,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } }
                }
            });
        }
    </script>
}
