@model List<EquipmentChecklist.Models.ApplicationUser>
@using EquipmentChecklist.Models

@*
    Single-role employee table. Rendered once per tab in Employees.cshtml.
    Lifted out as a partial so each tab's markup is identical and we only
    edit the row structure in one place.

    The `data-search` attribute on each <tr> is consumed by the page-level
    JS to do client-side filtering across name, employee #, and email
    without round-tripping to the server.
*@

@if (!Model.Any())
{
    <div class="emp-empty">
        <div class="emp-empty-icon">👤</div>
        <p>No users in this role yet.</p>
    </div>
}
else
{
    <table class="data-table" data-paginate="10">
        <thead>
            <tr>
                <th>Name</th>
                <th>Employee #</th>
                <th>Email</th>
                <th>Status</th>
                <th style="text-align:right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                // Compose the searchable text once on the server so the JS
                // filter is a cheap substring match instead of pulling text
                // out of each cell on every keystroke.
                var search = $"{user.FullName} {user.EmployeeNumber} {user.Email}".ToLowerInvariant();
                <tr data-search="@search">
                    <td><strong>@user.FullName</strong></td>
                    <td style="color:var(--text-muted)">@user.EmployeeNumber</td>
                    <td style="color:var(--text-muted)">@user.Email</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge badge-go">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-pending">Inactive</span>
                        }
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                        @* Reset Password — small inline form per row.
                           Anti-forgery is required because the controller is
                           [ValidateAntiForgeryToken]. onsubmit confirm() so
                           a slip-finger click can't reset by accident. *@
                        <form method="post" action="/Admin/ResetEmployeePassword"
                              style="display:inline-block;margin:0"
                              onsubmit="return confirm('Reset @user.FullName\'s password and email it to @user.Email?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm"
                                    title="Generate a new temporary password and email it to the user"
                                    @(string.IsNullOrEmpty(user.Email) ? "disabled" : "")>
                                🔑 Reset
                            </button>
                        </form>

                        @* Toggle activation. The button label + confirm message
                           flips based on current state so the verb matches the
                           action the admin is about to take. Hidden value is
                           rendered as a literal "true"/"false" string per branch
                           rather than from `@(!user.IsActive)` — Razor's handling
                           of bool inside an attribute value can swallow the token
                           in unexpected cases, which made Reactivate behave like
                           Deactivate. *@
                        <form method="post" action="/Admin/SetEmployeeActive"
                              style="display:inline-block;margin:0 0 0 4px"
                              onsubmit="return confirm('@(user.IsActive ? $"Deactivate {user.FullName}? They'll be signed out the next time their phone reaches the server, and offline sign-in will be blocked." : $"Reactivate {user.FullName}? They'll be able to sign in again immediately.")');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            @if (user.IsActive)
                            {
                                <input type="hidden" name="active" value="false" />
                                <button type="submit" class="btn btn-ghost btn-sm"
                                        style="color:#fca5a5"
                                        title="Block this user from signing in (online and offline)">
                                    🚫 Deactivate
                                </button>
                            }
                            else
                            {
                                <input type="hidden" name="active" value="true" />
                                <button type="submit" class="btn btn-ghost btn-sm"
                                        style="color:#86efac"
                                        title="Allow this user to sign in again">
                                    ✓ Reactivate
                                </button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
