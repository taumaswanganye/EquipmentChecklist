@{
    ViewData["Title"] = "Bulk authorise devices";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:820px">
    <a href="/Admin/Devices" class="btn btn-ghost" style="margin-bottom:16px">← Back to Devices</a>

    <h2 style="font-size:20px;margin:0 0 6px">Bulk authorise devices</h2>
    <p style="font-size:13px;color:var(--text-muted);margin:0 0 18px;line-height:1.6">
        Paste a CSV of devices to authorise in one save — designed for the
        rollout day when 20 tablets are lined up on a desk waiting for first sign-in.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom:14px">@TempData["Error"]</div>
    }

    @* ── Format hint card ─────────────────────────────────────────── *@
    <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:8px;padding:18px;margin-bottom:18px">
        <strong style="font-size:14px;color:var(--text-primary)">📋 Format — one device per line</strong>
        <pre style="background:#0b1726;color:#fbbf24;font-family:ui-monospace,monospace;font-size:12px;padding:14px;border-radius:6px;margin:10px 0 8px;overflow-x:auto;line-height:1.6">
fingerprint,label,assigned-email
# Lines starting with # are ignored — use them for comments.
a8e3...c91f,Tab Active 5 #01,thuli.dlamini@belfast.co.za
b4f7...22a8,Tab Active 5 #02,sipho.mkhize@belfast.co.za
c1e9...8b3d,Spare Tab — Workshop,SHARED
d6a2...440e,Foreman radio phone XCover7,
# Last row is shared (blank email defaults to shared when toggle is on).</pre>
        <ul style="font-size:12px;color:var(--text-muted);margin:8px 0 0 18px;line-height:1.7;padding:0">
            <li><strong>fingerprint</strong> — required. The exact SHA-256 hex string from each device's "Device not authorised" screen.</li>
            <li><strong>label</strong> — optional. Defaults to the first 8 chars of the fingerprint.</li>
            <li><strong>assigned-email</strong> — optional. Email of the operator to pin this device to. Leave blank, or write <code>SHARED</code> / <code>ANY</code>, for a shared device.</li>
        </ul>
    </div>

    <form method="post" action="/Admin/BulkAddDevices">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Device list (CSV)</label>
            <textarea name="csv" class="form-control" rows="14" required
                      style="font-family:ui-monospace,monospace;font-size:13px;line-height:1.6"
                      placeholder="Paste fingerprint,label,email rows here…"></textarea>
        </div>

        <div style="background:var(--steel-mid);border:1px solid var(--steel-border);border-radius:8px;padding:14px 18px;margin-bottom:18px">
            <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;font-size:13px;color:var(--text-primary);font-weight:normal">
                <input type="checkbox" name="defaultIsShared" value="true" checked
                       style="margin-top:3px;accent-color:var(--amber)" />
                <span>
                    <strong>Default blank-email rows to "shared device"</strong>
                    <div style="font-size:11px;color:var(--text-muted);margin-top:3px;line-height:1.5">
                        If unticked, blank-email rows are REJECTED instead of silently becoming shared —
                        safer when you want every device pinned to a specific operator.
                    </div>
                </span>
            </label>
        </div>

        <div style="display:flex;gap:10px">
            <button type="submit" class="btn btn-primary">Authorise all</button>
            <a href="/Admin/Devices" class="btn btn-ghost">Cancel</a>
        </div>
    </form>

    @* ── Tips footer ───────────────────────────────────────────────── *@
    <div style="margin-top:24px;padding:16px;background:rgba(14,148,136,.05);border-left:3px solid var(--teal);border-radius:4px;font-size:12px;color:var(--text-muted);line-height:1.7">
        <strong style="color:var(--teal)">💡 Rollout day tip</strong><br/>
        Power on each tablet, install the app, attempt to sign in. The yellow callout shows the fingerprint
        — scan the QR or take a photo. At the end of the morning, paste every fingerprint into the box above
        in one batch. Twenty devices in five minutes vs an hour of one-by-one entry.
    </div>
</div>
