@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using EquipmentChecklist.Models
@using EquipmentChecklist.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserMgr
@inject IWebHostEnvironment Env
@inject ApplicationDbContext Db
@{
    ApplicationUser? currentUser = null;
    if (SignInManager.IsSignedIn(User))
        currentUser = await UserMgr.GetUserAsync(User);

    var initials = currentUser?.FullName?.Split(' ')
        .Where(w => w.Length > 0).Take(2)
        .Select(w => w[0].ToString().ToUpper())
        .Aggregate("", (a, b) => a + b) ?? "?";

    var isAdmin       = User.IsInRole("Admin");
    var isSupervisor  = User.IsInRole("Supervisor") || isAdmin;
    var isMechanic    = User.IsInRole("Mechanic")   || isAdmin;
    var isOperator    = User.IsInRole("Operator");
    // Phase 3 roles. Admin sees both pipelines so they can monitor the
    // queues without needing a second account.
    var isPlanner     = User.IsInRole("Planner")     || isAdmin;
    var isControlRoom = User.IsInRole("ControlRoom") || isAdmin;
    var path         = Context.Request.Path.Value ?? "";

    // Pending-clearance count for the admin sidebar badge. One indexed
    // COUNT(*) query, cheap to run on every layout render. Skipped for
    // non-admins to save the round-trip.
    var pendingClearances = isAdmin
        ? await Db.Machines.AsNoTracking().CountAsync(m => m.AwaitingAdminClearance)
        : 0;

    // ── Phase 3+4 sidebar badges ──────────────────────────────────────
    // Each lane sees the count for THEIR queue. Admin sees them all so
    // they can monitor at a glance without role-switching. Each query is
    // a single indexed COUNT(*) over the workflow timestamps — cheap.
    // Wrapped in try/catch so a stale schema (column not yet added) on
    // a freshly-pulled dev DB doesn't kill the layout — the badge just
    // doesn't render in that case.
    int plannerPending = 0, controlRoomPending = 0, outboxDeadLetter = 0;
    try
    {
        if (isPlanner)
        {
            plannerPending = await Db.DefectOrders.AsNoTracking()
                .CountAsync(d => d.PlannerCapturedAt == null
                              && d.RepairStatus      != EquipmentChecklist.Models.RepairStatus.Completed);
        }
        if (isControlRoom)
        {
            controlRoomPending = await Db.DefectOrders.AsNoTracking()
                .CountAsync(d => d.PlannerCapturedAt != null
                              && d.DispatchedAt      == null
                              && d.RepairStatus      != EquipmentChecklist.Models.RepairStatus.Completed);
        }
        if (isAdmin)
        {
            // Dead-letter is the only outbox state that needs admin
            // attention — Draft + Sent are healthy / drained.
            outboxDeadLetter = await Db.OutboxMessages.AsNoTracking()
                .CountAsync(m => m.Status == EquipmentChecklist.Models.OutboxStatus.DeadLetter);
        }
    }
    catch { /* schema not migrated yet — badges silently skip */ }
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} – Enaleni" : "Enaleni Equipment Checklist")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⛏</text></svg>" />
    @* Phase 4 · PWA: manifest enables 'Add to home screen' so operators can install the checklist app. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#1f3a93" />
    <style>
        /* Notifications bell + dropdown. Inlined here rather than in
           site.css because the bell is layout-scoped only and changes when
           the layout changes — keeping the styles next to the markup makes
           the relationship discoverable. */
        .notif-wrap { position: relative; margin-right: 10px; }
        .notif-btn  {
            background: var(--steel-mid); border: 1px solid var(--steel-border);
            color: var(--text-primary); font-size: 16px; padding: 6px 10px;
            border-radius: 999px; cursor: pointer; position: relative;
        }
        .notif-btn:hover { border-color: var(--amber); }
        .notif-badge {
            position: absolute; top: -4px; right: -4px;
            background: #ef4444; color: #fff;
            font-size: 10px; font-weight: 700; line-height: 1;
            padding: 2px 5px; border-radius: 999px;
            min-width: 16px; text-align: center;
        }
        .notif-dropdown {
            position: absolute; top: calc(100% + 8px); right: 0;
            width: 360px; max-width: 92vw;
            background: var(--steel-mid); border: 1px solid var(--steel-border);
            border-radius: 10px; box-shadow: 0 8px 30px rgba(0,0,0,.45);
            z-index: 80; overflow: hidden;
        }
        .notif-head {
            display: flex; justify-content: space-between; align-items: center;
            padding: 10px 14px; border-bottom: 1px solid var(--steel-border);
            font-size: 13px;
        }
        .notif-mark {
            background: transparent; border: none; color: var(--amber);
            font-size: 11px; cursor: pointer; padding: 4px 6px;
            border-radius: 4px;
        }
        .notif-mark:hover { background: var(--amber-glow); }
        .notif-list { max-height: 420px; overflow-y: auto; }
        .notif-empty {
            padding: 30px 14px; text-align: center;
            color: var(--text-muted); font-size: 12px;
        }
        .notif-item {
            display: flex; gap: 10px; padding: 10px 14px;
            border-bottom: 1px solid #1a2638; cursor: pointer;
        }
        .notif-item:last-child { border-bottom: none; }
        .notif-item:hover { background: #0d1729; }
        .notif-item.unread { background: rgba(14,148,136,.06); }
        .notif-dot {
            width: 8px; height: 8px; border-radius: 50%;
            flex-shrink: 0; margin-top: 6px;
        }
        .notif-body { flex: 1; min-width: 0; }
        .notif-title { font-size: 13px; font-weight: 600; color: var(--text-primary); }
        .notif-sub   { font-size: 11px; color: var(--text-muted); margin-top: 2px;
                       line-height: 1.5; word-break: break-word; }
        .notif-time  { font-size: 10px; color: #64748b; margin-top: 4px;
                       font-family: var(--font-mono); }

        /* Sidebar count badge — appears on nav items with pending counts
           (Pending Clearance, in future possibly Sign-Off Queue, etc.).
           Amber so it reads as "action needed" without screaming red. */
        .nav-item { position: relative; }
        .nav-item.has-badge { color: #fbbf24; }
        .nav-badge {
            margin-left: auto;
            background: #f59e0b; color: #0a1726;
            font-size: 10px; font-weight: 800;
            padding: 2px 7px; border-radius: 999px;
            min-width: 18px; text-align: center;
        }

        /* ─── Phase 7.2 — Collapsible nav groups ────────────────────────
           Native <details>/<summary> with a styled chevron. Each group
           saves its open/closed state to localStorage keyed by data-group
           so the admin's preference survives navigation. */
        .nav-group { margin: 0; padding: 0; }
        .nav-group summary {
            /* Strip the default disclosure-triangle marker so we can use
               our own chevron — works in every modern browser. */
            list-style: none; cursor: pointer;
            user-select: none;
            display: flex; align-items: center;
            padding: 8px 20px;
            color: var(--text-muted, #94a3b8);
            font-size: 11px; font-weight: 700;
            letter-spacing: .5px; text-transform: uppercase;
            border-radius: 4px;
            transition: background .12s;
        }
        .nav-group summary::-webkit-details-marker { display: none; }
        .nav-group summary > span:first-child { flex: 1; }
        .nav-group summary:hover { background: rgba(255,255,255,.04); color: #cbd5e1; }
        .nav-chevron {
            font-size: 12px; transition: transform .15s ease;
            color: var(--text-faint, #475569);
        }
        .nav-group[open] > summary .nav-chevron { transform: rotate(180deg); }
        /* Items inside a group get a subtle left indent so the visual
           hierarchy is obvious without being noisy. */
        .nav-group .nav-item {
            padding-left: 30px;
            font-size: 13px;
        }
        .nav-group .nav-item .nav-icon {
            margin-right: 8px;
            opacity: .85;
        }
    </style>
</head>
<body>
<div class="app-shell">

    <!-- ── Top Bar ── -->
    <header class="topbar">
        <div class="topbar-brand">
            <div class="brand-icon">⛏</div>
            <div>
                <div class="brand-name">Enaleni</div>
                <div class="brand-sub">Equipment Checklist</div>
            </div>
        </div>

        <div class="topbar-center">
            <span style="font-size:13px;color:var(--text-muted)">
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </span>
        </div>

        <div class="topbar-right">
            <!-- Online/Offline pill -->
            <div class="sync-pill" id="syncStatus">
                <div class="sync-dot"></div>
                Online
            </div>

            <!-- Theme toggle -->
            <button class="theme-toggle" id="themeToggle" title="Toggle light/dark theme">
                <span id="themeIcon">☀️</span>
            </button>

            @if (currentUser != null)
            {
                @if (isOperator)
                {
                    <!-- Queued submissions badge (operators only) -->
                    <button type="button" id="queuedBadge"
                            onclick="if (window.OfflineQueue) OfflineQueue.replayNow();"
                            title="Submissions waiting to sync"
                            style="display:none;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:#451a03;border:1px solid #92400e;color:#fbbf24;font-size:11px;margin-right:8px;cursor:pointer">
                        ☁ <span id="queuedCount">0</span> queued
                    </button>

                    <!-- Offline / voucher status badge (operators only) -->
                    <div id="voucherBadge"
                         title="Offline session status"
                         style="display:none;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:var(--steel-mid);border:1px solid var(--steel-border);font-size:11px;color:var(--text-muted);margin-right:10px;cursor:default">
                        <span id="voucherDot" style="width:8px;height:8px;border-radius:50%;background:#6b7280"></span>
                        <span id="voucherText">…</span>
                    </div>
                }

                <!-- Notifications bell + dropdown.
                     Cookie auth works on /api/sync/notifications via the
                     "multi" auth scheme in Program.cs, so we don't need a
                     parallel /Notifications MVC controller — the JSON API
                     does the work and the markup here just renders it. -->
                <div class="notif-wrap" id="notifWrap">
                    <button type="button" class="notif-btn" id="notifBtn"
                            title="Notifications">
                        🔔
                        <span class="notif-badge" id="notifBadge" style="display:none">0</span>
                    </button>
                    <div class="notif-dropdown" id="notifMenu" style="display:none">
                        <div class="notif-head">
                            <strong>Notifications</strong>
                            <button type="button" class="notif-mark" id="notifMarkAll">Mark all read</button>
                        </div>
                        <div class="notif-list" id="notifList">
                            <div class="notif-empty">Loading…</div>
                        </div>
                    </div>
                </div>

                <!-- User dropdown -->
                <div class="user-dropdown-wrap" id="userDropWrap">
                    <button class="user-chip" id="userDropBtn" type="button">
                        <div class="user-avatar">@initials</div>
                        <div>
                            <div class="user-name">@currentUser.FullName</div>
                            <div class="user-role">@currentUser.Role</div>
                        </div>
                        <span style="margin-left:6px;font-size:11px;color:var(--text-muted)">▾</span>
                    </button>
                    <div class="user-dropdown" id="userDropMenu">
                        <div class="user-drop-header">
                            <div class="user-drop-name">@currentUser.FullName</div>
                            <div class="user-drop-email">@currentUser.Email</div>
                        </div>
                        <a href="/Account/ChangePassword" class="user-drop-item">
                            🔒 Change Password
                        </a>
                        <a href="/Checklist/History" class="user-drop-item">
                            📋 My Submissions
                        </a>
                        <div class="user-drop-divider"></div>
                        <form method="post" action="/Account/Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="user-drop-item user-drop-logout">
                                ↩ Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </header>

    <!-- ── Sidebar ── -->
    <nav class="sidebar">
        @if (SignInManager.IsSignedIn(User))
        {
            <div class="nav-section-label">Main</div>
            <a href="/" class="nav-item @(path == "/" ? "active" : "")">
                <span class="nav-icon">📊</span> Dashboard
            </a>

            @if (isOperator)
            {
                <a href="/Checklist" class="nav-item @(path=="/Checklist"||path.StartsWith("/Checklist/Start")||path.StartsWith("/Checklist/Result") ? "active" : "")">
                    <span class="nav-icon">✅</span> My Machines
                </a>
            }

            @if (isOperator || isSupervisor || isMechanic)
            {
                <a href="/Checklist/History" class="nav-item @(path.StartsWith("/Checklist/History") ? "active" : "")">
                    <span class="nav-icon">📋</span> My Submissions
                </a>
            }

            @if (isOperator)
            {
                <a href="/Security" class="nav-item @(path.StartsWith("/Security")?"active":"")">
                    <span class="nav-icon">🔐</span> Biometric Login
                </a>
            }

            @if (isSupervisor)
            {
                <div class="nav-divider"></div>
                <div class="nav-section-label">Supervisor</div>
                <a href="/Supervisor" class="nav-item @(path=="/Supervisor"?"active":"")">
                    <span class="nav-icon">✍</span> Sign-Off Queue
                </a>
                <a href="/Supervisor/MyOperators" class="nav-item @(path.StartsWith("/Supervisor/MyOperators")?"active":"")">
                    <span class="nav-icon">👷</span> My Operators
                </a>
                <a href="/Supervisor/NoGoMachines" class="nav-item @(path.StartsWith("/Supervisor/NoGo")?"active":"")">
                    <span class="nav-icon">🚫</span> NO-GO Machines
                </a>
            }

            @if (isMechanic)
            {
                <div class="nav-divider"></div>
                @* Label says "Artisan" — internal role name stays "Mechanic" *@
                <div class="nav-section-label">Artisan</div>
                <a href="/Mechanic" class="nav-item @(path=="/Mechanic"?"active":"")">
                    <span class="nav-icon">🔧</span> My Defects
                </a>
                <a href="/Mechanic/MyOperators" class="nav-item @(path.StartsWith("/Mechanic/MyOperators")?"active":"")">
                    <span class="nav-icon">👷</span> My Operators
                </a>
                <a href="/Mechanic/Cart" class="nav-item @(path.StartsWith("/Mechanic/Cart")?"active":"")">
                    <span class="nav-icon">🛒</span> Parts Cart
                </a>
            }

            @* ── Phase 3 — Planner ────────────────────────────────── *@
            @if (isPlanner)
            {
                <div class="nav-divider"></div>
                <div class="nav-section-label">Planner</div>
                <a href="/Planner" class="nav-item @(path.StartsWith("/Planner")?"active":"") @(plannerPending > 0 ? "has-badge" : "")">
                    <span class="nav-icon">📋</span> Defect Capture
                    @if (plannerPending > 0)
                    {
                        <span class="nav-badge">@(plannerPending > 99 ? "99+" : plannerPending.ToString())</span>
                    }
                </a>
            }

            @* ── Phase 3 — Control Room ───────────────────────────── *@
            @if (isControlRoom)
            {
                <div class="nav-divider"></div>
                <div class="nav-section-label">Control Room</div>
                <a href="/ControlRoom" class="nav-item @(path.StartsWith("/ControlRoom")?"active":"") @(controlRoomPending > 0 ? "has-badge" : "")">
                    <span class="nav-icon">🚦</span> Dispatch Queue
                    @if (controlRoomPending > 0)
                    {
                        <span class="nav-badge">@(controlRoomPending > 99 ? "99+" : controlRoomPending.ToString())</span>
                    }
                </a>
            }

            @if (isAdmin)
            {
                @* ── Administration sidebar — reorganised into collapsible groups ──
                   14 admin links was too long; the eye couldn't find anything.
                   New structure:
                     • Daily actions stay always-visible at top (Machines + Pending
                       Clearance with badge + Reports + Audit Trail).
                     • Three collapsible groups for the rest, using native
                       <details>/<summary> so it works with zero JS dependencies.
                     • localStorage remembers which groups the admin opened — a
                       config-heavy admin who lives in Settings + Fleets won't
                       have to re-expand them every page load.
                   The .StartsWith path checks for each group AUTO-OPEN the group
                   when the user is currently on a page inside it, so the active
                   item is always visible regardless of saved state. *@

                var inPeoplePath  = path.StartsWith("/Admin/Employee") || path.StartsWith("/Admin/Admin")
                                 || path.StartsWith("/Admin/CreateAdmin") || path.StartsWith("/Admin/Devices")
                                 || path.StartsWith("/Admin/AddDevice") || path.StartsWith("/Admin/Competencies")
                                 || path.StartsWith("/Admin/OperatorCompetency") || path.StartsWith("/Admin/AddCompetency")
                                 || path.StartsWith("/Admin/Assignment");
                var inConfigPath  = path.StartsWith("/Admin/Settings") || path.StartsWith("/Admin/SaveSetting")
                                 || path.StartsWith("/Admin/Fleets") || path.StartsWith("/Admin/AddFleet")
                                 || path.StartsWith("/Admin/SetFleetActive") || path.StartsWith("/Admin/Upload")
                                 || path.StartsWith("/Admin/IconLibrary")
                                 || path.StartsWith("/Admin/KeyControlSlots") || path.StartsWith("/Admin/ImportKeyControlSlots");
                var inIntegPath   = path.StartsWith("/Admin/Outbox") || path.StartsWith("/Admin/RetryOutbox")
                                 || path.StartsWith("/Admin/PurgeSent") || path.StartsWith("/Admin/Mechanic/Cart");

                <div class="nav-divider"></div>
                <div class="nav-section-label">Administration</div>

                @* Always-visible daily-action items at the top of the section.
                   Pending Clearance carries a badge; Reports + Audit are the
                   manager's daily landing spots. *@
                <a href="/Admin" class="nav-item @(path=="/Admin"?"active":"")">
                    <span class="nav-icon">🚜</span> Machines
                </a>
                <a href="/Admin/PendingClearances"
                   class="nav-item @(path.StartsWith("/Admin/PendingClear")?"active":"") @(pendingClearances > 0 ? "has-badge" : "")"
                   title="Machines awaiting your clearance after repair">
                    <span class="nav-icon">⏳</span> Pending Clearance
                    @if (pendingClearances > 0)
                    {
                        <span class="nav-badge">@pendingClearances</span>
                    }
                </a>
                <a href="/Admin/Reports" class="nav-item @(path.StartsWith("/Admin/Report")?"active":"")">
                    <span class="nav-icon">📈</span> Reports
                </a>
                <a href="/Admin/Audit" class="nav-item @(path.StartsWith("/Admin/Audit")?"active":"")">
                    <span class="nav-icon">📜</span> Audit Trail
                </a>

                @* ── Group: People & Access ─────────────────────────── *@
                <details class="nav-group" data-group="people" @(inPeoplePath ? "open" : "")>
                    <summary class="nav-group-header">
                        <span><span class="nav-icon">👥</span> People &amp; Access</span>
                        <span class="nav-chevron">▾</span>
                    </summary>
                    <a href="/Admin/Employees" class="nav-item @(path.StartsWith("/Admin/Employee")?"active":"")">
                        <span class="nav-icon">👷</span> Employees
                    </a>
                    <a href="/Admin/Admins" class="nav-item @(path.StartsWith("/Admin/Admin") || path.StartsWith("/Admin/CreateAdmin") ? "active" : "")">
                        <span class="nav-icon">🛡</span> Admins
                    </a>
                    <a href="/Admin/Devices" class="nav-item @(path.StartsWith("/Admin/Devices") || path.StartsWith("/Admin/AddDevice") ? "active" : "")">
                        <span class="nav-icon">📱</span> Devices
                    </a>
                    <a href="/Admin/Competencies" class="nav-item @(path.StartsWith("/Admin/Competencies") || path.StartsWith("/Admin/OperatorCompetency") || path.StartsWith("/Admin/AddCompetency") ? "active" : "")">
                        <span class="nav-icon">🎓</span> Competencies
                    </a>
                    <a href="/Admin/Assignments" class="nav-item @(path.StartsWith("/Admin/Assignment")?"active":"")">
                        <span class="nav-icon">🔗</span> Assignments
                    </a>
                </details>

                @* ── Group: Configuration ───────────────────────────── *@
                <details class="nav-group" data-group="config" @(inConfigPath ? "open" : "")>
                    <summary class="nav-group-header">
                        <span><span class="nav-icon">⚙️</span> Configuration</span>
                        <span class="nav-chevron">▾</span>
                    </summary>
                    <a href="/Admin/Settings" class="nav-item @(path.StartsWith("/Admin/Settings") || path.StartsWith("/Admin/SaveSetting") ? "active" : "")">
                        <span class="nav-icon">⚙</span> Settings
                    </a>
                    <a href="/Admin/Fleets" class="nav-item @(path.StartsWith("/Admin/Fleets") || path.StartsWith("/Admin/AddFleet") || path.StartsWith("/Admin/SetFleetActive") ? "active" : "")">
                        <span class="nav-icon">🏗</span> Fleets
                    </a>
                    <a href="/Admin/UploadTemplate" class="nav-item @(path.StartsWith("/Admin/Upload")?"active":"")">
                        <span class="nav-icon">📤</span> Upload Template
                    </a>
                    <a href="/Admin/IconLibrary" class="nav-item @(path.StartsWith("/Admin/IconLibrary")?"active":"")">
                        <span class="nav-icon">🖼️</span> Icon Library
                    </a>
                    <a href="/Admin/KeyControlSlots" class="nav-item @(path.StartsWith("/Admin/KeyControlSlots") || path.StartsWith("/Admin/ImportKeyControlSlots") ? "active" : "")">
                        <span class="nav-icon">🔐</span> Key Control Slots
                    </a>
                </details>

                @* ── Group: Integrations & Workshop ─────────────────── *@
                <details class="nav-group" data-group="integ" @((inIntegPath || outboxDeadLetter > 0) ? "open" : "")>
                    <summary class="nav-group-header">
                        <span><span class="nav-icon">🔌</span> Integrations</span>
                        <span class="nav-chevron">▾</span>
                        @if (outboxDeadLetter > 0)
                        {
                            @* Surface the dead-letter badge on the COLLAPSED group
                               header too — so a closed Integrations group doesn't
                               hide the operational alert. *@
                            <span class="nav-badge" style="background:#ef4444;margin-left:auto;margin-right:6px">
                                @(outboxDeadLetter > 99 ? "99+" : outboxDeadLetter.ToString())
                            </span>
                        }
                    </summary>
                    <a href="/Admin/Outbox" class="nav-item @(path.StartsWith("/Admin/Outbox") || path.StartsWith("/Admin/RetryOutbox") || path.StartsWith("/Admin/PurgeSent") ? "active" : "") @(outboxDeadLetter > 0 ? "has-badge" : "")">
                        <span class="nav-icon">📤</span> SAP Outbox
                        @if (outboxDeadLetter > 0)
                        {
                            <span class="nav-badge" style="background:#ef4444">
                                @(outboxDeadLetter > 99 ? "99+" : outboxDeadLetter.ToString())
                            </span>
                        }
                    </a>
                    <a href="/Admin/Mechanic/Cart" class="nav-item @(path.StartsWith("/Admin/Mechanic/Cart")?"active":"")">
                        <span class="nav-icon">📦</span> Order Parts
                    </a>
                </details>

                @if (Env.IsDevelopment())
                {
                    <a href="/Admin/Debug" class="nav-item @(path.StartsWith("/Admin/Debug")?"active":"")"
                       style="color:#fca5a5">
                        <span class="nav-icon">⚠️</span> Debug · Truncate DB
                    </a>
                }
            }

            <div class="nav-divider"></div>
            <div style="padding:12px 20px">
                <div style="font-size:10px;color:var(--text-faint);line-height:1.7;font-family:var(--font-mono)">
                    MHSA · DMR · CPS L8/9<br/>
                    Enaleni Engineering and Technology<br/>
                    Digital Checklist System
                </div>
            </div>
        }
    </nav>

    <!-- ── Main Content ── -->
    <main class="main-content">
        @if (TempData["Success"] is string ok)  { <div class="alert alert-success" style="margin-bottom:20px">✓ @ok</div> }
        @if (TempData["Error"]   is string err) { <div class="alert alert-danger"  style="margin-bottom:20px">✕ @err</div> }
        @if (TempData["Warning"] is string w)   { <div class="alert alert-warning" style="margin-bottom:20px">⚠ @w</div> }
        @RenderBody()
    </main>
</div>

<script>
// ── Theme toggle ──────────────────────────────────────────
const html       = document.documentElement;
const themeBtn   = document.getElementById('themeToggle');
const themeIcon  = document.getElementById('themeIcon');
const saved      = localStorage.getItem('enaleniTheme') || 'dark';
html.setAttribute('data-theme', saved);
themeIcon.textContent = saved === 'dark' ? '☀️' : '🌙';

themeBtn.addEventListener('click', () => {
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('enaleniTheme', next);
    themeIcon.textContent = next === 'dark' ? '☀️' : '🌙';
});

// ── User dropdown ─────────────────────────────────────────
const dropWrap = document.getElementById('userDropWrap');
const dropBtn  = document.getElementById('userDropBtn');
const dropMenu = document.getElementById('userDropMenu');
if (dropBtn) {
    dropBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropMenu.classList.toggle('open');
    });
    document.addEventListener('click', () => dropMenu?.classList.remove('open'));
}

// ── Notifications bell ────────────────────────────────────
// Polls the API for unread count every 30s, fetches the list when opened.
// The cookie auth on /api/sync/notifications works because the multi
// auth-scheme policy in Program.cs accepts both JWT and cookies. No JS
// SignalR client here — for the web we accept the 30s delay; the bell is
// "good enough for desk-bound supervisors", and avoids dragging the
// SignalR client lib onto every page just for this dropdown.
(function notifInit() {
    const btn   = document.getElementById('notifBtn');
    const menu  = document.getElementById('notifMenu');
    const list  = document.getElementById('notifList');
    const badge = document.getElementById('notifBadge');
    const mark  = document.getElementById('notifMarkAll');
    if (!btn || !menu) return;

    let pollTimer = null;

    async function fetchUnread() {
        try {
            const r = await fetch('/api/sync/notifications/unread-count',
                { credentials: 'same-origin' });
            if (!r.ok) return;
            const n = await r.json();
            // Endpoint may return either a bare number or {count: N}; tolerate both.
            const count = (typeof n === 'number') ? n : (n.count ?? n.Count ?? 0);
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : String(count);
                badge.style.display = '';
            } else {
                badge.style.display = 'none';
            }
        } catch { /* offline — leave existing badge */ }
    }

    async function fetchList() {
        list.innerHTML = '<div class="notif-empty">Loading…</div>';
        try {
            const r = await fetch('/api/sync/notifications?take=30',
                { credentials: 'same-origin' });
            if (!r.ok) {
                list.innerHTML = '<div class="notif-empty">Couldn\'t load notifications.</div>';
                return;
            }
            const items = await r.json();
            if (!Array.isArray(items) || items.length === 0) {
                list.innerHTML = '<div class="notif-empty">You\'re all caught up.</div>';
                return;
            }
            list.innerHTML = items.map(n => renderItem(n)).join('');
            // Wire per-item click to mark-read then navigate (if related).
            list.querySelectorAll('[data-notif-id]').forEach(el => {
                el.addEventListener('click', async () => {
                    const id = el.getAttribute('data-notif-id');
                    try {
                        await fetch(`/api/sync/notifications/${id}/read`,
                            { method: 'POST', credentials: 'same-origin' });
                    } catch { }
                    const sub = el.getAttribute('data-related-sub');
                    if (sub) location.href = `/Checklist/Result/${sub}`;
                    else fetchUnread();
                });
            });
        } catch {
            list.innerHTML = '<div class="notif-empty">Couldn\'t load notifications.</div>';
        }
    }

    function renderItem(n) {
        const id      = n.id ?? n.Id;
        const kind    = (n.kind ?? n.Kind ?? '').toLowerCase();
        const title   = escape(n.title ?? n.Title ?? '');
        const body    = escape(n.body  ?? n.Body  ?? '');
        const at      = new Date(n.createdAt ?? n.CreatedAt);
        const sub     = n.relatedSubmissionId ?? n.RelatedSubmissionId ?? '';
        const isUnread= !(n.readAt ?? n.ReadAt);
        // Per-kind dot colour so conflict.rejected stands out from approvals.
        const dot     = kind.startsWith('conflict')    ? '#ef4444'
                      : kind.startsWith('submission.approved') ? '#22c55e'
                      : kind.startsWith('submission.rejected') ? '#f97316'
                      : kind.startsWith('submission.')         ? '#06b6d4'
                      : kind.startsWith('defect')              ? '#8b5cf6'
                      : '#64748b';
        return `
            <div class="notif-item ${isUnread ? 'unread' : ''}"
                 data-notif-id="${id}"
                 ${sub ? `data-related-sub="${sub}"` : ''}>
                <span class="notif-dot" style="background:${dot}"></span>
                <div class="notif-body">
                    <div class="notif-title">${title}</div>
                    ${body ? `<div class="notif-sub">${body}</div>` : ''}
                    <div class="notif-time">${at.toLocaleString()}</div>
                </div>
            </div>`;
    }

    function escape(s) {
        return String(s).replace(/[&<>"']/g, c =>
            ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
    }

    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const opened = menu.style.display === 'block';
        menu.style.display = opened ? 'none' : 'block';
        if (!opened) fetchList();
    });
    document.addEventListener('click', () => { menu.style.display = 'none'; });
    menu.addEventListener('click', (e) => e.stopPropagation());

    if (mark) {
        mark.addEventListener('click', async () => {
            try {
                await fetch('/api/sync/notifications/read-all',
                    { method: 'POST', credentials: 'same-origin' });
                fetchUnread();
                fetchList();
            } catch { }
        });
    }

    // Initial unread + 30s polling. Visibility-guarded so the tab doesn't
    // burn cellular data in the background.
    fetchUnread();
    pollTimer = setInterval(() => {
        if (!document.hidden) fetchUnread();
    }, 30000);
})();

// ── Online/offline ────────────────────────────────────────
function updateSyncStatus() {
    const pill = document.getElementById('syncStatus');
    if (!pill) return;
    if (navigator.onLine) {
        pill.innerHTML = '<div class="sync-dot"></div> Online';
        pill.style.cssText = '';
    } else {
        pill.innerHTML = '⚡ Offline';
        pill.style.background = 'var(--amber-glow)';
        pill.style.borderColor = 'var(--amber-dark)';
        pill.style.color = 'var(--amber)';
    }
}
window.addEventListener('online',  updateSyncStatus);
window.addEventListener('offline', updateSyncStatus);
updateSyncStatus();
</script>
@await RenderSectionAsync("Scripts", required: false)
<script>
/* ── Table pagination ─────────────────────────────────────────────────────
   Any <table data-paginate="N"> gets automatic client-side paging.
   The pager bar is injected directly after the table element.
──────────────────────────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('table[data-paginate]').forEach(function (table) {
        var pageSize = parseInt(table.getAttribute('data-paginate')) || 5;
        var tbody    = table.querySelector('tbody');
        if (!tbody) return;

        var allRows = Array.from(tbody.querySelectorAll('tr'));
        // Don't paginate if there's only the "empty" placeholder row
        if (allRows.length <= pageSize) return;

        var currentPage = 1;
        var totalPages  = Math.ceil(allRows.length / pageSize);

        /* ── pager bar ── */
        var pager = document.createElement('div');
        pager.style.cssText =
            'display:flex;align-items:center;justify-content:space-between;' +
            'padding:9px 14px;background:var(--steel-dark);' +
            'border-top:1px solid var(--steel-border);font-size:12px;color:var(--text-muted)';

        var infoSpan = document.createElement('span');
        var btnsDiv  = document.createElement('div');
        btnsDiv.style.cssText = 'display:flex;gap:4px;align-items:center';

        pager.appendChild(infoSpan);
        pager.appendChild(btnsDiv);
        table.insertAdjacentElement('afterend', pager);

        function mkBtn(label, page, active, disabled) {
            var b = document.createElement('button');
            b.textContent = label;
            b.disabled    = disabled;
            b.className   = 'btn btn-sm ' + (active ? 'btn-primary' : 'btn-ghost');
            b.style.cssText = 'font-size:11px;padding:3px 9px;min-width:28px';
            b.onclick = function () { if (!disabled) { currentPage = page; render(); } };
            return b;
        }

        function render() {
            var start   = (currentPage - 1) * pageSize;
            var end     = start + pageSize;
            var showing = Math.min(end, allRows.length);

            allRows.forEach(function (row, idx) {
                row.style.display = (idx >= start && idx < end) ? '' : 'none';
            });

            infoSpan.textContent = 'Showing ' + (start + 1) + '–' + showing + ' of ' + allRows.length;

            btnsDiv.innerHTML = '';
            btnsDiv.appendChild(mkBtn('‹ Prev', currentPage - 1, false, currentPage === 1));

            var delta = 1;
            for (var p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages ||
                    (p >= currentPage - delta && p <= currentPage + delta)) {
                    btnsDiv.appendChild(mkBtn(String(p), p, p === currentPage, false));
                } else if (p === currentPage - delta - 1 || p === currentPage + delta + 1) {
                    var dots = document.createElement('span');
                    dots.textContent = '…';
                    dots.style.cssText = 'padding:0 2px;color:var(--text-muted)';
                    btnsDiv.appendChild(dots);
                }
            }

            btnsDiv.appendChild(mkBtn('Next ›', currentPage + 1, false, currentPage === totalPages));
        }

        render();
    });
});
</script>

@if (isOperator)
{
    <!-- Phase 3 · offline voucher status badge + Phase 4 · Service Worker -->
    <script src="~/js/offline-voucher.js"></script>
    <script src="~/js/sw-register.js"></script>
    <script>
    (function () {
        if (!window.OfflineVoucher) return;

        var badge = document.getElementById('voucherBadge');
        var dot   = document.getElementById('voucherDot');
        var text  = document.getElementById('voucherText');
        if (!badge) return;
        badge.style.display = 'inline-flex';

        function paint(rec) {
            var online = navigator.onLine;
            if (!rec) {
                dot.style.background  = '#6b7280';
                text.textContent      = online ? 'No offline session' : 'OFFLINE · no session';
                badge.title           = 'You have no cached session. Sign in online to enable offline use.';
                return;
            }
            var s = OfflineVoucher.secondsLeft(rec.expires_at);
            if (s <= 0) {
                dot.style.background = '#b91c1c';
                text.textContent     = 'Voucher expired';
                badge.title          = 'Connect to refresh your offline session.';
            } else if (online) {
                dot.style.background = '#16a34a';
                text.textContent     = 'Online · ' + OfflineVoucher.formatLeft(rec.expires_at) + ' cached';
                badge.title          = 'You\'re online. ' + OfflineVoucher.formatLeft(rec.expires_at) + ' of offline access cached.';
            } else {
                dot.style.background = s < 60 * 60 ? '#d97706' : '#2563eb';
                text.textContent     = 'OFFLINE · ' + OfflineVoucher.formatLeft(rec.expires_at) + ' left';
                badge.title          = 'You\'re offline. Session expires in ' + OfflineVoucher.formatLeft(rec.expires_at) + '.';
            }
        }

        OfflineVoucher.onChange(paint);
        OfflineVoucher.init().then(function () {
            OfflineVoucher.getStored().then(paint);
        });

        window.addEventListener('online',  function () { OfflineVoucher.getStored().then(paint); });
        window.addEventListener('offline', function () { OfflineVoucher.getStored().then(paint); });
        setInterval(function () { OfflineVoucher.getStored().then(paint); }, 60_000);
    })();
    </script>
}

@* ─── Phase 7.2 — persist nav-group open/closed state ───────────────
   Each <details data-group="X"> auto-saves its open/closed state to
   localStorage under nav-group-X. On page load we restore the saved
   state UNLESS the server-side Razor has force-opened the group via
   the in*Path checks (because the user is currently on a page inside
   that group — active items must stay visible). Safe to inline because
   it's <50 lines and runs only when an admin is logged in. *@
<script>
    (function () {
        var groups = document.querySelectorAll('.nav-group[data-group]');
        if (!groups.length) return;
        groups.forEach(function (g) {
            var key = 'nav-group-' + g.getAttribute('data-group');
            // If Razor force-opened (active-route override), don't clobber
            // it with the cached value — write the current state back so
            // future visits remember.
            if (g.hasAttribute('open')) {
                try { localStorage.setItem(key, '1'); } catch (e) {}
            } else {
                var saved = null;
                try { saved = localStorage.getItem(key); } catch (e) {}
                if (saved === '1') g.setAttribute('open', '');
            }
            g.addEventListener('toggle', function () {
                try { localStorage.setItem(key, g.open ? '1' : '0'); } catch (e) {}
            });
        });
    })();
</script>
