@page "/sign-off"
@using EquipmentChecklist.DTOs
@using EquipmentChecklist.Models
@using EquipmentChecklist.Mobile.Services
@inject ApiClient        Api
@inject AuthService      Auth
@inject ActionQueue      Actions
@inject LocalCache       Cache
@inject NavigationManager Nav
@inject IJSRuntime       JS

<div class="page-head">
    <div>
        <h1>SIGN-OFF QUEUE</h1>
        <p>GO-BUT submissions from your operators awaiting your approval</p>
    </div>
    <button class="ghost" @onclick="LoadAsync" disabled="@busy">↻ Refresh</button>
</div>

@if (busy && queue is null)
{
    <div class="state"><div class="spinner"></div><p>Loading the queue…</p></div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="state err">
        <div class="big">⚠</div>
        <p>@error</p>
        <button class="primary" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (queue is null || queue.Count == 0)
{
    <div class="state">
        <div class="big">✅</div>
        <h2>All clear</h2>
        <p>No submissions are waiting for your sign-off right now.</p>
    </div>
}
else
{
    <p class="count-line">@queue.Count submission(s) waiting</p>

    <div class="queue-list">
        @foreach (var q in PagedRows)
        {
            <div class="q-card">
                <div class="q-head">
                    <div>
                        <div class="machine">
                            <strong>@q.MachineNumber</strong>
                            <span class="muted"> @q.MachineName</span>
                        </div>
                        <div class="op-info">
                            👤 @q.OperatorName
                            <span class="muted">#@q.OperatorEmployeeNumber</span>
                            <span class="dot-sep">·</span>
                            <span class="muted mono">@q.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <span class="badge gobut">GO-BUT 24H</span>
                </div>

                <div class="q-grid">
                    <div class="q-meta">
                        <div class="meta-label">SHIFT</div>
                        <div class="meta-value">@ShiftLabel(q.Shift)</div>
                    </div>
                    <div class="q-meta">
                        <div class="meta-label">KM / HOURS</div>
                        <div class="meta-value mono">@(q.KmOrHourMeter?.ToString() ?? "—")</div>
                    </div>
                    <div class="q-meta">
                        <div class="meta-label">DEFECTS</div>
                        <div class="meta-value defect">@q.DefectCount</div>
                    </div>
                </div>

                <div class="q-actions">
                    <button class="primary" @onclick="() => OpenReview(q)">
                        ✍ Review &amp; sign off
                    </button>
                    <button class="primary success" @onclick="() => OpenQuickApprove(q)">
                        ✓ Quick approve
                    </button>
                    <button class="ghost" @onclick="() => OpenPdf(q)">📄 PDF</button>
                </div>
            </div>
        }
    </div>

    @if (TotalPages > 1)
    {
        <div class="pager">
            <span class="pager-info">
                Showing @FirstRowIndex–@LastRowIndex of @queue.Count
            </span>
            <div class="pager-btns">
                <button class="pg" disabled="@(currentPage == 1)"
                        @onclick="@(() => Goto(currentPage - 1))">‹ Prev</button>

                @foreach (var p in VisiblePages)
                {
                    if (p == -1)
                    {
                        <span class="pg dots">…</span>
                    }
                    else
                    {
                        <button class="pg @(p == currentPage ? "on" : "")"
                                @onclick="@(() => Goto(p))">@p</button>
                    }
                }

                <button class="pg" disabled="@(currentPage == TotalPages)"
                        @onclick="@(() => Goto(currentPage + 1))">Next ›</button>
            </div>
        </div>
    }
}

@* ────────────── QUICK APPROVE MODAL ────────────── *@
@if (qa is not null)
{
    <div class="modal-backdrop" @onclick="CloseQuickApprove">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-head">
                <div>
                    <div class="modal-num">@qa.MachineNumber</div>
                    <div class="modal-sub">@qa.MachineName · @qa.DefectCount defect(s)</div>
                </div>
                <button class="modal-x" @onclick="CloseQuickApprove">✕</button>
            </div>
            <div class="modal-body">
                <p class="qa-hint">
                    Quickly approve this GO-BUT submission. Sign below — your signature is
                    posted to the server and the submission moves out of the queue.
                </p>
                <div class="sig-wrap">
                    <canvas id="@QA_SIG_ID"></canvas>
                </div>
                <button type="button" class="ghost sig-clear" @onclick="ClearQaSig">✕ Clear signature</button>

                @if (!string.IsNullOrEmpty(qaError))
                {
                    <div class="alert">@qaError</div>
                }
            </div>
            <div class="modal-foot">
                <button class="ghost" @onclick="CloseQuickApprove" disabled="@qaBusy">Cancel</button>
                <button class="primary warn" disabled="@qaBusy"
                        @onclick="() => QuickApprove(2)">
                    @(qaBusy ? "…" : "Approve · 24H")
                </button>
                <button class="primary success" disabled="@qaBusy"
                        @onclick="() => QuickApprove(3)">
                    @(qaBusy ? "…" : "Approve · 30D")
                </button>
            </div>
        </div>
    </div>
}

@* Inline PDF viewer — opens via @ref so OpenPdf can call ShowAsync(...) *@
<PdfViewer @ref="pdfView" />

<style>
    .page-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:18px; gap:14px; flex-wrap:wrap; }
    .page-head h1 { font-size:24px; font-weight:800; margin:0; letter-spacing:.5px; }
    .page-head p  { font-size:12px; color:#94a3b8; margin:2px 0 0; }
    .ghost { background:transparent; border:1px solid #243246; color:#cbd5e1; padding:9px 14px; border-radius:8px; cursor:pointer; font-family:inherit; font-size:13px; }
    .ghost:disabled { opacity:.5; cursor:not-allowed; }
    .primary { background:#0e9488; color:#0a1726; border:none; padding:9px 16px; border-radius:8px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; }

    .state { background:#111c2e; border:1px solid #1f2a3a; border-radius:10px; padding:60px 20px; text-align:center; color:#94a3b8; }
    .state.err { color:#fca5a5; }
    .state h2 { color:#e5e7eb; font-size:18px; margin:0 0 6px; }
    .state p  { font-size:13px; max-width:380px; margin:0 0 14px; line-height:1.6; }
    .big { font-size:48px; margin-bottom:12px; }
    .spinner { width:30px; height:30px; border:3px solid #1f2a3a; border-top-color:#0e9488; border-radius:50%; animation:spin .8s linear infinite; margin:0 auto 12px; }
    @@keyframes spin { to { transform:rotate(360deg); } }

    .count-line { font-size:12px; color:#94a3b8; margin:0 0 12px; }

    .queue-list { display:flex; flex-direction:column; gap:12px; }
    .q-card { background:#111c2e; border:1px solid #1f2a3a; border-left:4px solid #06b6d4; border-radius:10px; padding:16px 18px; }
    .q-head { display:flex; justify-content:space-between; align-items:flex-start; gap:14px; flex-wrap:wrap; margin-bottom:14px; }
    .machine { font-size:15px; }
    .machine strong { font-family:ui-monospace,monospace; font-weight:800; }
    .op-info { font-size:12px; color:#cbd5e1; margin-top:4px; }
    .muted   { color:#94a3b8; }
    .mono    { font-family:ui-monospace,monospace; }
    .dot-sep { margin:0 5px; color:#475569; }

    .q-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; padding:12px 14px; background:#0d1729; border:1px solid #1f2a3a; border-radius:8px; margin-bottom:14px; }
    @@media (max-width:540px) { .q-grid { grid-template-columns:1fr 1fr; } }
    .meta-label { font-size:10px; color:#94a3b8; letter-spacing:.5px; font-weight:600; }
    .meta-value { font-size:14px; font-weight:700; margin-top:4px; }
    .meta-value.defect { color:#fca5a5; }

    .q-actions { display:flex; gap:8px; flex-wrap:wrap; }

    .badge { display:inline-block; padding:3px 10px; border-radius:5px; font-size:11px; font-weight:700; letter-spacing:.4px; border:1px solid; }
    .badge.gobut { color:#06b6d4; border-color:#06b6d4; background:rgba(6,182,212,.08); }

    .primary.success { background:#16a34a; color:#fff; }
    .primary.warn    { background:#ea580c; color:#fff; }

    /* Quick-approve modal */
    .modal-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:60; display:flex; align-items:center; justify-content:center; padding:18px; }
    .modal { background:#111c2e; border:1px solid #1f2a3a; border-radius:12px; width:100%; max-width:480px; }
    .modal-head { display:flex; justify-content:space-between; align-items:flex-start; padding:14px 18px; border-bottom:1px solid #1f2a3a; }
    .modal-num { font-size:17px; font-weight:800; font-family:ui-monospace,monospace; }
    .modal-sub { font-size:11px; color:#94a3b8; margin-top:2px; }
    .modal-x { background:transparent; border:none; color:#94a3b8; font-size:18px; cursor:pointer; }
    .modal-body { padding:14px 18px; }
    .qa-hint { font-size:12px; color:#94a3b8; line-height:1.6; margin:0 0 12px; }
    .sig-wrap { position:relative; height:150px; background:#fff; border:2px dashed #243246; border-radius:6px; overflow:hidden; touch-action:none; }
    .sig-wrap canvas { position:absolute; inset:0; width:100%; height:100%; cursor:crosshair; display:block; }
    .sig-clear { margin-top:8px; font-size:11px; padding:5px 12px; }
    .modal-foot { display:flex; justify-content:flex-end; gap:8px; padding:12px 18px; border-top:1px solid #1f2a3a; flex-wrap:wrap; }
    .alert { background:#450a0a; border:1px solid #7f1d1d; color:#fecaca; padding:8px 12px; border-radius:6px; font-size:12px; margin-top:10px; }

    /* ── Pager (mirrors Dashboard / MySubmissions) ────────────────────── */
    .pager       { display:flex; align-items:center; justify-content:space-between;
                   gap:12px; margin-top:14px; padding:12px 16px;
                   background:#0d1729; border:1px solid #1f2a3a; border-radius:10px;
                   flex-wrap:wrap; }
    .pager-info  { font-size:11px; color:#94a3b8; }
    .pager-btns  { display:flex; align-items:center; gap:4px; }
    .pg          { background:transparent; border:1px solid #243246; color:#cbd5e1;
                   padding:5px 10px; border-radius:6px; font-size:12px; cursor:pointer;
                   min-width:32px; font-family:inherit; }
    .pg:hover:not(:disabled):not(.dots) { background:#1a2638; border-color:#0e9488; }
    .pg.on       { background:#0e9488; color:#0a1726; border-color:#0e9488; font-weight:700; }
    .pg:disabled { opacity:.35; cursor:not-allowed; }
    .pg.dots     { border:none; cursor:default; color:#64748b; }
</style>

@code {
    private const string QA_SIG_ID = "qaSig";
    private const int    PAGE_SIZE = 3;

    private List<SupervisorQueueItemDto>? queue;
    private bool   busy        = true;
    private string error       = "";
    private int    currentPage = 1;

    // ── Pager plumbing (mirrors Dashboard + MySubmissions) ──────────────────
    private int TotalPages =>
        queue is null || queue.Count == 0
            ? 1
            : (int)Math.Ceiling(queue.Count / (double)PAGE_SIZE);

    private IEnumerable<SupervisorQueueItemDto> PagedRows =>
        queue is null
            ? Enumerable.Empty<SupervisorQueueItemDto>()
            : queue.Skip((currentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE);

    private int FirstRowIndex =>
        queue is null || queue.Count == 0 ? 0 : (currentPage - 1) * PAGE_SIZE + 1;
    private int LastRowIndex  =>
        queue is null ? 0 : Math.Min(currentPage * PAGE_SIZE, queue.Count);

    /// <summary>
    /// Window-style page list: always show 1 + last + a window of 1 around the
    /// current page, with -1 sentinels rendered as ellipses. Identical to the
    /// helper on MySubmissions so the UX feels consistent across pages.
    /// </summary>
    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (queue is null) yield break;
            var total = TotalPages;
            const int window = 1;
            for (int p = 1; p <= total; p++)
            {
                if (p == 1 || p == total ||
                    (p >= currentPage - window && p <= currentPage + window))
                    yield return p;
                else if (p == currentPage - window - 1 || p == currentPage + window + 1)
                    yield return -1;
            }
        }
    }

    private void Goto(int page)
    {
        if (queue is null) return;
        currentPage = Math.Clamp(page, 1, TotalPages);
    }

    // Quick-approve modal state
    private SupervisorQueueItemDto? qa;
    private bool   qaBusy;
    private string qaError = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", replace:true); return; }

        // Stale-while-revalidate: paint cached rows immediately so the page is
        // usable offline, then refresh from the API in the background and
        // overwrite the cache when the response comes back.
        try
        {
            var email = Auth.CurrentUser?.Email;
            if (!string.IsNullOrEmpty(email))
            {
                var cached = await Cache.GetSupervisorQueueAsync(email);
                if (cached is { Count: > 0 })
                {
                    queue = cached;
                    busy  = false;
                    StateHasChanged();
                }
            }
        }
        catch { /* cache failures should never block the page */ }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (qa is not null)
        {
            try { await JS.InvokeVoidAsync("SigPad.init", QA_SIG_ID); }
            catch { /* canvas not in DOM yet — next render */ }
        }
    }

    private async Task LoadAsync()
    {
        busy = true; error = ""; StateHasChanged();
        try
        {
            var fresh = await Api.SupervisorQueueAsync();
            if (fresh != null)
            {
                queue       = fresh;
                currentPage = 1;   // jump back to the first page on every refresh
                // Refresh the cache so the next offline session sees today's queue.
                try
                {
                    var email = Auth.CurrentUser?.Email;
                    if (!string.IsNullOrEmpty(email))
                        await Cache.SaveSupervisorQueueAsync(email, fresh);
                }
                catch { /* cache write failures are non-fatal */ }
            }
        }
        catch (HttpRequestException)
        {
            // Offline — if we managed to render a cached snapshot in
            // OnInitializedAsync, leave it on screen and just hint at staleness.
            if (queue is null)
                error = "You're offline and have no cached queue yet — connect once to populate it.";
            else
                error = "You're offline. Showing the most recent sign-off queue we cached.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; StateHasChanged(); }
    }

    private void OpenReview(SupervisorQueueItemDto q)
        => Nav.NavigateTo($"/sign-off/review/{q.SubmissionId}");

    private void OpenQuickApprove(SupervisorQueueItemDto q)
    {
        qa      = q;
        qaError = "";
        qaBusy  = false;
    }

    private void CloseQuickApprove()
    {
        qa      = null;
        qaError = "";
    }

    private async Task ClearQaSig() => await JS.InvokeVoidAsync("SigPad.clear", QA_SIG_ID);

    private async Task QuickApprove(int resolution)
    {
        if (qa is null || qaBusy) return;
        qaError = "";

        var sig = await JS.InvokeAsync<string?>("SigPad.toDataUrl", QA_SIG_ID);
        if (string.IsNullOrEmpty(sig))
        {
            qaError = "Sign before approving.";
            return;
        }

        qaBusy = true; StateHasChanged();
        try
        {
            // Offline-aware: queue the action so the operator can keep moving.
            // The queue card stays in the UI (the server hasn't ack'd yet) but
            // the badge in the header reflects the pending action and the
            // SyncWorker replays it the moment signal returns.
            if (Connectivity.NetworkAccess != NetworkAccess.Internet)
            {
                await Actions.EnqueueSignOffAsync(qa.SubmissionId, resolution, sig);
                CloseQuickApprove();
                return;
            }

            var res = await Api.SupervisorSignOffAsync(qa.SubmissionId, resolution, sig);
            if (!res.Ok)
            {
                qaError = string.IsNullOrEmpty(res.Error)
                    ? "Server rejected the sign-off. Try again."
                    : res.Error;
                qaBusy  = false;
                return;
            }
            CloseQuickApprove();
            await LoadAsync();          // refresh the queue
        }
        catch (HttpRequestException)
        {
            // Network died mid-call — queue and close the modal.
            await Actions.EnqueueSignOffAsync(qa.SubmissionId, resolution, sig);
            CloseQuickApprove();
        }
        catch (Exception ex)
        {
            qaError = "Sign-off failed: " + ex.Message;
            qaBusy  = false;
        }
    }

    /// <summary>Reference to the inline PDF modal so we can call ShowAsync on it.</summary>
    private PdfViewer? pdfView;

    private async Task OpenPdf(SupervisorQueueItemDto q)
    {
        if (pdfView is null) return;
        try
        {
            await pdfView.ShowAsync(
                q.SubmissionId,
                title: $"{q.MachineNumber} · {q.MachineName}",
                downloadFileName: $"Checklist_{q.MachineNumber}_{q.SubmissionId}.pdf");
        }
        catch (Exception ex) { error = "Couldn't open PDF: " + ex.Message; }
    }

    private static string ShiftLabel(Shift s) => s switch
    {
        Shift.Day       => "Day (A)",
        Shift.Afternoon => "Afternoon (B)",
        Shift.Night     => "Night (C)",
        _               => "—"
    };
}
