@page "/"
@page "/login"
@layout EquipmentChecklist.Mobile.Components.Layout.MinimalLayout
@using EquipmentChecklist.Mobile.Services
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient                              Api
@inject AuthService                            Auth
@inject BiometricUnlock                        Bio
@inject DeviceFingerprint                      Fingerprint
@inject NavigationManager                      Nav
@inject Microsoft.JSInterop.IJSRuntime         JS

<div class="login-shell">
    <div class="login-card">
        <div class="brand">
            <div class="brand-icon">⛏</div>
            <h1>Equipment Checklist</h1>
            <p>Sign in to start your shift.</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert">@error</div>
        }

        @* Device-not-authorised callout. Shows the operator their
           fingerprint AND a QR code (Phase 5.3) so the admin can scan
           it with their phone or web cam instead of reading hex over
           the radio. Forty-second job per device vs three minutes of
           radio back-and-forth. *@
        @if (deviceProblem && !string.IsNullOrEmpty(localFingerprint))
        {
            <div class="device-block">
                <strong>This device is not authorised.</strong>
                <p>Show this QR code OR the text below to your administrator so they can register your device:</p>
                @* QR canvas. JS renders into it once the page is shown. *@
                <div class="qr-wrap">
                    <canvas id="fpQr" width="180" height="180"></canvas>
                </div>
                <div class="fp-box">@localFingerprint</div>
                <p class="hint">After they've added it, tap Sign In again.</p>
            </div>
        }

        <label>Email</label>
        <input @bind="email" type="email" autocomplete="username"
               placeholder="operator@belfast.co.za" />

        <label>Password</label>
        <input @bind="password" type="password" autocomplete="current-password"
               placeholder="••••••••" @onkeyup="OnPwKey" />

        @if (bioAvailable)
        {
            <label class="bio-toggle">
                <input type="checkbox" @bind="enableBio" />
                <span>🔐 Use biometrics / Windows Hello next time</span>
            </label>
        }

        <button class="primary" @onclick="DoLogin" disabled="@busy">
            @(busy ? "Signing in…" : "Sign In")
        </button>

        @* Explicit "Sign in with biometric" button — visible whenever the
           device supports biometric AND a returning user previously opted
           in. Tapping it re-runs Auth.RestoreAsync, which fires the OS
           prompt. Previously biometric ONLY fired automatically on page
           load, so users who landed on the login screen via any other
           path (sign-out, deactivation, restart) had no way to invoke it
           manually. This button removes that dead-end. *@
        @if (bioAvailable && hasBiometricSession)
        {
            <button class="bio-button" @onclick="TriggerBiometricAsync" disabled="@busy">
                🔐 Sign in with biometric
            </button>
            <p class="hint" style="margin-top:6px">
                We'll re-confirm with @(cachedDisplayName ?? "your saved account").
            </p>
        }

        <p class="hint">
            Use the same email and password you use for the web app.
        </p>
        @* Phase 5.2 — server URL setup link. Tap once on first install
           to point the device at the right API; never need to touch
           again unless the server moves. *@
        <p class="hint" style="margin-top:18px">
            <a href="/setup" style="color:#64748b;text-decoration:none">⚙ Server URL settings</a>
        </p>
    </div>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0b1726;
        padding: 24px;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    .login-card {
        background: #111c2e;
        color: #e5e7eb;
        border: 1px solid #1f2a3a;
        border-radius: 14px;
        padding: 36px 28px;
        width: 100%;
        max-width: 380px;
    }
    .brand        { text-align: center; margin-bottom: 24px; }
    .brand-icon   {
        width: 56px; height: 56px;
        margin: 0 auto 10px;
        background: #1f3a93;
        color: #fff;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px;
    }
    .brand h1     { font-size: 18px; margin: 0; }
    .brand p      { font-size: 12px; color: #94a3b8; margin: 4px 0 0; }

    label         { display: block; font-size: 11px; color: #94a3b8; margin: 10px 0 6px; text-transform: uppercase; letter-spacing: .4px; }
    input         {
        width: 100%; box-sizing: border-box;
        padding: 11px 12px;
        background: #0b1726;
        border: 1px solid #243246;
        color: #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
    }
    button.primary {
        margin-top: 18px;
        width: 100%;
        padding: 12px;
        background: #1f3a93;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }
    button.primary:disabled { opacity: .55; cursor: not-allowed; }

    button.bio-button {
        margin-top: 10px;
        width: 100%;
        padding: 11px;
        background: transparent;
        color: #fbbf24;
        border: 1px solid #b45309;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }
    button.bio-button:disabled { opacity: .55; cursor: not-allowed; }

    .alert {
        background: #450a0a; border: 1px solid #7f1d1d;
        color: #fecaca; padding: 10px 12px;
        border-radius: 6px; font-size: 13px;
        margin-bottom: 12px;
    }
    .hint {
        font-size: 11px; color: #64748b; text-align: center; margin-top: 16px;
    }
    .device-block {
        background: #451a03; border: 1px solid #92400e;
        color: #fde68a; padding: 14px;
        border-radius: 8px; font-size: 13px;
        margin-bottom: 14px;
    }
    .device-block strong { display:block; font-size:14px; color:#fef3c7; margin-bottom:6px; }
    .device-block p     { margin: 4px 0; line-height: 1.5; }
    .device-block .hint { color:#fbbf24; text-align:left; margin-top:8px; }
    .fp-box {
        font-family: ui-monospace, monospace;
        background: #0a1726; color: #fbbf24;
        padding: 10px 12px; border-radius: 6px;
        font-size: 12px; word-break: break-all;
        border: 1px dashed #f59e0b; margin: 6px 0;
        letter-spacing: .5px;
    }
    .qr-wrap {
        background: #ffffff; padding: 10px; border-radius: 8px;
        display: inline-block; margin: 8px 0; width: auto;
    }
    .qr-wrap canvas { display: block; }

    .bio-toggle {
        display:flex; align-items:center; gap:8px; cursor:pointer;
        margin:14px 0 0; font-size:12px; color:#94a3b8;
        text-transform:none; letter-spacing:0;
    }
    .bio-toggle input { width:16px; height:16px; accent-color:#1f3a93; }
</style>

@code {
    private string email        = "";
    private string password     = "";
    private bool   busy;
    private string error        = "";
    private bool   enableBio    = false;
    private bool   bioAvailable = false;

    // Surfaces the "Sign in with biometric" button. True when the device
    // has biometric hardware AND the user previously opted in AND there's
    // a cached session that biometric can unlock. If any of those is
    // false, the button stays hidden and the user falls through to the
    // password form below it.
    private bool   hasBiometricSession;
    private string? cachedDisplayName;

    // Device-allowlist state. deviceProblem flips on when the server
    // returns any device_* error code; localFingerprint is resolved
    // eagerly so it's already on screen when the user opens the page —
    // they can hand it over to the admin without retrying first.
    private bool   deviceProblem;
    private string localFingerprint = "";

    protected override async Task OnInitializedAsync()
    {
        bioAvailable = await Bio.IsAvailableAsync();
        if (bioAvailable && await Auth.IsBiometricEnabledAsync())
            enableBio = true;  // pre-tick the box for returning users

        // Decide whether the explicit "Sign in with biometric" button
        // should appear. It's only meaningful when there's a cached
        // session for biometric to unlock — otherwise the prompt would
        // succeed and immediately fail because there's no token to use.
        await RefreshBiometricSessionStateAsync();

        var restore = await Auth.RestoreAsync();
        switch (restore)
        {
            case RestoreResult.Unlocked:
                Nav.NavigateTo("/dashboard");
                break;

            case RestoreResult.BiometricCancelled:
                error = "Biometric prompt was dismissed. Tap '🔐 Sign in with biometric' to retry, or use your password.";
                break;

            case RestoreResult.BiometricFailed:
                error = "Biometric check failed too many times. Sign in with your password.";
                break;

            // NoSession / Expired / Corrupt → no message, just show the form.
        }
    }

    /// <summary>
    /// Looks at SecureStorage to decide whether the biometric button is
    /// worth showing — true only when biometric is enabled AND there's a
    /// cached user record for the prompt to unlock. The composite check
    /// lives on AuthService so it can auto-heal a stale BIO_KEY (set, but
    /// without a session) by silently clearing the flag.
    /// </summary>
    private async Task RefreshBiometricSessionStateAsync()
    {
        if (!bioAvailable) { hasBiometricSession = false; return; }

        hasBiometricSession = await Auth.HasBiometricUnlockableSessionAsync();
        if (!hasBiometricSession) { cachedDisplayName = null; return; }

        // The full name of the cached user, surfaced on the hint line so
        // the operator knows which account the biometric prompt will
        // unlock — shared devices are common in the cab so this matters.
        cachedDisplayName = Auth.CurrentUser?.FullName;
    }

    /// <summary>
    /// Click handler for the explicit "Sign in with biometric" button.
    /// Re-runs Auth.RestoreAsync, which fires the OS prompt and navigates
    /// to the dashboard on success. Used when the auto-fire on page load
    /// didn't happen (cancelled, dismissed) or when the user has just
    /// signed out and wants back in without re-typing a password.
    /// </summary>
    /// <summary>
    /// Phase 5.3 — render the device fingerprint as a QR code into the
    /// #fpQr canvas. Loads qrcode-generator from a CDN on first use (the
    /// library is ~3KB and unchanged for years). Re-renders on every
    /// after-render pass while deviceProblem is true so the QR updates
    /// if the fingerprint changes (rare but possible if the admin
    /// re-issues a device).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (deviceProblem && !string.IsNullOrEmpty(localFingerprint))
        {
            try
            {
                // Inline JS — first call injects the library tag if not
                // already loaded, then renders. Idempotent on re-renders.
                await JS.InvokeVoidAsync("eval", QR_INLINE_JS, localFingerprint);
            }
            catch
            {
                // QR is a convenience, not critical — the hex string is
                // still on screen. Swallow rather than disrupt sign-in.
            }
        }
    }

    /// <summary>Minified inline JS that draws a QR code into #fpQr using
    /// the qrcode-generator CDN library. The library is fetched once and
    /// cached on window so subsequent calls are instant.</summary>
    private const string QR_INLINE_JS = @"
(function(text){
    var draw = function(){
        var c = document.getElementById('fpQr');
        if (!c || !window.qrcode) return;
        var qr = window.qrcode(0, 'M');
        qr.addData(text);
        qr.make();
        var size  = c.width;
        var count = qr.getModuleCount();
        var px    = Math.max(1, Math.floor(size / count));
        var ctx   = c.getContext('2d');
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, size, size);
        ctx.fillStyle = '#000000';
        for (var r = 0; r < count; r++)
            for (var col = 0; col < count; col++)
                if (qr.isDark(r, col))
                    ctx.fillRect(col * px, r * px, px, px);
    };
    if (window.qrcode) { draw(); return; }
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js';
    s.onload = draw;
    document.head.appendChild(s);
})(arguments[0]);";

    private async Task TriggerBiometricAsync()
    {
        if (busy) return;
        busy = true;
        error = "";
        try
        {
            var restore = await Auth.RestoreAsync();
            switch (restore)
            {
                case RestoreResult.Unlocked:
                    Nav.NavigateTo("/dashboard");
                    return;

                case RestoreResult.BiometricCancelled:
                    error = "Biometric prompt was dismissed.";
                    return;

                case RestoreResult.BiometricFailed:
                    error = "Biometric check failed. Sign in with your password.";
                    // BiometricFailed signs the user out internally, so
                    // hide the button on the next render — there's no
                    // cached session left to unlock.
                    hasBiometricSession = false;
                    return;

                case RestoreResult.NoSession:
                case RestoreResult.Expired:
                case RestoreResult.Corrupt:
                    error = "No saved session on this device. Sign in with your password to re-enable biometric.";
                    hasBiometricSession = false;
                    return;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void OnPwKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = DoLogin();
    }

    private async Task DoLogin()
    {
        if (busy) return;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Email and password are required.";
            return;
        }

        busy = true;
        error = "";
        try
        {
            var result = await Api.LoginAsync(email.Trim(), password);

            if (result.IsDeactivated)
            {
                // Admin has blocked this user. The ApiClient already
                // called AuthService.HandleRemoteDeactivationAsync, which
                // flipped the cached IsBlocked flag — so a follow-up
                // offline-sign-in attempt with these same credentials
                // would also fail.
                error = result.ErrorMessage
                    ?? "Your account has been deactivated. Contact your administrator.";
                return;
            }

            if (result.IsDeviceProblem)
            {
                // Server refused the device. Show the fingerprint
                // (preferring the one the server echoed back) so the
                // operator can give it to their admin to register.
                deviceProblem    = true;
                localFingerprint = !string.IsNullOrEmpty(result.DeviceFingerprint)
                                        ? result.DeviceFingerprint!
                                        : await Fingerprint.GetAsync();
                error            = result.ErrorMessage ?? "This device isn't authorised.";
                return;
            }

            if (!result.Succeeded)
            {
                error = "Invalid email or password.";
                return;
            }

            await Auth.SignInAsync(result.Response!, password,
                                   enableBiometrics: enableBio && bioAvailable);
            Nav.NavigateTo("/dashboard");
        }
        catch (HttpRequestException)
        {
            // Server unreachable — try offline sign-in against the cached
            // profile. Works after the operator has signed in successfully
            // here once with internet.
            var offline = await Auth.OfflineSignInAsync(email.Trim(), password);
            switch (offline)
            {
                case OfflineSignInResult.Success:
                    Nav.NavigateTo("/dashboard");
                    return;

                case OfflineSignInResult.UserUnknown:
                    error = "You're offline and we don't have a cached profile for this email. " +
                            "Sign in once with internet first.";
                    return;

                case OfflineSignInResult.WrongPassword:
                    error = "Invalid email or password.";
                    return;

                case OfflineSignInResult.BlockedByAdmin:
                    // The cached user was flagged blocked by the server on
                    // a previous online interaction. Until the operator
                    // reconnects AND an admin reactivates them, offline
                    // sign-in stays refused.
                    error = "Your account has been deactivated. Contact your administrator.";
                    return;
            }
        }
        catch (Exception ex)
        {
            error = "Login failed: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
