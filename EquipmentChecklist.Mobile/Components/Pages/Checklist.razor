@page "/checklist/{MachineId:int}"
@using EquipmentChecklist.DTOs
@using EquipmentChecklist.Models
@using EquipmentChecklist.Mobile.Services
@using Plugin.Maui.Audio
@inject ApiClient        Api
@inject AuthService      Auth
@inject LocalCache       Cache
@inject SubmissionQueue  Queue
@inject SyncWorker       Sync
@inject ApiHealth        Health
@inject LocalPdfService  LocalPdf
@inject IAudioManager    AudioMgr
@inject NavigationManager Nav
@inject IJSRuntime       JS

<div class="chk-shell">

    @* ────────────── TOP BAR ────────────── *@
    <header class="topbar">
        <button class="back" @onclick="Back">‹ Back</button>
        <div class="title-block">
            <h1>@(machineLabel?.ToUpper() ?? template?.Name?.ToUpper() ?? "CHECKLIST")</h1>
            <p>@machineSubtitle</p>
        </div>
        @if (CriticalDefects > 0)
        {
            <div class="crit-badge">✕ NO-GO · @CriticalDefects CRITICAL</div>
        }
        else if (template is not null)
        {
            <div class="crit-badge subtle">@items.Count items</div>
        }
    </header>

    @if (busy && template is null)
    {
        <div class="state"><div class="spinner"></div><p>Loading checklist…</p></div>
    }
    else if (template is null)
    {
        <div class="state err">
            <div class="big">⚠</div>
            <h2>Couldn't load this checklist</h2>
            <p>@(string.IsNullOrEmpty(error) ? "Try again from My Machines." : error)</p>
            <button class="primary" @onclick="Back">Back to machines</button>
        </div>
    }
    else
    {
        @* ────────────── HEADER FIELDS ────────────── *@
        <section class="meta">
            <div class="meta-field">
                <label>SHIFT <span class="req">*</span></label>
                <select @bind="form.Shift">
                    <option value="@Shift.Day">Day</option>
                    <option value="@Shift.Afternoon">Afternoon</option>
                    <option value="@Shift.Night">Night</option>
                </select>
            </div>
            <div class="meta-field">
                <label>KM / HOUR METER <span class="req">*</span></label>
                <input type="number" inputmode="numeric" @bind="form.KmOrHourMeter"
                       placeholder="Current reading" />
            </div>
            <div class="meta-field">
                <label>DATE &amp; TIME</label>
                <input type="text" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm")" readonly />
            </div>
        </section>

        @* ────────────── ITEM GRID HEADER ────────────── *@
        <div class="items-head">
            <div class="items-title">
                <span class="ico">📋</span>
                <span>INSPECTION ITEMS</span>
                <span class="count">(@items.Count items)</span>
            </div>
            <div class="legend">⚠ Red border = critical NO-GO item</div>
        </div>

        @* Column-header strip *@
        <div class="grid-head">
            <div class="ghcol">
                <span class="lbl">ITEM</span>
                <span class="lbl ok-col">IN ORDER</span>
                <span class="lbl def-col">DEFECT</span>
            </div>
            <div class="ghcol">
                <span class="lbl">ITEM</span>
                <span class="lbl ok-col">IN ORDER</span>
                <span class="lbl def-col">DEFECT</span>
            </div>
        </div>

        @* ────────────── ITEM GRID ────────────── *@
        <div class="grid">
            @foreach (var item in items)
            {
                var t = item.Template;
                var ok  = item.Status == ItemStatus.InOrder;
                var def = item.Status == ItemStatus.Defect;

                <div class="item @(t.IsNoGoItem ? "critical" : "") @(def ? "is-def" : "")">
                    <div class="ico-cell @IconColorClass(t)">
                        @if (!string.IsNullOrEmpty(t.IconPath))
                        {
                            <img src="@IconUrl(t.IconPath)" alt=""
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                        }
                        <span class="ico-letter" style="@(string.IsNullOrEmpty(t.IconPath) ? "display:flex" : "display:none")">
                            @FirstChar(t.ItemName)
                        </span>
                    </div>

                    <div class="name-cell">
                        <div class="name">@t.ItemName</div>
                        @if (t.IsNoGoItem)
                        {
                            <div class="tag-nogo">NO-GO</div>
                        }
                    </div>

                    <button class="radio ok @(ok ? "on" : "")" type="button"
                            @onclick="() => SetStatus(item, ItemStatus.InOrder)">
                        <span class="ring"></span>
                        <span class="mark">✓</span>
                    </button>
                    <button class="radio def @(def ? "on" : "")" type="button"
                            @onclick="() => SetStatus(item, ItemStatus.Defect)">
                        <span class="ring"></span>
                        <span class="mark">✕</span>
                    </button>

                    @if (def)
                    {
                        <div class="defect-note">
                            <span class="pencil">✎</span>
                            <input type="text" @bind="item.Notes" placeholder="Describe the defect…" />

                            @* Camera button — captures a photo of the defect.
                               Stamps onto item.PhotoBase64 + PhotoMimeType so
                               the submit pipeline ships them with the row. *@
                            <button type="button" class="cam-btn @(item.HasPhoto ? "on" : "")"
                                    title="@(item.HasPhoto ? "Replace photo" : "Take a photo")"
                                    @onclick="() => CapturePhotoAsync(item)">
                                @(item.HasPhoto ? "📷✓" : "📷")
                            </button>

                            @* Voice memo button — record / stop / replace.
                               State machine on item.AudioState drives the
                               icon + tooltip; busy state disables it. *@
                            <button type="button"
                                    class="mic-btn @(item.IsRecording ? "rec" : (item.HasAudio ? "on" : ""))"
                                    disabled="@audioBusy"
                                    title="@AudioTooltip(item)"
                                    @onclick="() => ToggleRecordingAsync(item)">
                                @(item.IsRecording ? "⏺" : (item.HasAudio ? "🎤✓" : "🎤"))
                            </button>
                        </div>

                        @if (item.HasPhoto)
                        {
                            <div class="defect-photo">
                                <img src="@item.PhotoDataUrl" alt="defect photo" />
                                <button type="button" class="photo-x" title="Remove photo"
                                        @onclick="() => RemovePhoto(item)">✕</button>
                            </div>
                        }

                        @if (item.HasAudio)
                        {
                            <div class="defect-audio">
                                <audio controls src="@item.AudioDataUrl"></audio>
                                <button type="button" class="audio-x" title="Remove voice memo"
                                        @onclick="() => RemoveAudio(item)">✕</button>
                            </div>
                        }
                        else if (item.IsRecording)
                        {
                            <div class="defect-audio recording">
                                <span class="rec-dot"></span>
                                <span class="rec-label">Recording… tap 🎤 again to stop</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* ────────────── FITNESS DECLARATION ────────────── *@
        <section class="card">
            <h3>Fitness declaration</h3>
            <p class="quote">
                "I am healthy, in good physical condition and mental state, well rested
                and do not feel fatigued in order to operate this equipment."
            </p>
            <label class="check">
                <input type="checkbox" @bind="form.FitnessDeclarationSigned" />
                <span>I confirm the above declaration.</span>
            </label>
        </section>

        @* ────────────── REMARKS ────────────── *@
        <section class="card">
            <h3>Remarks (optional)</h3>
            <textarea rows="2" @bind="form.OperatorRemarks"
                      placeholder="Anything else worth noting…"></textarea>
        </section>

        @* ────────────── SIGNATURE ────────────── *@
        <section class="card">
            <h3>Operator signature
                <button class="sig-clear" type="button" @onclick="ClearSig">✕ Clear</button>
            </h3>
            <div class="sig-wrap">
                <canvas id="@SIG_ID"></canvas>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert">@error</div>
        }

        <div class="submit-bar">
            <button class="primary submit" @onclick="DoSubmit" disabled="@submitting">
                @(submitting ? "Submitting…" : "Submit checklist")
            </button>
        </div>
    }

</div>

@* ────────────── SUBMIT PROGRESS OVERLAY ────────────── *@
@if (submitting)
{
    <div class="submit-overlay">
        <div class="submit-card">
            <div class="submit-spinner"></div>
            <h2>@submitTitle</h2>
            <p class="submit-step">@submitStep</p>
            @if (submitStages is { Count: > 0 })
            {
                <ul class="submit-stages">
                    @foreach (var s in submitStages)
                    {
                        <li class="@s.Cls">
                            <span class="bullet">@s.Glyph</span>
                            <span class="label">@s.Label</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

<style>
    .chk-shell { min-height:100vh; background:#0b1726; color:#e5e7eb; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; padding:18px 22px 30px; }

    /* Top bar */
    .topbar { display:flex; align-items:flex-start; gap:14px; margin-bottom:18px; }
    .back { background:transparent; border:1px solid #243246; color:#cbd5e1; padding:6px 12px; border-radius:8px; font-size:13px; cursor:pointer; font-family:inherit; }
    .title-block { flex:1; }
    .title-block h1 { font-size:24px; font-weight:800; margin:0; letter-spacing:.5px; }
    .title-block p  { font-size:12px; color:#94a3b8; margin:2px 0 0; }
    .crit-badge { background:rgba(127,29,29,.25); border:1px solid #b91c1c; color:#fca5a5; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:700; letter-spacing:.4px; white-space:nowrap; }
    .crit-badge.subtle { background:#111c2e; border-color:#1f2a3a; color:#94a3b8; font-weight:600; }

    /* Loading / error states */
    .state { background:#111c2e; border:1px solid #1f2a3a; border-radius:10px; padding:60px 20px; text-align:center; color:#94a3b8; }
    .state.err { color:#fca5a5; }
    .state h2 { color:#e5e7eb; font-size:18px; margin:0 0 8px; }
    .state p  { font-size:13px; max-width:340px; margin:0 0 14px; line-height:1.6; }
    .big { font-size:48px; margin-bottom:12px; }
    .spinner { width:30px; height:30px; border:3px solid #1f2a3a; border-top-color:#0e9488; border-radius:50%; animation:spin .8s linear infinite; margin:0 auto 12px; }
    @@keyframes spin { to { transform:rotate(360deg); } }

    /* Meta row */
    .meta { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:18px; }
    @@media (max-width:760px) { .meta { grid-template-columns:1fr; } }
    .meta-field label { display:block; font-size:10px; color:#94a3b8; text-transform:uppercase; letter-spacing:.8px; margin-bottom:6px; font-weight:600; }
    .meta-field .req { color:#ef4444; }
    .meta-field select, .meta-field input {
        width:100%; box-sizing:border-box;
        background:#0d1729; border:1px solid #1f2a3a; color:#e5e7eb;
        padding:11px 14px; border-radius:8px; font-size:14px; font-family:inherit;
    }
    .meta-field select:focus, .meta-field input:focus { outline:none; border-color:#0e9488; }
    .meta-field input[readonly] { color:#94a3b8; background:#0a1322; }

    /* Items header bar */
    .items-head { display:flex; justify-content:space-between; align-items:center; padding:11px 14px; background:#0d1729; border:1px solid #1f2a3a; border-radius:8px 8px 0 0; }
    .items-title { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; letter-spacing:.4px; }
    .items-title .ico { font-size:16px; }
    .items-title .count { font-weight:400; color:#94a3b8; font-size:12px; }
    .legend { font-size:11px; color:#ef4444; }

    .grid-head { display:grid; grid-template-columns:1fr 1fr; gap:0; background:#0d1729; border-left:1px solid #1f2a3a; border-right:1px solid #1f2a3a; }
    @@media (max-width:760px) { .grid-head { grid-template-columns:1fr; } }
    .ghcol { display:grid; grid-template-columns: 38px 1fr 60px 60px; gap:8px; padding:8px 14px; align-items:center; }
    .ghcol + .ghcol { border-left:1px solid #1f2a3a; }
    .ghcol .lbl { font-size:10px; color:#94a3b8; letter-spacing:.5px; font-weight:600; }
    .ghcol .lbl:first-of-type { grid-column:2; }
    .ghcol .ok-col, .ghcol .def-col { text-align:center; }
    .ghcol .ok-col  { color:#22c55e; }
    .ghcol .def-col { color:#ef4444; }

    /* Grid */
    .grid { display:grid; grid-template-columns:1fr 1fr; gap:0; background:#0d1729; border:1px solid #1f2a3a; border-top:none; border-radius:0 0 8px 8px; margin-bottom:18px; }
    @@media (max-width:760px) { .grid { grid-template-columns:1fr; } }

    .item { display:grid; grid-template-columns: 38px 1fr 60px 60px; gap:8px; padding:10px 14px; border-bottom:1px solid #1a2638; align-items:center; position:relative; }
    .item:nth-child(2n) { border-left:1px solid #1f2a3a; }
    @@media (max-width:760px) { .item:nth-child(2n) { border-left:none; } }
    .item.critical::before { content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:#ef4444; }
    .item.critical { padding-left:18px; }

    .ico-cell { width:32px; height:32px; border-radius:6px; display:flex; align-items:center; justify-content:center; flex-shrink:0; background:rgba(255,255,255,.04); }
    .ico-cell img { max-width:24px; max-height:24px; object-fit:contain; }
    .ico-letter { font-size:13px; font-weight:700; color:#fff; }
    .ico-cell.red    { background:rgba(239,68,68,.18); }
    .ico-cell.orange { background:rgba(249,115,22,.18); }
    .ico-cell.amber  { background:rgba(245,158,11,.18); }
    .ico-cell.green  { background:rgba(34,197,94,.18); }
    .ico-cell.cyan   { background:rgba(6,182,212,.18); }

    .name-cell { min-width:0; }
    .name { font-size:13px; font-weight:600; color:#e5e7eb; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .tag-nogo { font-size:9px; color:#fca5a5; background:rgba(239,68,68,.15); padding:1px 6px; border-radius:3px; display:inline-block; margin-top:2px; font-weight:700; letter-spacing:.4px; }

    /* Radio toggles */
    .radio { background:transparent; border:none; cursor:pointer; padding:0; display:flex; align-items:center; justify-content:center; position:relative; height:32px; width:60px; }
    .radio .ring { width:22px; height:22px; border-radius:50%; border:2px solid; display:block; box-sizing:border-box; }
    .radio.ok  .ring { border-color:#166534; }
    .radio.def .ring { border-color:#7f1d1d; }
    .radio .mark { position:absolute; font-size:13px; font-weight:700; opacity:0; transition:opacity .1s; }
    .radio.ok  .mark { color:#22c55e; }
    .radio.def .mark { color:#ef4444; }
    .radio.on  .ring { background:rgba(255,255,255,.04); border-width:2.5px; }
    .radio.ok.on  .ring { background:rgba(34,197,94,.18); border-color:#22c55e; }
    .radio.def.on .ring { background:rgba(239,68,68,.18); border-color:#ef4444; }
    .radio.on  .mark { opacity:1; }
    .radio:hover:not(.on) .ring { background:rgba(255,255,255,.05); }

    /* Defect note input under the row */
    .defect-note { grid-column:1/-1; margin-top:6px; display:flex; align-items:center; gap:6px; background:#0a1322; border:1px solid #243246; border-radius:6px; padding:6px 10px; }
    .defect-note .pencil { color:#94a3b8; font-size:13px; }
    .defect-note input { flex:1; background:transparent; border:none; color:#e5e7eb; padding:4px 0; font-size:12px; font-family:inherit; }
    .defect-note input:focus { outline:none; }

    /* Per-defect camera button + photo preview */
    .cam-btn  { background:transparent; border:1px solid #243246; color:#cbd5e1;
                padding:4px 9px; border-radius:6px; font-size:13px; cursor:pointer;
                font-family:inherit; flex-shrink:0; min-width:44px; }
    .cam-btn:hover { background:#111c2e; border-color:#0e9488; }
    .cam-btn.on { color:#86efac; border-color:#166534; background:rgba(34,197,94,.08); }

    .defect-photo { grid-column:1/-1; margin-top:6px; position:relative;
                    display:inline-block; max-width:160px; }
    .defect-photo img { width:100%; max-height:120px; object-fit:cover;
                        border-radius:6px; border:1px solid #243246; display:block; }
    .photo-x  { position:absolute; top:4px; right:4px; width:22px; height:22px;
                border-radius:50%; background:rgba(2,6,23,.75); color:#fff;
                border:none; cursor:pointer; font-size:11px; line-height:1;
                display:flex; align-items:center; justify-content:center;
                font-family:inherit; }
    .photo-x:hover { background:#dc2626; }

    /* Voice-memo button (same chrome as camera, with red pulsing variant
       while recording so the operator can't lose track of the state). */
    .mic-btn  { background:transparent; border:1px solid #243246; color:#cbd5e1;
                padding:4px 9px; border-radius:6px; font-size:13px; cursor:pointer;
                font-family:inherit; flex-shrink:0; min-width:44px; }
    .mic-btn:hover:not(:disabled) { background:#111c2e; border-color:#0e9488; }
    .mic-btn:disabled { opacity:.5; cursor:not-allowed; }
    .mic-btn.on  { color:#86efac; border-color:#166534; background:rgba(34,197,94,.08); }
    .mic-btn.rec { color:#fff; border-color:#dc2626; background:#dc2626;
                   animation:mic-pulse 1.1s ease-in-out infinite; }
    @@keyframes mic-pulse {
        0%, 100% { box-shadow:0 0 0 0 rgba(220,38,38,.7); }
        50%      { box-shadow:0 0 0 6px rgba(220,38,38,0); }
    }

    /* Inline audio player + "recording…" pill */
    .defect-audio { grid-column:1/-1; margin-top:6px; display:flex; align-items:center;
                    gap:8px; position:relative; }
    .defect-audio audio { flex:1; max-width:280px; height:34px; }
    .audio-x  { width:22px; height:22px; border-radius:50%; background:#1a2638;
                color:#cbd5e1; border:1px solid #243246; cursor:pointer;
                font-size:11px; line-height:1; display:flex; align-items:center;
                justify-content:center; font-family:inherit; flex-shrink:0; }
    .audio-x:hover { background:#dc2626; color:#fff; border-color:#dc2626; }

    .defect-audio.recording { background:rgba(220,38,38,.08); border:1px solid #7f1d1d;
                              border-radius:6px; padding:6px 10px; }
    .rec-dot   { display:inline-block; width:8px; height:8px; border-radius:50%;
                 background:#dc2626; animation:rec-blink 1s ease-in-out infinite; }
    @@keyframes rec-blink { 50% { opacity:.25; } }
    .rec-label { font-size:12px; color:#fca5a5; }

    /* Cards below */
    .card { background:#0d1729; border:1px solid #1f2a3a; border-radius:8px; padding:14px 16px; margin-bottom:14px; }
    .card h3 { margin:0 0 12px; font-size:13px; font-weight:700; display:flex; justify-content:space-between; align-items:center; color:#94a3b8; text-transform:uppercase; letter-spacing:.5px; }
    .quote { font-size:13px; font-style:italic; color:#94a3b8; line-height:1.6; margin:0 0 10px; }
    .check { display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px; }
    .check input { width:18px; height:18px; accent-color:#16a34a; }
    .card textarea {
        width:100%; box-sizing:border-box;
        background:#0a1322; border:1px solid #243246; color:#e5e7eb;
        padding:10px 12px; border-radius:6px; font-size:13px; font-family:inherit;
    }
    .card textarea:focus { outline:none; border-color:#0e9488; }

    .sig-clear { background:transparent; border:1px solid #7f1d1d; color:#fca5a5; padding:4px 10px; border-radius:6px; font-size:11px; cursor:pointer; font-family:inherit; }
    .sig-wrap  { position:relative; height:140px; background:#fff; border:2px dashed #243246; border-radius:6px; overflow:hidden; touch-action:none; }
    .sig-wrap canvas { position:absolute; inset:0; width:100%; height:100%; cursor:crosshair; display:block; }

    .alert { background:#450a0a; border:1px solid #7f1d1d; color:#fecaca; padding:10px 14px; border-radius:8px; font-size:13px; margin-bottom:12px; }

    .submit-bar { padding-top:6px; }
    .primary { background:#0e9488; color:#0a1726; border:none; padding:11px 22px; border-radius:8px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; }
    .primary.submit { width:100%; padding:14px; font-size:15px; }
    .primary:disabled { opacity:.55; cursor:not-allowed; }

    /* ── Submit progress overlay ───────────────────────────────────────── */
    .submit-overlay { position:fixed; inset:0; background:rgba(2,6,23,.82); z-index:120;
                      display:flex; align-items:center; justify-content:center; padding:18px;
                      backdrop-filter:blur(2px); }
    .submit-card    { background:#0d1729; border:1px solid #243246; border-radius:14px;
                      padding:30px 28px 24px; width:100%; max-width:360px;
                      box-shadow:0 24px 60px rgba(0,0,0,.55); text-align:center;
                      animation:submitPop .25s ease-out; }
    @@keyframes submitPop {
        from { transform:scale(.92); opacity:0; }
        to   { transform:scale(1);   opacity:1; }
    }
    .submit-spinner { width:46px; height:46px; border:4px solid #1f2a3a;
                      border-top-color:#0e9488; border-radius:50%;
                      animation:spin .9s linear infinite; margin:0 auto 14px; }
    .submit-card h2 { font-size:17px; font-weight:800; margin:0 0 6px; color:#e5e7eb;
                      letter-spacing:.3px; }
    .submit-step    { font-size:12px; color:#94a3b8; margin:0 0 14px; min-height:16px; }

    .submit-stages  { list-style:none; padding:0; margin:14px 0 0; text-align:left;
                      border-top:1px solid #1f2a3a; padding-top:14px; }
    .submit-stages li { display:flex; align-items:center; gap:10px; padding:5px 0;
                        font-size:12px; color:#475569; transition:color .15s; }
    .submit-stages li .bullet { width:18px; text-align:center; font-size:13px;
                                color:#475569; }
    .submit-stages li.done   { color:#86efac; }
    .submit-stages li.done   .bullet { color:#22c55e; }
    .submit-stages li.active { color:#7dd3fc; font-weight:600; }
    .submit-stages li.active .bullet { color:#0e9488; }
    .submit-stages li.error  { color:#fca5a5; }
    .submit-stages li.error  .bullet { color:#ef4444; }
</style>

@code {
    private const string SIG_ID = "opSig";

    [Parameter] public int MachineId { get; set; }

    private SyncTemplateDto?  template;
    private List<ItemEntry>   items = new();
    private SubmissionForm    form  = new();
    private string?           machineLabel;
    private string?           machineSubtitle;
    private bool              busy  = true;
    private string            error = "";

    // ── Submit progress state ────────────────────────────────────────────────
    /// <summary>True while DoSubmit is running. Drives the overlay + disables the button.</summary>
    private bool   submitting;
    private string submitTitle = "Submitting checklist…";
    private string submitStep  = "";

    /// <summary>
    /// Per-step state for the overlay's stage list. We use this rather than
    /// magic-string switches in markup so the visual progress is unambiguous —
    /// every step is either pending (◯), active (●), done (✓), or errored (✕).
    /// </summary>
    private List<SubmitStage> submitStages = new();

    private record SubmitStage(string Key, string Label)
    {
        public string Status { get; set; } = "pending";  // pending | active | done | error
        public string Cls    => Status;
        public string Glyph  => Status switch
        {
            "done"   => "✓",
            "active" => "●",
            "error"  => "✕",
            _        => "○"
        };
    }

    /// <summary>
    /// Advance a stage by key. <c>"done"</c> on the previous step + <c>"active"</c>
    /// on the new one + a refreshed sub-line. Always followed by
    /// <c>StateHasChanged()</c> so the overlay reflects the change immediately.
    /// </summary>
    private void SetStage(string key, string status, string? subline = null)
    {
        var stage = submitStages.FirstOrDefault(s => s.Key == key);
        if (stage != null) stage.Status = status;
        if (subline != null) submitStep = subline;
        StateHasChanged();
    }

    private void InitSubmitStages(bool willGoOnline)
    {
        submitStages = new List<SubmitStage>
        {
            new("validate",  "Checking inputs"),
            new(willGoOnline ? "upload" : "queue",
                              willGoOnline ? "Uploading to server" : "Saving to offline queue"),
            new("pdf",       "Generating PDF receipt"),
            new("done",      "All set")
        };
        submitTitle = "Submitting checklist…";
        submitStep  = "Starting…";
    }

    private int CriticalDefects =>
        items.Count(i => i.Template.IsNoGoItem && i.Status == ItemStatus.Defect);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", replace:true); return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (template is not null)
        {
            try { await JS.InvokeVoidAsync("SigPad.init", SIG_ID); }
            catch { /* canvas not in DOM yet — next render will catch it */ }
        }
    }

    private async Task LoadAsync()
    {
        busy = true; error = "";

        try
        {
            var cached = await Cache.GetTemplateAsync(MachineId);
            if (cached is not null) { ApplyTemplate(cached); busy = false; StateHasChanged(); }
        }
        catch { }

        try
        {
            var cm = (await Cache.GetMachinesAsync()).FirstOrDefault(x => x.Id == MachineId);
            if (cm is not null)
            {
                machineLabel    = cm.MachineName;
                machineSubtitle = $"Machine #{cm.MachineNumber} · {cm.TypeDisplay} · Pre-Use Inspection";
            }
        }
        catch { }

        try
        {
            var fresh = await Api.TemplateAsync(MachineId);
            if (fresh is not null)
            {
                ApplyTemplate(fresh);
                try { await Cache.SaveTemplateAsync(fresh); } catch { }
            }
            else if (template is null)
            {
                error = "Server didn't return a template. It may not exist or your session expired.";
            }
        }
        catch (HttpRequestException)
        {
            if (template is null) error = "You're offline and this checklist isn't cached. Open it once online first.";
        }
        catch (Exception ex) { if (template is null) error = ex.Message; }
        finally { busy = false; StateHasChanged(); }
    }

    private void ApplyTemplate(SyncTemplateDto t)
    {
        if (template is not null
            && template.TemplateId == t.TemplateId
            && items.Count == t.Items.Count) return;

        template = t;
        items = t.Items
            // Critical first, then by SortOrder — matches the reference UI's left/right split
            .OrderByDescending(i => i.IsNoGoItem)
            .ThenBy(i => i.SortOrder)
            .Select(i => new ItemEntry { Template = i })
            .ToList();
    }

    private void SetStatus(ItemEntry item, ItemStatus status)
    {
        item.Status = status;
        if (status == ItemStatus.InOrder)
        {
            // Going green wipes any defect-only state — text note, photo,
            // AND audio. Also stops an in-flight recording so the recorder
            // doesn't leak. Avoids "ghost" data hanging around if the
            // operator toggles back and forth before submitting.
            item.Notes         = null;
            item.PhotoBase64   = null;
            item.PhotoMimeType = null;
            if (item.Recorder is not null)
            {
                _ = item.Recorder.StopAsync();
                item.Recorder = null;
            }
            item.AudioBase64   = null;
            item.AudioMimeType = null;
        }
    }

    /// <summary>
    /// Open the device camera (MAUI MediaPicker) and stamp the resulting
    /// bytes onto the item as base64. Best-effort: a permission denial or
    /// missing-camera silently no-ops so the operator can still type a note.
    /// </summary>
    private async Task CapturePhotoAsync(ItemEntry item)
    {
        try
        {
            if (!MediaPicker.Default.IsCaptureSupported) return;

            var photo = await MediaPicker.Default.CapturePhotoAsync();
            if (photo is null) return;  // user cancelled

            // Read the bytes once into memory. Phone cameras default to
            // 2–4 MB JPEGs — fine for now, will add a resize pass when we
            // see network pain in the field.
            using var src = await photo.OpenReadAsync();
            using var ms  = new MemoryStream();
            await src.CopyToAsync(ms);
            var bytes = ms.ToArray();
            if (bytes.Length == 0) return;

            item.PhotoBase64   = Convert.ToBase64String(bytes);
            item.PhotoMimeType = photo.ContentType ?? "image/jpeg";
            StateHasChanged();
        }
        catch (FeatureNotSupportedException)
        {
            // No camera on this device — UI just stays unchanged.
        }
        catch (PermissionException)
        {
            // User denied the camera permission. Same — silent no-op so they
            // can still submit by typing the defect note.
        }
        catch (Exception ex)
        {
            // Defensive: surface any other failure in the inline error strip
            // so the operator knows the photo didn't attach but the rest of
            // the submission still works.
            error = "Couldn't take the photo: " + ex.Message;
            StateHasChanged();
        }
    }

    private void RemovePhoto(ItemEntry item)
    {
        item.PhotoBase64   = null;
        item.PhotoMimeType = null;
    }

    // ── Voice memo recording ─────────────────────────────────────────────────

    /// <summary>Global guard so concurrent recordings can't start across rows.
    /// Plugin.Maui.Audio only supports one recorder at a time on Android.</summary>
    private bool audioBusy;

    private string AudioTooltip(ItemEntry item) =>
        item.IsRecording  ? "Stop recording"
        : item.HasAudio   ? "Re-record voice memo"
        :                   "Record a voice memo";

    /// <summary>
    /// Tap-to-toggle recorder. First tap on a defect row asks for the mic
    /// permission, opens a recorder, starts capturing. Second tap stops,
    /// drains the resulting stream into base64, and stamps it onto the item.
    /// Errors (permission denied, no microphone, plugin failure) leave the
    /// item in a clean idle state and surface a friendly message.
    /// </summary>
    private async Task ToggleRecordingAsync(ItemEntry item)
    {
        if (audioBusy) return;
        audioBusy = true;
        try
        {
            // ── Stop path ──
            if (item.Recorder is not null)
            {
                IAudioSource? src = null;
                try   { src = await item.Recorder.StopAsync(); }
                catch (Exception ex) { error = "Couldn't stop the recording: " + ex.Message; }
                item.Recorder = null;

                if (src is null) { StateHasChanged(); return; }

                try
                {
                    using var stream = src.GetAudioStream();
                    using var ms     = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var bytes = ms.ToArray();
                    if (bytes.Length == 0)
                    {
                        error = "Recording was empty. Try again.";
                    }
                    else
                    {
                        item.AudioBase64   = Convert.ToBase64String(bytes);
                        // Plugin.Maui.Audio default container differs by
                        // platform. Browser HTML5 <audio> handles both with
                        // the right MIME — m4a on mobile, wav on Windows.
                        item.AudioMimeType =
#if WINDOWS
                            "audio/wav";
#else
                            "audio/m4a";
#endif
                    }
                }
                catch (Exception ex)
                {
                    error = "Couldn't save the recording: " + ex.Message;
                }
                return;
            }

            // ── Start path ──
            // Ask Android for mic permission. iOS / Windows will also prompt
            // the first time the recorder accesses the device.
            var status = await Permissions.RequestAsync<Permissions.Microphone>();
            if (status != PermissionStatus.Granted)
            {
                error = "Microphone permission was denied — you can still type the defect note.";
                return;
            }

            try
            {
                var rec = AudioMgr.CreateRecorder();
                await rec.StartAsync();
                item.Recorder = rec;
            }
            catch (Exception ex)
            {
                error = "Couldn't start recording: " + ex.Message;
            }
        }
        finally
        {
            audioBusy = false;
            StateHasChanged();
        }
    }

    private void RemoveAudio(ItemEntry item)
    {
        item.AudioBase64   = null;
        item.AudioMimeType = null;
    }

    private async Task ClearSig() => await JS.InvokeVoidAsync("SigPad.clear", SIG_ID);

    private void Back() => Nav.NavigateTo("/machines");

    private async Task DoSubmit()
    {
        if (submitting) return;
        error = "";

        // ── Stage 0 · pre-flight validation (still inline, instant) ──
        if (form.KmOrHourMeter is null or <= 0)  { error = "Enter the KM / Hour meter reading."; return; }
        if (items.Any(i => i.Status is null))    { error = "Mark every item as either In Order or Defect."; return; }
        if (!form.FitnessDeclarationSigned)      { error = "Tick the fitness declaration before submitting."; return; }

        var sig = await JS.InvokeAsync<string?>("SigPad.toDataUrl", SIG_ID);
        if (string.IsNullOrEmpty(sig))
        { error = "Sign with your finger / pen before submitting."; return; }

        if (items.Any(i => i.Status == ItemStatus.Defect && string.IsNullOrWhiteSpace(i.Notes)))
        { error = "Describe every defect before submitting."; return; }

        // ── Show the overlay and start the staged flow ──
        //
        // "Online" means BOTH device-has-internet AND the API answered the
        // most recent ping. Pure Wi-Fi state isn't enough — we've all seen
        // the spinner stuck at "Uploading…" because the device thought it
        // had signal but the server was unreachable (VPN dropped, captive
        // portal, server down). ApiHealth.IsOnline gives the honest answer.
        var goingOnline = Health.IsOnline;
        submitting = true;
        InitSubmitStages(goingOnline);
        StateHasChanged();
        await Task.Yield();  // let Blazor paint the overlay before we block on I/O

        var req = new SyncSubmissionRequest
        {
            LocalId                  = Guid.NewGuid(),
            MachineId                = MachineId,
            Shift                    = form.Shift,
            KmOrHourMeter            = form.KmOrHourMeter,
            OperatorRemarks          = string.IsNullOrWhiteSpace(form.OperatorRemarks) ? null : form.OperatorRemarks,
            FitnessDeclarationSigned = form.FitnessDeclarationSigned,
            OperatorSignature        = sig,
            SubmittedAt              = DateTime.UtcNow,
            Items = items.Select(i => new SubmissionItemDto
            {
                TemplateItemId = i.Template.Id,
                Status         = i.Status!.Value,
                Notes          = i.Notes,
                PhotoBase64    = i.PhotoBase64,
                PhotoMimeType  = i.PhotoMimeType,
                AudioBase64    = i.AudioBase64,
                AudioMimeType  = i.AudioMimeType
            }).ToList()
        };

        // ── Stage 1 · validate ──
        SetStage("validate", "active", "Verifying every item is marked…");
        await Task.Delay(150);  // tiny pause so the user can see the stage tick over
        SetStage("validate", "done");

        // ── Stage 2 · upload or queue ──
        //
        // The rule: NEVER fail a submission outright. If the server takes
        // it → great. If anything goes wrong (no network, server down,
        // timeout, server returned non-2xx, exception) → fall through to
        // the offline queue. The SyncWorker will replay it the moment the
        // API is reachable again. The mine has no signal underground;
        // surfacing a generic "Submission failed" there means losing the
        // operator's work.
        var uploadKey = goingOnline ? "upload" : "queue";
        SetStage(uploadKey, "active",
            goingOnline ? "Sending to the server…" : "Storing locally so it syncs later…");

        bool serverAccepted = false;
        if (goingOnline)
        {
            try
            {
                var result = await Api.SubmitAsync(req);
                if (result != null)
                {
                    serverAccepted = true;
                    SetStage(uploadKey, "done", "Server confirmed.");
                }
                // result == null → server returned non-2xx. Fall through to
                // queue so the operator's work isn't lost.
            }
            catch (HttpRequestException) { /* network died mid-call → queue */ }
            catch (TaskCanceledException) { /* HttpClient timeout → queue */ }
            catch (Exception ex)
            {
                // Any other failure (serialization, etc.) — still try to queue
                // before we error out. Capture the message in case the queue
                // fallback also fails so the user gets the original cause.
                error = "Submit failed, attempting offline queue: " + ex.Message;
            }
        }

        if (!serverAccepted)
        {
            try
            {
                await Queue.EnqueueAsync(req);
                _ = Task.Run(Sync.DrainAsync);

                // Relabel the stage so the user understands what happened —
                // they tapped Submit expecting an upload, and we want them
                // to see clearly that the work is saved (just not on the
                // server yet).
                var sw = submitStages.FirstOrDefault(s => s.Key == uploadKey);
                if (sw != null)
                {
                    submitStages[submitStages.IndexOf(sw)] =
                        new SubmitStage(uploadKey, "Saved to offline queue") { Status = "done" };
                }
                submitStep = goingOnline
                    ? "Server unreachable — will sync when the API is back."
                    : "Saved offline — will sync when signal returns.";
                StateHasChanged();
            }
            catch (Exception qex)
            {
                // Truly catastrophic: even SQLite write failed. This is the
                // ONLY place where we surface an error and abort the flow.
                SetStage(uploadKey, "error", qex.Message);
                error = "Couldn't save locally either: " + qex.Message;
                submitting = false;
                StateHasChanged();
                return;
            }
        }

        // ── Stage 3 · on-device PDF ──
        SetStage("pdf", "active", "Rendering on-device PDF receipt…");
        try
        {
            await TryGenerateLocalPdfAsync(req);
            SetStage("pdf", "done");
        }
        catch
        {
            // Already swallowed inside TryGenerateLocalPdfAsync, but keep the
            // overlay honest if anything bubbles out.
            SetStage("pdf", "error", "PDF receipt couldn't be generated (the submission is still saved).");
        }

        // ── Stage 4 · done · short pause so the green ticks are visible ──
        SetStage("done", "done", serverAccepted
            ? "All done — heading to dashboard."
            : "Queued. Heading to dashboard.");
        await Task.Delay(400);

        submitting = false;
        // Reflect what actually happened, not what we expected. A
        // submission can start "going online" but end up queued if the
        // server flaked mid-call — the URL hint should be honest.
        Nav.NavigateTo(serverAccepted ? "/dashboard?ok=1" : "/dashboard?queued=1");
    }

    /// <summary>
    /// Best-effort on-device PDF render. Looks up the machine in the cache
    /// (we know it's there because we got here from /machines/{id}), then
    /// calls jsPDF via <see cref="LocalPdfService"/>. Failures are swallowed
    /// — the user shouldn't see a submission "fail" because the local PDF
    /// pipeline hiccuped.
    /// </summary>
    private async Task TryGenerateLocalPdfAsync(SyncSubmissionRequest req)
    {
        try
        {
            if (template is null) return;

            var machine = (await Cache.GetMachinesAsync())
                .FirstOrDefault(m => m.Id == MachineId);
            if (machine is null) return;

            var user = Auth.CurrentUser;
            if (user is null) return;

            // Mine name is currently hard-coded to match the production sample.
            // If we ever expose it as a server config, swap this for a fetch.
            const string mineName = "BELFAST COAL MINE";

            await LocalPdf.GenerateAndCacheAsync(req, template, machine, user, mineName);
        }
        catch
        {
            // Intentional swallow — local PDF generation is a "nice to have"
            // and must not block the submission flow.
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private string IconUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var baseAddr = Api.BaseAddress?.ToString().TrimEnd('/');
        return $"{baseAddr}/{path.TrimStart('/')}";
    }

    private string FirstChar(string s) =>
        string.IsNullOrWhiteSpace(s) ? "?" : s.Trim()[0].ToString().ToUpperInvariant();

    /// <summary>Deterministic tint for the icon background based on item name.</summary>
    private string IconColorClass(SyncTemplateItemDto t)
    {
        if (t.IsNoGoItem) return "red";

        var n = (t.ItemName ?? "").ToUpperInvariant();
        if (n.Contains("OIL") || n.Contains("FUEL") || n.Contains("HYDRAULIC") || n.Contains("COOLANT")) return "amber";
        if (n.Contains("WINDOW") || n.Contains("MIRROR") || n.Contains("WIPER")) return "cyan";
        if (n.Contains("AIR")) return "cyan";
        return "orange";
    }

    private class SubmissionForm
    {
        public Shift  Shift                    { get; set; } = Shift.Day;
        public int?   KmOrHourMeter            { get; set; }
        public string OperatorRemarks          { get; set; } = "";
        public bool   FitnessDeclarationSigned { get; set; }
    }

    private class ItemEntry
    {
        public SyncTemplateItemDto Template { get; set; } = null!;
        public ItemStatus?         Status   { get; set; }
        public string?             Notes    { get; set; }

        /// <summary>Base64 of the captured photo (no <c>data:</c> prefix).
        /// Set by <c>CapturePhotoAsync</c>, cleared by <c>RemovePhoto</c>.</summary>
        public string?             PhotoBase64   { get; set; }
        public string?             PhotoMimeType { get; set; }

        public bool   HasPhoto    => !string.IsNullOrEmpty(PhotoBase64);
        /// <summary>Convenience for binding directly to an &lt;img src&gt;.</summary>
        public string PhotoDataUrl =>
            HasPhoto
                ? $"data:{PhotoMimeType ?? "image/jpeg"};base64,{PhotoBase64}"
                : "";

        // ── Voice memo state ──────────────────────────────────────────────────
        /// <summary>Base64 of the captured audio (no <c>data:</c> prefix).
        /// Set when StopRecording succeeds, cleared by RemoveAudio.</summary>
        public string?         AudioBase64   { get; set; }
        public string?         AudioMimeType { get; set; }
        /// <summary>Active recorder when the operator is currently recording.
        /// Null otherwise. Reset to null after StopAsync regardless of outcome.</summary>
        public IAudioRecorder? Recorder      { get; set; }

        public bool   IsRecording => Recorder is not null;
        public bool   HasAudio    => !string.IsNullOrEmpty(AudioBase64);
        public string AudioDataUrl =>
            HasAudio
                ? $"data:{AudioMimeType ?? "audio/m4a"};base64,{AudioBase64}"
                : "";
    }
}
