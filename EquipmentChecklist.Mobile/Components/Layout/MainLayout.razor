@inherits LayoutComponentBase
@using EquipmentChecklist.Mobile.Services
@inject AuthService      Auth
@inject SubmissionQueue  Queue
@inject ActionQueue      Actions
@inject SyncWorker       Sync
@inject ApiHealth        Health
@inject LocalCache       Cache
@inject NavigationManager Nav
@implements IDisposable

<div class="app @(drawerOpen ? "drawer-open" : "")">

    @* Mobile-only backdrop. Tap to close the drawer. *@
    <div class="drawer-scrim" @onclick="CloseDrawer"></div>

    @* ────────────── SIDEBAR ────────────── *@
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">⛏</div>
            <div>
                <div class="brand-name">ENALENI</div>
                <div class="brand-sub">EQUIPMENT CHECKLIST</div>
            </div>
        </div>

        <div class="nav-label">MAIN</div>

        <NavLink href="/dashboard"   class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
            <span class="nav-ico">📋</span><span class="nav-text">Dashboard</span>
        </NavLink>

        @if (IsOperator)
        {
            <NavLink href="/machines" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">✅</span><span class="nav-text">My Machines</span>
            </NavLink>
        }

        @if (IsOperator || IsSupervisor)
        {
            <NavLink href="/submissions" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">📝</span><span class="nav-text">My Submissions</span>
            </NavLink>
        }

        @if (IsSupervisor)
        {
            <div class="nav-label">SUPERVISOR</div>
            <NavLink href="/sign-off" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">✍</span><span class="nav-text">Sign-Off Queue</span>
            </NavLink>
            <NavLink href="/my-operators" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">👷</span><span class="nav-text">My Operators</span>
            </NavLink>
            <NavLink href="/no-go" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">🚫</span><span class="nav-text">NO-GO Machines</span>
            </NavLink>
        }

        @if (IsMechanic)
        {
            <div class="nav-label">MECHANIC</div>
            <NavLink href="/my-defects" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">🔧</span><span class="nav-text">My Defects</span>
            </NavLink>
            <NavLink href="/no-go" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">🚫</span><span class="nav-text">NO-GO Machines</span>
            </NavLink>
        }

        <NavLink href="/biometric" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
            <span class="nav-ico">🔐</span><span class="nav-text">Biometric Login</span>
        </NavLink>

        <div class="sidebar-footer">
            MHSA · DMR · CPS L8/9<br/>
            Enaleni Engineering and<br/>
            Technology<br/>
            Digital Checklist System
        </div>
    </aside>

    @* ────────────── MAIN COLUMN ────────────── *@
    <div class="main">

        @* Stale-data banner. Shown when the device hasn't seen the API in
           a while. Cache holds machines, defects, queues etc indefinitely
           so the app keeps working — this is a heads-up that the *content*
           may be stale (new assignments, new defect orders, etc). *@
        @if (daysSinceSync.HasValue)
        {
            @if (daysSinceSync.Value >= 20)
            {
                <div class="stale-banner critical">
                    <span class="ic">⚠</span>
                    <div class="msg">
                        <strong>It's been @daysSinceSync.Value days since you last synced.</strong>
                        Connect to Wi-Fi or VPN to receive new machines, defects,
                        and team updates assigned to you.
                    </div>
                </div>
            }
            else if (daysSinceSync.Value >= 14)
            {
                <div class="stale-banner warn">
                    <span class="ic">📡</span>
                    <div class="msg">
                        Last synced <strong>@daysSinceSync.Value days ago</strong> —
                        connect to Wi-Fi soon to pull fresh assignments.
                    </div>
                </div>
            }
        }

        <header class="topbar">
            <button class="hamburger" @onclick="ToggleDrawer" title="Menu">
                <span></span><span></span><span></span>
            </button>

            <div class="topbar-date">
                <span class="full">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                <span class="short">@DateTime.Now.ToString("ddd, dd MMM")</span>
            </div>

            <div class="topbar-right">
                <span class="pill @(IsOnline ? "ok" : "off")">
                    <span class="dot"></span>@(IsOnline ? "Online" : "Offline")
                </span>

                @if (queuedCount > 0)
                {
                    <span class="pill queue"
                          title="Submissions waiting to sync"
                          @onclick="ManualDrain"
                          style="cursor:pointer">
                        ☁ @queuedCount
                    </span>
                }

                <span class="pill subtle" title="Notifications">🔔</span>
                <span class="pill subtle">⋯</span>

                <button class="user-chip" @onclick="ToggleUserMenu">
                    <span class="avatar">@Initials</span>
                    <span class="user-text">
                        <span class="user-name">@(Auth.CurrentUser?.FullName ?? "—")</span>
                        <span class="user-role">@RoleLabel</span>
                    </span>
                    <span class="caret">▾</span>
                </button>
                @if (showUserMenu)
                {
                    <div class="user-menu" @onclick="@(()=>showUserMenu=false)">
                        <a class="menu-item" href="/mysubmissions">📝 My Submissions</a>
                        <a class="menu-item" href="/biometric">🔐 Biometric login</a>
                        <button class="menu-item danger" @onclick="SignOut">⎋ Sign out</button>
                    </div>
                }
            </div>
        </header>

        <div class="content">
            @Body
        </div>
    </div>
</div>

@* Global toast stack — one instance owns the queue for the entire app.
   Pages just inject ToastService and call Success/Error/Info/Warning. *@
<Toaster />

<style>
    .app { display:flex; min-height:100vh; background:#0b1726; color:#e5e7eb;
           font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }

    /* Sidebar */
    .sidebar { width:240px; flex-shrink:0; background:#0d1729; border-right:1px solid #1f2a3a; padding:18px 0; display:flex; flex-direction:column; }
    .brand { display:flex; align-items:center; gap:10px; padding:0 18px 18px; border-bottom:1px solid #1f2a3a; margin-bottom:14px; }
    .brand-mark { width:38px; height:38px; background:#0e9488; color:#fff; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:20px; }
    .brand-name { font-size:14px; font-weight:800; letter-spacing:.4px; }
    .brand-sub  { font-size:10px; color:#64748b; letter-spacing:.6px; }

    .nav-label { padding:8px 18px 6px; font-size:10px; letter-spacing:1px; color:#64748b; }
    .nav-item { display:flex; align-items:center; gap:10px; padding:9px 18px; color:#cbd5e1; text-decoration:none; font-size:13px; border-left:3px solid transparent; }
    .nav-item:hover { background:#111c2e; }
    .nav-item.active { background:#0b2148; color:#7dd3fc; border-left-color:#0e9488; font-weight:600; }
    .nav-ico { font-size:14px; }

    .sidebar-footer { margin-top:auto; padding:14px 18px; font-size:10px; color:#475569; line-height:1.7; font-family:ui-monospace,monospace; }

    /* Topbar */
    .main { flex:1; display:flex; flex-direction:column; min-width:0; }
    .topbar { display:flex; align-items:center; justify-content:space-between; padding:14px 22px; border-bottom:1px solid #1f2a3a; background:#0d1729; }
    .topbar-date { font-size:13px; color:#94a3b8; }
    .topbar-right { display:flex; align-items:center; gap:10px; position:relative; }

    .pill { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:999px; font-size:11px; border:1px solid #1f2a3a; background:#111c2e; color:#94a3b8; }
    .pill .dot { width:7px; height:7px; border-radius:50%; background:#94a3b8; }
    .pill.ok   { border-color:#166534; color:#a7f3d0; }
    .pill.ok .dot { background:#22c55e; }
    .pill.off  { border-color:#7f1d1d; color:#fca5a5; }
    .pill.off .dot { background:#ef4444; }
    .pill.queue { background:#451a03; border-color:#92400e; color:#fbbf24; }
    .pill.subtle { font-size:13px; padding:5px 10px; }

    .user-chip { display:flex; align-items:center; gap:8px; background:#111c2e; border:1px solid #1f2a3a; border-radius:999px; padding:5px 10px 5px 5px; color:#e5e7eb; cursor:pointer; font-family:inherit; }
    .user-chip:hover { border-color:#243246; }
    .avatar { width:30px; height:30px; border-radius:50%; background:#0e9488; color:#fff; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; }
    .user-text { display:flex; flex-direction:column; align-items:flex-start; line-height:1.1; }
    .user-name { font-size:12px; font-weight:600; }
    .user-role { font-size:10px; color:#94a3b8; }
    .caret { font-size:10px; color:#64748b; margin-left:2px; }

    .user-menu { position:absolute; right:0; top:46px; background:#111c2e; border:1px solid #1f2a3a; border-radius:10px; padding:6px; z-index:30; min-width:180px; box-shadow:0 8px 22px rgba(0,0,0,.4); display:flex; flex-direction:column; }
    .menu-item { background:transparent; border:none; color:#e5e7eb; padding:9px 12px; border-radius:6px; text-align:left; font-size:13px; cursor:pointer; text-decoration:none; font-family:inherit; }
    .menu-item:hover { background:#1a2638; }
    .menu-item.danger { color:#fca5a5; }

    .content { flex:1; min-width:0; padding:24px 26px 36px; overflow:auto; }

    /* Stale-data banner — sits at the very top of the main column, above
       the topbar. Two severities; both non-dismissable so operators in the
       field can't just click them away and forget. */
    .stale-banner { display:flex; align-items:center; gap:12px;
                    padding:10px 16px; font-size:13px; line-height:1.45;
                    border-bottom:1px solid; }
    .stale-banner .ic  { font-size:18px; flex-shrink:0; }
    .stale-banner .msg { flex:1; min-width:0; }
    .stale-banner.warn     { background:#7c5302; color:#fde68a; border-bottom-color:#a16207; }
    .stale-banner.warn  strong { color:#fef3c7; }
    .stale-banner.critical { background:#7f1d1d; color:#fecaca; border-bottom-color:#b91c1c; }
    .stale-banner.critical strong { color:#fff; }

    /* Hamburger + drawer scrim: hidden on desktop, used on mobile only */
    .hamburger    { display:none; background:transparent; border:none; padding:8px;
                    margin-right:6px; cursor:pointer; width:36px; height:36px;
                    flex-direction:column; justify-content:center; gap:4px;
                    align-items:center; }
    .hamburger span { display:block; width:20px; height:2px; background:#cbd5e1;
                      border-radius:2px; transition:transform .2s, opacity .2s; }
    .drawer-scrim { display:none; }
    .topbar-date .short { display:none; }

    /* ── Mobile (phone) ─────────────────────────────────────────────────── */
    @@media (max-width:760px) {
        /* Slide-out drawer pattern: sidebar lives off-screen by default and
           translates in when .drawer-open is set on .app. */
        .sidebar {
            position:fixed; left:0; top:0; bottom:0; z-index:50;
            width:260px; padding:18px 0;
            transform:translateX(-100%);
            transition:transform .22s ease-out;
            box-shadow:0 0 0 transparent;
        }
        .drawer-open .sidebar {
            transform:translateX(0);
            box-shadow:6px 0 24px rgba(0,0,0,.45);
        }
        .drawer-scrim {
            display:block; position:fixed; inset:0; z-index:40;
            background:rgba(2,6,23,.55);
            opacity:0; pointer-events:none;
            transition:opacity .22s ease-out;
        }
        .drawer-open .drawer-scrim {
            opacity:1; pointer-events:auto;
        }

        /* Hamburger replaces the sidebar's always-visible role */
        .hamburger { display:flex; }

        /* Long date wraps; switch to a compact format */
        .topbar-date .full  { display:none; }
        .topbar-date .short { display:inline; }
        .topbar-date  { font-size:12px; color:#cbd5e1; }

        /* Topbar tightening */
        .topbar       { padding:10px 12px; gap:8px; }
        .user-text    { display:none; }      /* keep the avatar dot, drop name+role */
        .pill.subtle  { display:none; }      /* drop the … / 🔔 chips on phones */

        .content      { padding:14px; }
    }
</style>

@code {
    private int   queuedCount = 0;
    private bool  showUserMenu;

    /// <summary>
    /// Whether the mobile slide-out drawer is currently visible. Always
    /// false on desktop — the CSS @@media query makes the sidebar visible
    /// regardless of this flag once the viewport is wide enough.
    /// </summary>
    private bool  drawerOpen;

    /// <summary>
    /// Whole days between now and the most recent successful API ping for
    /// the signed-in user. Null when there's no cached record yet (first
    /// launch) so we don't scare brand-new users. The banner thresholds
    /// are 14 (warn, yellow) and 20 (critical, red).
    /// </summary>
    private int?  daysSinceSync;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
    private void CloseDrawer()  => drawerOpen = false;

    private string Initials => string.Concat(
        (Auth.CurrentUser?.FullName ?? "?")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => w[0]));

    private string RoleLabel
        => Auth.CurrentUser?.Roles?.FirstOrDefault() ?? "Operator";

    private bool IsOperator
        => Auth.CurrentUser?.Roles?.Any(r => r == "Operator") ?? false;

    private bool IsSupervisor
        => Auth.CurrentUser?.Roles?.Any(r => r == "Supervisor" || r == "Admin") ?? false;

    private bool IsMechanic
        => Auth.CurrentUser?.Roles?.Any(r => r == "Mechanic" || r == "Admin") ?? false;

    /// <summary>
    /// "Can I actually reach the API right now?" Combines device-network state
    /// with the most recent server ping from <see cref="ApiHealth"/>. Pure
    /// device connectivity isn't enough — Wi-Fi can be on while the server is
    /// unreachable (VPN dropped, captive portal, server down).
    /// </summary>
    private bool IsOnline => Health.IsOnline;

    protected override async Task OnInitializedAsync()
    {
        Queue.Changed       += OnQueueChanged;
        Actions.Changed     += OnQueueChanged;
        Sync.DrainCompleted += OnQueueChanged;
        Health.Changed      += OnHealthChanged;
        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        // Recompute the stale-data banner whenever the user navigates so
        // the message refreshes through the day without depending on a
        // health transition firing.
        Nav.LocationChanged += OnLocationChanged;

        queuedCount = await Queue.CountAsync() + await Actions.CountAsync();
        await RefreshDaysSinceSyncAsync();
    }

    private void OnHealthChanged()
    {
        // Successful ping bumped LastSyncedAt in SQLite; re-read so the
        // banner can drop off without waiting for navigation.
        InvokeAsync(async () =>
        {
            await RefreshDaysSinceSyncAsync();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(async () =>
        {
            await RefreshDaysSinceSyncAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Read the cached user's LastSyncedAt and compute whole-day age.
    /// Null user / null timestamp leaves <see cref="daysSinceSync"/> null
    /// so the banner stays hidden — we don't nag people who've never been
    /// online (probably first launch on a brand-new device).
    /// </summary>
    private async Task RefreshDaysSinceSyncAsync()
    {
        try
        {
            var email = Auth.CurrentUser?.Email;
            if (string.IsNullOrEmpty(email)) { daysSinceSync = null; return; }

            var last = await Cache.GetLastSyncedAtAsync(email);
            if (last is null) { daysSinceSync = null; return; }

            var days = (int)Math.Floor((DateTime.UtcNow - last.Value).TotalDays);
            daysSinceSync = days < 0 ? 0 : days;
        }
        catch
        {
            // Cache read failure shouldn't break the layout. Banner stays off.
            daysSinceSync = null;
        }
    }

    private void OnQueueChanged()
    {
        InvokeAsync(async () =>
        {
            queuedCount = await Queue.CountAsync() + await Actions.CountAsync();
            StateHasChanged();
        });
    }

    private void OnConnectivityChanged(object? sender, ConnectivityChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void ToggleUserMenu() => showUserMenu = !showUserMenu;

    private void ManualDrain() => _ = Task.Run(Sync.DrainAsync);

    private async Task SignOut()
    {
        showUserMenu = false;
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Queue.Changed       -= OnQueueChanged;
        Actions.Changed     -= OnQueueChanged;
        Sync.DrainCompleted -= OnQueueChanged;
        Health.Changed      -= OnHealthChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
    }
}
