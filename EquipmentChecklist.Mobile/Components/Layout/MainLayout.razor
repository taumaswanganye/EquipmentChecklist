@inherits LayoutComponentBase
@using EquipmentChecklist.Mobile.Services
@inject AuthService      Auth
@inject SubmissionQueue  Queue
@inject ActionQueue      Actions
@inject SyncWorker       Sync
@inject ApiHealth        Health
@inject LocalCache       Cache
@inject ToastService     Toasts
@inject NavigationManager Nav
@inject UrgentAlertService UrgentAlert
@inject IPeerAlertService PeerAlert
@inject IPeerAlertPermissions PeerAlertPermissions
@inject AppLifecycleService Lifecycle
@implements IDisposable

<div class="app @(drawerOpen ? "drawer-open" : "")">

    @* Mobile-only backdrop. Tap to close the drawer. *@
    <div class="drawer-scrim" @onclick="CloseDrawer"></div>

    @* ────────────── SIDEBAR ────────────── *@
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">⛏</div>
            <div>
                <div class="brand-name">ENALENI</div>
                <div class="brand-sub">EQUIPMENT CHECKLIST</div>
            </div>
        </div>

        <div class="nav-label">MAIN</div>

        <NavLink href="/dashboard"   class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
            <span class="nav-ico">📋</span><span class="nav-text">Dashboard</span>
        </NavLink>

        @if (IsOperator)
        {
            <NavLink href="/machines" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">✅</span><span class="nav-text">My Machines</span>
            </NavLink>
        }

        @if (IsOperator || IsSupervisor)
        {
            <NavLink href="/submissions" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">📝</span><span class="nav-text">My Submissions</span>
            </NavLink>
        }

        @if (IsSupervisor)
        {
            <div class="nav-label">SUPERVISOR</div>
            <NavLink href="/sign-off" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">✍</span><span class="nav-text">Sign-Off Queue</span>
            </NavLink>
            <NavLink href="/my-operators" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">👷</span><span class="nav-text">My Operators</span>
            </NavLink>
            <NavLink href="/no-go" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">🚫</span><span class="nav-text">NO-GO Machines</span>
            </NavLink>
        }

        @if (IsMechanic)
        {
            <div class="nav-label">MECHANIC</div>
            <NavLink href="/my-defects" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">🔧</span><span class="nav-text">My Defects</span>
            </NavLink>
            <NavLink href="/no-go" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
                <span class="nav-ico">🚫</span><span class="nav-text">NO-GO Machines</span>
            </NavLink>
        }

        <NavLink href="/biometric" class="nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseDrawer">
            <span class="nav-ico">🔐</span><span class="nav-text">Biometric Login</span>
        </NavLink>

        <div class="sidebar-footer">
            MHSA · DMR · CPS L8/9<br/>
            Enaleni Engineering and<br/>
            Technology<br/>
            Digital Checklist System
        </div>
    </aside>

    @* ────────────── MAIN COLUMN ────────────── *@
    <div class="main">

        @* Stale-data banner. Shown when the device hasn't seen the API in
           a while. Cache holds machines, defects, queues etc indefinitely
           so the app keeps working — this is a heads-up that the *content*
           may be stale (new assignments, new defect orders, etc). *@
        @if (daysSinceSync.HasValue)
        {
            @if (daysSinceSync.Value >= 20)
            {
                <div class="stale-banner critical">
                    <span class="ic">⚠</span>
                    <div class="msg">
                        <strong>It's been @daysSinceSync.Value days since you last synced.</strong>
                        Connect to Wi-Fi or VPN to receive new machines, defects,
                        and team updates assigned to you.
                    </div>
                </div>
            }
            else if (daysSinceSync.Value >= 14)
            {
                <div class="stale-banner warn">
                    <span class="ic">📡</span>
                    <div class="msg">
                        Last synced <strong>@daysSinceSync.Value days ago</strong> —
                        connect to Wi-Fi soon to pull fresh assignments.
                    </div>
                </div>
            }
        }

        @* Phase 8.5 — peer-alert permission denied banner. Surfaces only
           when permissions were prompted previously and at least one is
           still denied. Persistent (not dismissable) because the only
           proper resolution is to grant the permissions; ignoring it
           leaves the operator without background peer-alert coverage in
           a dead zone. The "Enable" button deep-links to the OS Settings
           page for our app. *@
        @if (peerAlertDenied)
        {
            <div class="peer-perm-banner">
                <div class="peer-perm-icon">🔕</div>
                <div class="peer-perm-body">
                    <strong>Background peer alerts disabled.</strong>
                    Bluetooth or notifications were denied. Peer NO-GO alerts will only fire while this app is open.
                </div>
                <button class="peer-perm-btn" @onclick="OpenPeerAlertSettings">
                    Enable
                </button>
            </div>
        }

        <header class="topbar">
            <button class="hamburger" @onclick="ToggleDrawer" title="Menu">
                <span></span><span></span><span></span>
            </button>

            <div class="topbar-date">
                <span class="full">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                <span class="short">@DateTime.Now.ToString("ddd, dd MMM")</span>
            </div>

            <div class="topbar-right">
                <span class="pill @(IsOnline ? "ok" : "off")">
                    <span class="dot"></span>@(IsOnline ? "Online" : "Offline")
                </span>

                @if (queuedCount > 0)
                {
                    <span class="pill queue"
                          title="Submissions waiting to sync"
                          @onclick="ManualDrain"
                          style="cursor:pointer">
                        ☁ @queuedCount
                    </span>
                }

                @* Replaces the static 🔔 placeholder with the real bell —
                   shows unread count, opens an inbox dropdown on tap. *@
                <NotificationBell />
                <span class="pill subtle">⋯</span>

                <button class="user-chip" @onclick="ToggleUserMenu">
                    <span class="avatar">@Initials</span>
                    <span class="user-text">
                        <span class="user-name">@(Auth.CurrentUser?.FullName ?? "—")</span>
                        <span class="user-role">@RoleLabel</span>
                    </span>
                    <span class="caret">▾</span>
                </button>
                @if (showUserMenu)
                {
                    <div class="user-menu" @onclick="@(()=>showUserMenu=false)">
                        <a class="menu-item" href="/submissions">📝 My Submissions</a>
                        <a class="menu-item" href="/biometric">🔐 Biometric login</a>
                        <button class="menu-item danger" @onclick="SignOut">⎋ Sign out</button>
                    </div>
                }
            </div>
        </header>

        <div class="content">
            @Body
        </div>
    </div>
</div>

@* Global toast stack — one instance owns the queue for the entire app.
   Pages just inject ToastService and call Success/Error/Info/Warning. *@
<Toaster />

@* ── Phase 8.1 — Loud Alert full-screen overlay ──────────────────────
   Fires when an operator raises a NO-GO while the device is offline.
   Red flashing background + huge text + a Dismiss button. The siren +
   vibration are driven from UrgentAlertService; this is just the
   visual half. Sits ABOVE everything (z-index 9999) so a passing
   supervisor sees it the moment they look at the tablet.

   Animation: 1s ramp red→darker-red→red so it pulses without flickering
   so hard it triggers photosensitive seizures. CSS animation, no JS.
   Pure full-coverage div — no navigation interaction beneath it. *@
@if (UrgentAlert.IsActive)
{
    <div class="urgent-alert-overlay" @onclick="DismissUrgentAlert">
        <div class="urgent-alert-card" @onclick:stopPropagation="true">
            <div class="urgent-alert-icon">🚨</div>
            <div class="urgent-alert-title">NO-GO RAISED</div>
            <div class="urgent-alert-sub">No server connectivity — alert anyone nearby.</div>
            <div class="urgent-alert-sub2">Show this screen to your supervisor.</div>
            <button class="urgent-alert-dismiss" @onclick="DismissUrgentAlert">
                ✓ I'VE NOTIFIED SOMEBODY
            </button>
        </div>
    </div>
    <style>
        .urgent-alert-overlay {
            position: fixed; inset: 0; z-index: 9999;
            display: flex; align-items: center; justify-content: center;
            background: #ef4444;
            animation: urgent-flash 1s ease-in-out infinite;
        }
        @@keyframes urgent-flash {
            0%   { background: #ef4444; }
            50%  { background: #7f1d1d; }
            100% { background: #ef4444; }
        }
        .urgent-alert-card {
            background: rgba(255,255,255,.96); color: #0b1726;
            border-radius: 14px; padding: 32px 28px;
            max-width: 460px; width: calc(100% - 32px);
            text-align: center; box-shadow: 0 24px 64px rgba(0,0,0,.45);
        }
        .urgent-alert-icon { font-size: 72px; margin-bottom: 6px; }
        .urgent-alert-title { font-size: 28px; font-weight: 800; letter-spacing: 1.5px; color: #ef4444; margin-bottom: 4px; }
        .urgent-alert-sub  { font-size: 14px; color: #475569; margin-top: 8px; }
        .urgent-alert-sub2 { font-size: 13px; color: #64748b; margin-top: 4px; font-style: italic; }
        .urgent-alert-dismiss {
            margin-top: 22px; background: #16a34a; color: #fff;
            border: none; border-radius: 10px;
            padding: 14px 18px; font-size: 14px; font-weight: 700; letter-spacing: .5px;
            cursor: pointer; width: 100%;
        }
        .urgent-alert-dismiss:active { transform: translateY(1px); }
    </style>
}

@* ── Phase 8.4 — Peer-alert permission explainer ─────────────────────
   One-time modal on first launch (Android 12+ only). Explains why we
   need the Bluetooth + Notifications permissions before triggering the
   OS dialog. If we just popped the OS dialog without context, operators
   would tap Deny by reflex and lose peer-alert coverage permanently.
   The modal is dismissable but tapping Continue triggers the OS prompt
   chain — we mark HasPromptedBefore inside PromptAsync so even a kill-
   the-app dismissal doesn't re-show this. *@
@if (showPermissionExplainer)
{
    <div class="perm-explainer-overlay" @onclick="ContinuePermissionPrompt">
        <div class="perm-explainer-card" @onclick:stopPropagation="true">
            <div class="perm-explainer-icon">📡</div>
            <div class="perm-explainer-title">Enable peer NO-GO alerts</div>
            <p class="perm-explainer-body">
                Your tablet can warn you when another operator nearby raises a
                NO-GO — even if there's no network. We need two permissions to
                make this work:
            </p>
            <ul class="perm-explainer-list">
                <li><strong>Bluetooth</strong> — to send and receive alerts to other tablets within ~30 metres.</li>
                <li><strong>Notifications</strong> — so the alert monitoring stays running while the screen is off.</li>
            </ul>
            <p class="perm-explainer-footer">
                Android will ask you for each one in turn. You can always change your mind in
                <em>Settings → Apps → Equipment Checklist → Permissions</em>.
            </p>
            <button class="perm-explainer-continue" @onclick="ContinuePermissionPrompt">
                Continue
            </button>
        </div>
    </div>
    <style>
        .perm-explainer-overlay {
            position: fixed; inset: 0; z-index: 9000;
            display: flex; align-items: center; justify-content: center;
            background: rgba(11, 23, 38, .8);
        }
        .perm-explainer-card {
            background: #fff; color: #0b1726;
            border-radius: 14px; padding: 28px 26px;
            max-width: 460px; width: calc(100% - 32px);
            box-shadow: 0 24px 64px rgba(0,0,0,.45);
        }
        .perm-explainer-icon { font-size: 52px; text-align: center; }
        .perm-explainer-title {
            font-size: 20px; font-weight: 700;
            text-align: center; margin: 8px 0 16px; color: #0e7490;
        }
        .perm-explainer-body { font-size: 14px; line-height: 1.55; color: #334155; margin: 0 0 12px; }
        .perm-explainer-list {
            font-size: 13px; line-height: 1.7; color: #334155;
            margin: 0 0 16px; padding-left: 22px;
        }
        .perm-explainer-list li { margin-bottom: 6px; }
        .perm-explainer-footer {
            font-size: 11px; line-height: 1.6; color: #64748b;
            margin: 0 0 18px; font-style: italic;
        }
        .perm-explainer-continue {
            width: 100%; background: #0e7490; color: #fff;
            border: none; border-radius: 10px;
            padding: 14px 18px; font-size: 14px; font-weight: 700;
            letter-spacing: .5px; cursor: pointer;
        }
        .perm-explainer-continue:active { transform: translateY(1px); }
    </style>
}

<style>
    .app { display:flex; min-height:100vh; background:#0b1726; color:#e5e7eb;
           font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }

    /* Sidebar */
    .sidebar { width:240px; flex-shrink:0; background:#0d1729; border-right:1px solid #1f2a3a; padding:18px 0; display:flex; flex-direction:column; }
    .brand { display:flex; align-items:center; gap:10px; padding:0 18px 18px; border-bottom:1px solid #1f2a3a; margin-bottom:14px; }
    .brand-mark { width:38px; height:38px; background:#0e9488; color:#fff; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:20px; }
    .brand-name { font-size:14px; font-weight:800; letter-spacing:.4px; }
    .brand-sub  { font-size:10px; color:#64748b; letter-spacing:.6px; }

    .nav-label { padding:8px 18px 6px; font-size:10px; letter-spacing:1px; color:#64748b; }
    .nav-item { display:flex; align-items:center; gap:10px; padding:9px 18px; color:#cbd5e1; text-decoration:none; font-size:13px; border-left:3px solid transparent; }
    .nav-item:hover { background:#111c2e; }
    .nav-item.active { background:#0b2148; color:#7dd3fc; border-left-color:#0e9488; font-weight:600; }
    .nav-ico { font-size:14px; }

    .sidebar-footer { margin-top:auto; padding:14px 18px; font-size:10px; color:#475569; line-height:1.7; font-family:ui-monospace,monospace; }

    /* Topbar */
    .main { flex:1; display:flex; flex-direction:column; min-width:0; }
    .topbar { display:flex; align-items:center; justify-content:space-between; padding:14px 22px; border-bottom:1px solid #1f2a3a; background:#0d1729; }
    .topbar-date { font-size:13px; color:#94a3b8; }
    .topbar-right { display:flex; align-items:center; gap:10px; position:relative; }

    .pill { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:999px; font-size:11px; border:1px solid #1f2a3a; background:#111c2e; color:#94a3b8; }
    .pill .dot { width:7px; height:7px; border-radius:50%; background:#94a3b8; }
    .pill.ok   { border-color:#166534; color:#a7f3d0; }
    .pill.ok .dot { background:#22c55e; }
    .pill.off  { border-color:#7f1d1d; color:#fca5a5; }
    .pill.off .dot { background:#ef4444; }
    .pill.queue { background:#451a03; border-color:#92400e; color:#fbbf24; }
    .pill.subtle { font-size:13px; padding:5px 10px; }

    .user-chip { display:flex; align-items:center; gap:8px; background:#111c2e; border:1px solid #1f2a3a; border-radius:999px; padding:5px 10px 5px 5px; color:#e5e7eb; cursor:pointer; font-family:inherit; }
    .user-chip:hover { border-color:#243246; }
    .avatar { width:30px; height:30px; border-radius:50%; background:#0e9488; color:#fff; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; }
    .user-text { display:flex; flex-direction:column; align-items:flex-start; line-height:1.1; }
    .user-name { font-size:12px; font-weight:600; }
    .user-role { font-size:10px; color:#94a3b8; }
    .caret { font-size:10px; color:#64748b; margin-left:2px; }

    .user-menu { position:absolute; right:0; top:46px; background:#111c2e; border:1px solid #1f2a3a; border-radius:10px; padding:6px; z-index:30; min-width:180px; box-shadow:0 8px 22px rgba(0,0,0,.4); display:flex; flex-direction:column; }
    .menu-item { background:transparent; border:none; color:#e5e7eb; padding:9px 12px; border-radius:6px; text-align:left; font-size:13px; cursor:pointer; text-decoration:none; font-family:inherit; }
    .menu-item:hover { background:#1a2638; }
    .menu-item.danger { color:#fca5a5; }

    .content { flex:1; min-width:0; padding:24px 26px 36px; overflow:auto; }

    /* Stale-data banner — sits at the very top of the main column, above
       the topbar. Two severities; both non-dismissable so operators in the
       field can't just click them away and forget. */
    .stale-banner { display:flex; align-items:center; gap:12px;
                    padding:10px 16px; font-size:13px; line-height:1.45;
                    border-bottom:1px solid; }
    .stale-banner .ic  { font-size:18px; flex-shrink:0; }
    .stale-banner .msg { flex:1; min-width:0; }
    .stale-banner.warn     { background:#7c5302; color:#fde68a; border-bottom-color:#a16207; }
    .stale-banner.warn  strong { color:#fef3c7; }

    /* Phase 8.5 — peer-alert permission denied banner. Sits beneath the
       stale-data banner (if present) and above the topbar. Slate-grey
       so it doesn't compete with the amber stale banner or the red
       urgent overlay — it's important but not urgent. Always has the
       Enable button because the only fix is to grant permissions. */
    .peer-perm-banner {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 18px;
        background: #1e293b; color: #cbd5e1;
        border-bottom: 1px solid #334155;
        font-size: 12px;
    }
    .peer-perm-icon { font-size: 18px; opacity: .9; }
    .peer-perm-body { flex: 1; line-height: 1.45; }
    .peer-perm-body strong { color: #f1f5f9; margin-right: 4px; }
    .peer-perm-btn {
        background: #0e7490; color: #fff; border: none;
        border-radius: 6px; padding: 7px 14px;
        font-size: 12px; font-weight: 700; cursor: pointer;
    }
    .peer-perm-btn:active { transform: translateY(1px); }
    .stale-banner.critical { background:#7f1d1d; color:#fecaca; border-bottom-color:#b91c1c; }
    .stale-banner.critical strong { color:#fff; }

    /* Hamburger + drawer scrim: hidden on desktop, used on mobile only */
    .hamburger    { display:none; background:transparent; border:none; padding:8px;
                    margin-right:6px; cursor:pointer; width:36px; height:36px;
                    flex-direction:column; justify-content:center; gap:4px;
                    align-items:center; }
    .hamburger span { display:block; width:20px; height:2px; background:#cbd5e1;
                      border-radius:2px; transition:transform .2s, opacity .2s; }
    .drawer-scrim { display:none; }
    .topbar-date .short { display:none; }

    /* ── Mobile (phone) ─────────────────────────────────────────────────── */
    @@media (max-width:760px) {
        /* Slide-out drawer pattern: sidebar lives off-screen by default and
           translates in when .drawer-open is set on .app. */
        .sidebar {
            position:fixed; left:0; top:0; bottom:0; z-index:50;
            width:260px; padding:18px 0;
            transform:translateX(-100%);
            transition:transform .22s ease-out;
            box-shadow:0 0 0 transparent;
        }
        .drawer-open .sidebar {
            transform:translateX(0);
            box-shadow:6px 0 24px rgba(0,0,0,.45);
        }
        .drawer-scrim {
            display:block; position:fixed; inset:0; z-index:40;
            background:rgba(2,6,23,.55);
            opacity:0; pointer-events:none;
            transition:opacity .22s ease-out;
        }
        .drawer-open .drawer-scrim {
            opacity:1; pointer-events:auto;
        }

        /* Hamburger replaces the sidebar's always-visible role */
        .hamburger { display:flex; }

        /* Long date wraps; switch to a compact format */
        .topbar-date .full  { display:none; }
        .topbar-date .short { display:inline; }
        .topbar-date  { font-size:12px; color:#cbd5e1; }

        /* Topbar tightening */
        .topbar       { padding:10px 12px; gap:8px; }
        .user-text    { display:none; }      /* keep the avatar dot, drop name+role */
        .pill.subtle  { display:none; }      /* drop the … / 🔔 chips on phones */

        .content      { padding:14px; }
    }
</style>

@code {
    private int   queuedCount = 0;
    private bool  showUserMenu;

    /// <summary>
    /// Whether the mobile slide-out drawer is currently visible. Always
    /// false on desktop — the CSS @@media query makes the sidebar visible
    /// regardless of this flag once the viewport is wide enough.
    /// </summary>
    private bool  drawerOpen;
    // Phase 8.4 — controls the peer-alert permission explainer overlay.
    // True only on first launch when permissions are denied; flips back
    // to false the instant the operator taps Continue (regardless of
    // whether the OS prompt was accepted).
    private bool  showPermissionExplainer;

    // Phase 8.5 — persistent banner shown when permissions were prompted
    // previously and at least one is still denied. Re-evaluated whenever
    // the app comes back to the foreground because the operator may have
    // toggled the grant in OS Settings between launches.
    private bool  peerAlertDenied;

    /// <summary>
    /// Whole days between now and the most recent successful API ping for
    /// the signed-in user. Null when there's no cached record yet (first
    /// launch) so we don't scare brand-new users. The banner thresholds
    /// are 14 (warn, yellow) and 20 (critical, red).
    /// </summary>
    private int?  daysSinceSync;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
    private void CloseDrawer()  => drawerOpen = false;

    private string Initials => string.Concat(
        (Auth.CurrentUser?.FullName ?? "?")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => w[0]));

    private string RoleLabel
        => Auth.CurrentUser?.Roles?.FirstOrDefault() ?? "Operator";

    private bool IsOperator
        => Auth.CurrentUser?.Roles?.Any(r => r == "Operator") ?? false;

    private bool IsSupervisor
        => Auth.CurrentUser?.Roles?.Any(r => r == "Supervisor" || r == "Admin") ?? false;

    private bool IsMechanic
        => Auth.CurrentUser?.Roles?.Any(r => r == "Mechanic" || r == "Admin") ?? false;

    /// <summary>
    /// "Can I actually reach the API right now?" Combines device-network state
    /// with the most recent server ping from <see cref="ApiHealth"/>. Pure
    /// device connectivity isn't enough — Wi-Fi can be on while the server is
    /// unreachable (VPN dropped, captive portal, server down).
    /// </summary>
    private bool IsOnline => Health.IsOnline;

    protected override async Task OnInitializedAsync()
    {
        Queue.Changed       += OnQueueChanged;
        Actions.Changed     += OnQueueChanged;
        Sync.DrainCompleted += OnQueueChanged;
        Health.Changed      += OnHealthChanged;
        Connectivity.ConnectivityChanged += OnConnectivityChanged;
        // Recompute the stale-data banner whenever the user navigates so
        // the message refreshes through the day without depending on a
        // health transition firing.
        Nav.LocationChanged += OnLocationChanged;

        // Subscribe to admin-initiated deactivation. Fires when ApiClient
        // or AuthService detects the server has blocked this user — we
        // pop a red toast and bounce to /login (the JWT and CurrentUser
        // are already cleared at that point).
        Auth.Deactivated    += OnDeactivated;

        // Phase 8.1 — Loud Alert overlay repaint signal. UrgentAlertService
        // fires StateChanged when IsActive flips; we just relay it into
        // the layout's render cycle so the @if (UrgentAlert.IsActive)
        // block above re-evaluates.
        UrgentAlert.StateChanged += OnUrgentAlertChanged;

        // Phase 8.2 — BLE peer-alert receiver. When another Equipment
        // Checklist device within ~30m broadcasts a NO-GO via BLE, fire
        // the same loud-alert overlay on this device — but with a label
        // that says "peer alert from operator X on machine Y" so the
        // recipient knows it's not THEIR machine.
        PeerAlert.PeerAlertReceived += OnPeerAlertReceived;

        // Phase 8.4 — runtime permission orchestration. On Android 12+,
        // check if we've ever prompted for BLE + Notifications. If not
        // AND any permission is denied, show the explainer modal. The
        // modal's Continue button fires the OS prompts. We only start
        // the scanner AFTER permissions are sorted — otherwise the
        // service launch would fail silently on permission deny.
        if (PeerAlertPermissions.IsApplicable && !PeerAlertPermissions.HasPromptedBefore)
        {
            try
            {
                var status = await PeerAlertPermissions.StatusAsync();
                if (status != PeerAlertPermissionStatus.Granted)
                {
                    showPermissionExplainer = true;
                }
                else
                {
                    // Already granted somehow (manual grant in OS settings) —
                    // skip explainer + start listener immediately.
                    try { await PeerAlert.StartListeningAsync(); } catch { }
                }
            }
            catch
            {
                // Permission check threw — start the scanner anyway in
                // degraded mode (foreground only); the operator can grant
                // permissions later via OS settings.
                try { await PeerAlert.StartListeningAsync(); } catch { }
            }
        }
        else
        {
            // No prompt needed (iOS / Windows / pre-Android-12 / already
            // prompted before) — go straight to starting the scanner.
            // Phase 8.3 foreground service handles graceful failure if
            // permissions were denied previously.
            try { await PeerAlert.StartListeningAsync(); } catch { }
        }

        // Phase 8.5 — evaluate the "denied" banner state. Only shown
        // when the user has already been prompted at least once AND a
        // permission is currently denied. Re-checked on every layout
        // init so a grant from OS Settings clears the banner next time
        // the app comes back to the foreground.
        await RefreshPeerAlertPermissionBannerAsync();

        // Phase 8.6 — also re-check on every app resume so the operator
        // returning from OS Settings sees the banner clear without
        // having to navigate. The AppLifecycleService.Resumed event is
        // raised from the platform-specific lifecycle hooks wired in
        // MauiProgram.ConfigureLifecycleEvents.
        Lifecycle.Resumed += OnAppResumed;

        queuedCount = await Queue.CountAsync() + await Actions.CountAsync();
        await RefreshDaysSinceSyncAsync();
    }

    private void OnUrgentAlertChanged() => InvokeAsync(StateHasChanged);

    private void OnPeerAlertReceived(PeerAlertPayload payload) => InvokeAsync(async () =>
    {
        // The popup is the loud-alert overlay — same UX as raising your
        // own NO-GO. The toast above adds the context that it's a peer
        // alert (so the recipient doesn't think THEIR machine is the one).
        Toasts.Error(
            $"🚨 Peer NO-GO: {payload.MachineNumber} (operator: {payload.OperatorName})",
            durationMs: 12000);
        try { await UrgentAlert.TriggerAsync(); } catch { }
    });

    private async Task DismissUrgentAlert()
    {
        await UrgentAlert.StopAsync();
    }

    /// <summary>
    /// Phase 8.4 — operator tapped Continue on the explainer modal.
    /// Hide the modal, fire the OS permission prompts, then start the
    /// scanner regardless of outcome (the foreground service degrades
    /// gracefully if notifications were denied — still works in
    /// foreground, just gets killed by Android battery optimisation
    /// in the background).
    /// </summary>
    private async Task ContinuePermissionPrompt()
    {
        showPermissionExplainer = false;
        StateHasChanged();   // hide the modal immediately so the OS prompt isn't obscured

        try
        {
            var outcome = await PeerAlertPermissions.PromptAsync();
            if (outcome == PeerAlertPermissionStatus.Denied)
            {
                // Soft warning — peer-alert won't work in background but
                // the rest of the app is unaffected. The OS settings
                // page is where they can change their mind.
                Toasts.Warning(
                    "Bluetooth or notifications denied — peer alerts will work only while the app is open. Change in Settings → Apps → Equipment Checklist → Permissions.",
                    durationMs: 9000);
            }
        }
        catch { /* permission API edge case — silent */ }

        try { await PeerAlert.StartListeningAsync(); } catch { }
        await RefreshPeerAlertPermissionBannerAsync();
    }

    /// <summary>
    /// Phase 8.5 — re-check current permission status + flip the
    /// banner field. Called from OnInitializedAsync and after the
    /// post-prompt flow. Could also be wired to an
    /// <c>App.Current.Resumed</c> event in the future so the banner
    /// updates the instant the operator returns from Settings.
    /// </summary>
    /// <summary>Phase 8.6 — fired by the AppLifecycleService when the
    /// app returns to the foreground. Re-evaluates the permission banner
    /// so a grant from OS Settings clears immediately + restarts the
    /// scanner if it stopped while backgrounded.</summary>
    private void OnAppResumed() => InvokeAsync(async () =>
    {
        await RefreshPeerAlertPermissionBannerAsync();
        // Restart the listener too in case Android killed the scanner
        // while we were away. Idempotent — the publisher handles
        // double-starts gracefully.
        try { await PeerAlert.StartListeningAsync(); } catch { }
    });

    private async Task RefreshPeerAlertPermissionBannerAsync()
    {
        if (!PeerAlertPermissions.IsApplicable || !PeerAlertPermissions.HasPromptedBefore)
        {
            peerAlertDenied = false;
            return;
        }
        try
        {
            var status = await PeerAlertPermissions.StatusAsync();
            peerAlertDenied = status == PeerAlertPermissionStatus.Denied;
        }
        catch
        {
            peerAlertDenied = false;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Phase 8.5 — banner "Enable" button. Opens the OS app-details
    /// Settings page via the platform-specific deep-link. On Android
    /// the operator lands directly on the Equipment Checklist
    /// permission panel; on other platforms we fall back to the
    /// generic AppInfo.ShowSettingsUI.
    /// </summary>
    private async Task OpenPeerAlertSettings()
    {
        try
        {
            var opened = await PeerAlertPermissions.OpenAppSettingsAsync();
            if (!opened)
            {
                try { AppInfo.Current.ShowSettingsUI(); }
                catch
                {
                    Toasts.Warning(
                        "Could not open Settings automatically. Open it manually: Settings → Apps → Equipment Checklist → Permissions.",
                        durationMs: 9000);
                }
            }
        }
        catch { /* defensive — banner stays so the user can retry */ }
    }

    private void OnDeactivated() => InvokeAsync(() =>
    {
        Toasts.Error(
            "Your account has been deactivated by an administrator. " +
            "Contact them to be re-enabled.",
            durationMs: 8000);
        // SignOutAsync has already run inside HandleRemoteDeactivationAsync;
        // just navigate. `replace: true` so back-button doesn't return them
        // to a half-broken page that thinks they're signed in.
        Nav.NavigateTo("/login", replace: true);
    });

    private void OnHealthChanged()
    {
        // Successful ping bumped LastSyncedAt in SQLite; re-read so the
        // banner can drop off without waiting for navigation.
        InvokeAsync(async () =>
        {
            await RefreshDaysSinceSyncAsync();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(async () =>
        {
            await RefreshDaysSinceSyncAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Read the cached user's LastSyncedAt and compute whole-day age.
    /// Null user / null timestamp leaves <see cref="daysSinceSync"/> null
    /// so the banner stays hidden — we don't nag people who've never been
    /// online (probably first launch on a brand-new device).
    /// </summary>
    private async Task RefreshDaysSinceSyncAsync()
    {
        try
        {
            var email = Auth.CurrentUser?.Email;
            if (string.IsNullOrEmpty(email)) { daysSinceSync = null; return; }

            var last = await Cache.GetLastSyncedAtAsync(email);
            if (last is null) { daysSinceSync = null; return; }

            var days = (int)Math.Floor((DateTime.UtcNow - last.Value).TotalDays);
            daysSinceSync = days < 0 ? 0 : days;
        }
        catch
        {
            // Cache read failure shouldn't break the layout. Banner stays off.
            daysSinceSync = null;
        }
    }

    private void OnQueueChanged()
    {
        InvokeAsync(async () =>
        {
            queuedCount = await Queue.CountAsync() + await Actions.CountAsync();
            StateHasChanged();
        });
    }

    private void OnConnectivityChanged(object? sender, ConnectivityChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void ToggleUserMenu() => showUserMenu = !showUserMenu;

    private void ManualDrain() => _ = Task.Run(Sync.DrainAsync);

    private async Task SignOut()
    {
        showUserMenu = false;
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Queue.Changed       -= OnQueueChanged;
        Actions.Changed     -= OnQueueChanged;
        Sync.DrainCompleted -= OnQueueChanged;
        Health.Changed      -= OnHealthChanged;
        Auth.Deactivated    -= OnDeactivated;
        Nav.LocationChanged -= OnLocationChanged;
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        UrgentAlert.StateChanged -= OnUrgentAlertChanged;
        PeerAlert.PeerAlertReceived -= OnPeerAlertReceived;
        Lifecycle.Resumed -= OnAppResumed;
        // Don't await StopListeningAsync inside Dispose — fire-and-forget
        // because Dispose is synchronous and the BLE scanner stop is
        // idempotent on the next startup.
        _ = PeerAlert.StopListeningAsync();
    }
}
