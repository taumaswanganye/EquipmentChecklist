<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      android:allowBackup="true"
          → Enables Android Auto Backup. Every 24h (idle + charging + Wi-Fi)
            the OS snapshots app private data to the user's Google Drive,
            capped at 25 MB total. On uninstall + reinstall the OS restores
            it BEFORE the app first launches, so the operator's cache, queue,
            and offline-signin user row come back automatically.

      NOTE: fullBackupContent / dataExtractionRules / requestLegacyExternalStorage
      attributes and the WRITE_EXTERNAL_STORAGE / READ_EXTERNAL_STORAGE permissions
      were temporarily removed because they caused the app to fail to launch on
      this build. To re-introduce the cache mirror feature, first verify the XML
      rule resources in Platforms/Android/Resources/xml/ are being packaged
      (look in obj/Debug/net9.0-android/lp/ — each xml/*.xml should appear).
    -->
    <application android:allowBackup="true"
                 android:icon="@mipmap/appicon"
                 android:roundIcon="@mipmap/appicon_round"
                 android:supportsRtl="true"></application>
    <!--
      Phase 8.3 — The foreground service that keeps the BLE peer-alert
      scanner alive in the background is registered via the [Service]
      attribute on PeerAlertForegroundService.cs (foregroundServiceType =
      "connectedDevice" set there). The attribute generator emits the
      correct <service> element automatically so the type name and
      manifest stay in sync if the class is renamed.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Phase 8.2 + 8.3 — Bluetooth LE peer-alert broadcast + scan.
      Android 12+ split the older BLUETOOTH permission into role-specific
      permissions (ADVERTISE, SCAN, CONNECT) all granted at runtime.
      ACCESS_FINE_LOCATION is required ONLY on Android 6-11 to receive
      BLE scan results — kept here for back-compat though SDK 33+
      targets ignore it.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
                     android:maxSdkVersion="30" />

    <!--
      Phase 8.3 — Foreground service permissions.
      FOREGROUND_SERVICE has been required since Android 9 for any service
      that calls startForeground(); FOREGROUND_SERVICE_CONNECTED_DEVICE
      is the Android 14 (API 34) specific type that matches our
      service's foregroundServiceType attribute. POST_NOTIFICATIONS
      lets us display the persistent "scanning for alerts" notification
      that keeps the service alive.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Defect photo capture (MediaPicker.CapturePhotoAsync).
      <uses-feature android:required="false"> means the app still installs on
      tablets without a rear camera; the photo button just becomes a no-op.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature  android:name="android.hardware.camera" android:required="false" />

    <!--
      Defect voice-memo capture (Plugin.Maui.Audio AudioRecorder).
      Android shows a runtime permission prompt on first use; the operator
      can deny it and just type the defect note instead.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature  android:name="android.hardware.microphone" android:required="false" />

    <!--
      Biometric unlock for sign-in (AndroidX BiometricPrompt).
      USE_BIOMETRIC is the modern (API 28+) permission. We don't add the
      older USE_FINGERPRINT (API 23–28) because we pin SupportedOSPlatformVersion
      to Android 23 — devices below that don't even run the app.
      <uses-feature> is required=false so the app installs on tablets
      without a fingerprint reader; the login screen just stays on
      password-only there.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature  android:name="android.hardware.fingerprint" android:required="false" />
</manifest>