{
    "name": "Enaleni Mine Operations",
    "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/master/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.137.json",
    "background": "#0B1726",
    "foreground": "#E5E7EB",
    "foregroundNeutralSecondary": "#94A3B8",
    "foregroundNeutralTertiary": "#64748B",
    "tableAccent": "#0E9488",
    "dataColors": [
        "#0E9488",
        "#06B6D4",
        "#F59E0B",
        "#EF4444",
        "#22C55E",
        "#F97316",
        "#A78BFA",
        "#FBBF24",
        "#3B82F6",
        "#10B981"
    ],
    "good":    "#22C55E",
    "neutral": "#06B6D4",
    "bad":     "#EF4444",
    "minimum": "#1F2A3A",
    "center":  "#06B6D4",
    "maximum": "#0E9488",
    "null":    "#64748B",
    "textClasses": {
        "title": {
            "fontSize": 18,
            "fontFace": "'Segoe UI Semibold'",
            "color":    "#E5E7EB"
        },
        "header": {
            "fontSize": 12,
            "fontFace": "'Segoe UI Semibold'",
            "color":    "#94A3B8"
        },
        "label": {
            "fontSize": 11,
            "fontFace": "'Segoe UI'",
            "color":    "#CBD5E1"
        },
        "callout": {
            "fontSize": 36,
            "fontFace": "'Segoe UI Bold'",
            "color":    "#0E9488"
        }
    },
    "visualStyles": {
        "*": {
            "*": {
                "background": [{
                    "color": {"solid": {"color": "#111C2E"}},
                    "transparency": 0
                }],
                "border": [{
                    "show": true,
                    "color": {"solid": {"color": "#1F2A3A"}},
                    "radius": 10
                }],
                "title": [{
                    "fontColor": {"solid": {"color": "#E5E7EB"}},
                    "background": {"solid": {"color": "#111C2E"}}
                }]
            }
        },
        "card": {
            "*": {
                "categoryLabels": [{
                    "show": true,
                    "color": {"solid": {"color": "#94A3B8"}}
                }],
                "dataLabels": [{
                    "color": {"solid": {"color": "#0E9488"}},
                    "fontSize": 32,
                    "fontFamily": "'Segoe UI Bold'"
                }]
            }
        },
        "tableEx": {
            "*": {
                "grid": [{
                    "gridVertical":   true,
                    "gridHorizontal": true,
                    "gridVerticalColor":   {"solid": {"color": "#1F2A3A"}},
                    "gridHorizontalColor": {"solid": {"color": "#1F2A3A"}}
                }],
                "columnHeaders": [{
                    "fontColor": {"solid": {"color": "#94A3B8"}},
                    "backColor": {"solid": {"color": "#0D1729"}},
                    "fontSize": 10
                }],
                "values": [{
                    "fontColor": {"solid": {"color": "#E5E7EB"}},
                    "backColor": {"solid": {"color": "#111C2E"}},
                    "alternateBackColor": {"solid": {"color": "#0D1729"}}
                }]
            }
        },
        "slicer": {
            "*": {
                "items": [{
                    "fontColor":  {"solid": {"color": "#CBD5E1"}},
                    "background": {"solid": {"color": "#111C2E"}}
                }]
            }
        }
    }
}
